@page "/attendance"
@attribute [Authorize]
@using Microsoft.EntityFrameworkCore
@inject AttendanceService AttendanceSvc
@inject ShiftService ShiftSvc
@inject UkuuHrDbContext Db
@inject ISnackbar Snackbar
@inject HttpClient Http
@inject NavigationManager Nav

<div class="bk-admin-fade-in">
    <div class="bk-admin-section-header">
        <div class="bk-admin-section-header-left">
            <div class="bk-admin-greeting">Time & Attendance · @_selectedDate.ToString("dd MMMM yyyy")</div>
            <h1 class="bk-admin-h1">Time & Attendance</h1>
            <p class="bk-admin-sub">
                Track daily attendance, clock-in/out, and review timesheets for @_selectedDate.ToString("dd MMMM yyyy").
                Status is computed by the ShiftEngine against each employee's assigned shift and the org's tolerance policy.
            </p>
        </div>
        <div class="bk-admin-actions">
            <input type="date" @bind="_selectedDate" style="height:40px;border:1px solid var(--bk-line);border-radius:999px;background:rgba(255,255,255,0.74);padding:0 16px;font-family:inherit;font-size:13px;color:var(--bk-ink);outline:none;" />
            <button class="bk-btn bk-btn-secondary" @onclick="RecomputeStatuses">
                <span class="material-icons-round" style="font-size:16px;">refresh</span>
                Recompute Status
            </button>
            <button class="bk-btn bk-btn-secondary" @onclick="OpenImportInfoModal">
                <span class="material-icons-round" style="font-size:16px;">download</span>
                Import From Device
            </button>
            <a href="/clock" class="bk-btn bk-btn-primary">
                <span class="material-icons-round" style="font-size:16px;">fingerprint</span>
                Clock In/Out
            </a>
        </div>
    </div>

    <!-- Stats -->
    <div class="bk-admin-kpi-grid" style="grid-template-columns:repeat(auto-fit,minmax(180px,1fr));">
        <div class="bk-admin-kpi-card" style="padding:16px 20px;">
            <div class="bk-admin-kpi-icon green" style="width:36px;height:36px;"><span class="material-icons-round" style="font-size:18px;">check_circle</span></div>
            <div class="bk-admin-kpi-value" style="font-size:24px;margin-top:8px;">@_present</div>
            <div class="bk-admin-kpi-label">Present</div>
        </div>
        <div class="bk-admin-kpi-card" style="padding:16px 20px;">
            <div class="bk-admin-kpi-icon gold" style="width:36px;height:36px;"><span class="material-icons-round" style="font-size:18px;">schedule</span></div>
            <div class="bk-admin-kpi-value" style="font-size:24px;margin-top:8px;">@_late</div>
            <div class="bk-admin-kpi-label">Late Arrivals</div>
        </div>
        <div class="bk-admin-kpi-card" style="padding:16px 20px;">
            <div class="bk-admin-kpi-icon purple" style="width:36px;height:36px;"><span class="material-icons-round" style="font-size:18px;">event_available</span></div>
            <div class="bk-admin-kpi-value" style="font-size:24px;margin-top:8px;">@_onLeave</div>
            <div class="bk-admin-kpi-label">On Leave</div>
        </div>
        <div class="bk-admin-kpi-card" style="padding:16px 20px;">
            <div class="bk-admin-kpi-icon pink" style="width:36px;height:36px;"><span class="material-icons-round" style="font-size:18px;">cancel</span></div>
            <div class="bk-admin-kpi-value" style="font-size:24px;margin-top:8px;">@_absent</div>
            <div class="bk-admin-kpi-label">Absent</div>
        </div>
        <div class="bk-admin-kpi-card" style="padding:16px 20px;">
            <div class="bk-admin-kpi-icon blue" style="width:36px;height:36px;"><span class="material-icons-round" style="font-size:18px;">home_work</span></div>
            <div class="bk-admin-kpi-value" style="font-size:24px;margin-top:8px;">@_remote</div>
            <div class="bk-admin-kpi-label">Remote</div>
        </div>
        <div class="bk-admin-kpi-card" style="padding:16px 20px;">
            <div class="bk-admin-kpi-icon" style="width:36px;height:36px;background:rgba(110,95,146,0.12);"><span class="material-icons-round" style="font-size:18px;">timer</span></div>
            <div class="bk-admin-kpi-value" style="font-size:24px;margin-top:8px;">@(_records.Sum(r => r.WorkedHours).ToString("0.0"))h</div>
            <div class="bk-admin-kpi-label">Total Hours</div>
        </div>
    </div>

    <!-- Filter chips -->
    <div style="display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap;">
        @foreach (var f in new[] { ("all", "All"), ("present", "Present"), ("late", "Late"), ("absent", "Absent"), ("onleave", "On Leave"), ("remote", "Remote") })
        {
            <button @onclick="() => _filter = f.Item1" style="padding:8px 14px;border-radius:999px;border:1px solid @(f.Item1 == _filter ? "var(--bk-ink)" : "var(--bk-line)");background:@(f.Item1 == _filter ? "var(--bk-ink)" : "var(--bk-bg-strong)");color:@(f.Item1 == _filter ? "white" : "var(--bk-ink-2)");font-weight:600;font-size:12px;cursor:pointer;text-transform:capitalize;font-family:inherit;">
                @f.Item2
            </button>
        }
    </div>

    <!-- Attendance table -->
    <div class="bk-admin-card" style="overflow:hidden;">
        <table class="bk-admin-table bk-mobile-card-view">
            <thead>
                <tr>
                    <th>Employee</th>
                    <th>Department</th>
                    <th>Assigned Shift</th>
                    <th>Check In</th>
                    <th>Check Out</th>
                    <th>Hours</th>
                    <th>Late / Early</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _filtered)
                {
                    <tr>
                        <td>
                            <div style="display:flex;align-items:center;gap:10px;">
                                <div class="bk-admin-avatar gold" style="width:32px;height:32px;font-size:12px;">@GetInitials(row.Attendance.EmployeeName)</div>
                                <div style="font-weight:600;font-size:13px;">@row.Attendance.EmployeeName</div>
                            </div>
                        </td>
                        <td>@GetDept(row.Attendance.EmployeeId)</td>
                        <td>
                            @if (row.Resolution.Shift != null)
                            {
                                <div style="display:flex;align-items:center;gap:8px;">
                                    <div style="width:5px;height:20px;border-radius:2px;background:@(row.Resolution.Shift.Color);"></div>
                                    <div>
                                        <div style="font-size:12px;font-weight:600;color:var(--bk-ink);">@row.Resolution.Shift.Name</div>
                                        <div style="font-size:10px;color:var(--bk-ink-3);font-family:var(--ukuu-font-mono);">@row.Resolution.Shift.TimeWindow</div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <span style="font-size:11px;color:var(--bk-ink-3);">@row.Resolution.Reason</span>
                            }
                        </td>
                        <td>@row.Attendance.CheckInLabel</td>
                        <td>@row.Attendance.CheckOutLabel</td>
                        <td style="font-weight:600;">@(row.Attendance.WorkedHours > 0 ? row.Attendance.WorkedHours.ToString("0.0") + "h" : "—")</td>
                        <td>
                            @if (row.Computation.LateMinutes > 0)
                            {
                                <span style="font-size:11px;color:var(--bk-warning);font-weight:600;">+@row.Computation.LateMinutes min late</span>
                            }
                            else if (row.Computation.EarlyMinutes > 0)
                            {
                                <span style="font-size:11px;color:var(--bk-error);font-weight:600;">-@row.Computation.EarlyMinutes min early</span>
                            }
                            else if (row.Attendance.CheckIn.HasValue)
                            {
                                <span style="font-size:11px;color:var(--bk-success);font-weight:600;">On time</span>
                            }
                            else
                            {
                                <span style="font-size:11px;color:var(--bk-ink-3);">—</span>
                            }
                        </td>
                        <td>
                            <span class="bk-admin-pill @(row.Attendance.Status == AttendanceStatus.Present ? "active" : row.Attendance.Status == AttendanceStatus.Late ? "probation" : row.Attendance.Status == AttendanceStatus.Absent ? "inactive" : row.Attendance.Status == AttendanceStatus.HalfDay ? "pending" : "info")">
                                @row.Attendance.Status
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!_filtered.Any())
        {
            <div style="padding:48px 24px;text-align:center;color:var(--bk-ink-3);">
                <div style="width:64px;height:64px;margin:0 auto 16px;background:var(--bk-muted);border-radius:50%;display:flex;align-items:center;justify-content:center;">
                    <span class="material-icons-round" style="font-size:32px;color:var(--bk-ink-3);">event_busy</span>
                </div>
                <p style="font-size:13px;">No attendance records for this date.</p>
            </div>
        }
    </div>

    @if (_tolerance != null)
    {
        <div class="bk-admin-card" style="margin-top:24px;">
            <div class="bk-admin-card-header">
                <h3>Active Tolerance Policy</h3>
                <p>The ShiftEngine applies these thresholds when computing each attendance status.</p>
            </div>
            <div class="bk-admin-card-content" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;">
                <div class="bk-admin-stat-box">
                    <div class="bk-admin-stat-box-label">Late tolerance</div>
                    <div class="bk-admin-stat-box-value" style="color:var(--bk-warning);">@_tolerance.LateCheckInToleranceMinutes min</div>
                </div>
                <div class="bk-admin-stat-box">
                    <div class="bk-admin-stat-box-label">Very-late threshold</div>
                    <div class="bk-admin-stat-box-value" style="color:var(--bk-error);">@_tolerance.VeryLateThresholdMinutes min</div>
                </div>
                <div class="bk-admin-stat-box">
                    <div class="bk-admin-stat-box-label">Early check-out</div>
                    <div class="bk-admin-stat-box-value" style="color:var(--bk-warning);">@_tolerance.EarlyCheckOutToleranceMinutes min</div>
                </div>
                <div class="bk-admin-stat-box">
                    <div class="bk-admin-stat-box-label">Absent threshold</div>
                    <div class="bk-admin-stat-box-value" style="color:var(--bk-error);">@_tolerance.MinPresentMinutesForAttendance min</div>
                </div>
                <div class="bk-admin-stat-box">
                    <div class="bk-admin-stat-box-label">Grace period</div>
                    <div class="bk-admin-stat-box-value" style="color:var(--bk-info);">@_tolerance.GracePeriodMinutes min</div>
                </div>
                <div class="bk-admin-stat-box">
                    <div class="bk-admin-stat-box-label">Default break</div>
                    <div class="bk-admin-stat-box-value" style="color:var(--bk-accent-2);">@_tolerance.DefaultBreakMinutes min</div>
                </div>
            </div>
        </div>
    }

    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <!-- Import From Device — Stage 1: Info popup (requirements)                  -->
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    @if (_showImportInfo)
    {
        <div style="position:fixed;inset:0;background:rgba(16,8,30,0.55);backdrop-filter:blur(4px);z-index:9998;display:flex;align-items:center;justify-content:center;padding:24px;" @onclick="CloseImportInfoModal">
            <div style="background:var(--bk-surface,#fff);border-radius:16px;max-width:560px;width:100%;max-height:90vh;overflow-y:auto;box-shadow:0 24px 60px rgba(0,0,0,0.3);" @onclick:stopPropagation="true">
                <div style="padding:24px 28px;border-bottom:1px solid var(--bk-line);display:flex;justify-content:space-between;align-items:flex-start;gap:16px;">
                    <div>
                        <h3 style="margin:0 0 4px 0;font-size:18px;font-weight:700;color:var(--bk-ink);">Import Attendance From Hikvision Device</h3>
                        <p style="margin:0;font-size:13px;color:var(--bk-ink-3);">Before you begin — please review the requirements below.</p>
                    </div>
                    <button @onclick="CloseImportInfoModal" style="background:none;border:none;cursor:pointer;color:var(--bk-ink-3);padding:4px;border-radius:6px;">
                        <span class="material-icons-round">close</span>
                    </button>
                </div>
                <div style="padding:24px 28px;">
                    <div style="background:rgba(212,175,55,0.08);border:1px solid rgba(212,175,55,0.3);border-radius:10px;padding:16px;margin-bottom:16px;">
                        <div style="display:flex;align-items:flex-start;gap:10px;">
                            <span class="material-icons-round" style="color:#d89c11;font-size:20px;margin-top:1px;">info</span>
                            <div style="font-size:13px;color:var(--bk-ink);line-height:1.5;">
                                <strong>How it works:</strong> This tool connects directly to your Hikvision biometric terminal via the ISAPI protocol, downloads attendance events (clock-in/out punches) for the date range you specify, and imports them into Ukuu HR — matching each punch to an employee by their Employee Code.
                            </div>
                        </div>
                    </div>

                    <h4 style="font-size:13px;font-weight:700;color:var(--bk-ink);margin:0 0 10px 0;text-transform:uppercase;letter-spacing:0.04em;">Requirements</h4>
                    <ul style="margin:0 0 16px 0;padding-left:20px;font-size:13px;color:var(--bk-ink-2);line-height:1.7;">
                        <li><strong style="color:var(--bk-ink);">Same network:</strong> Your computer and the Hikvision device must be on the same local network (LAN/WiFi) or VPN. The device's IP (e.g. <code style="background:var(--bk-muted);padding:1px 5px;border-radius:3px;font-size:12px;">192.168.x.x</code>) must be reachable from this browser.</li>
                        <li><strong style="color:var(--bk-ink);">Device IP & port:</strong> Find these in the device's web UI or your router's DHCP table. Default ports: <code style="background:var(--bk-muted);padding:1px 5px;border-radius:3px;font-size:12px;">80</code> (HTTP) or <code style="background:var(--bk-muted);padding:1px 5px;border-radius:3px;font-size:12px;">443</code> (HTTPS).</li>
                        <li><strong style="color:var(--bk-ink);">Valid credentials:</strong> The admin username and password for the device. Default is <code style="background:var(--bk-muted);padding:1px 5px;border-radius:3px;font-size:12px;">admin / admin</code> but newer firmware forces a strong password on first login.</li>
                        <li><strong style="color:var(--bk-ink);">ISAPI enabled:</strong> Most Hikvision devices have ISAPI on by default. If not, enable it in the device's web UI under <em>Configuration → Network → Advanced → Platform Access → ISAPI</em>.</li>
                        <li><strong style="color:var(--bk-ink);">Employee codes match:</strong> Each employee's <em>Employee Code</em> in Ukuu HR must match the <em>employeeNo</em> enrolled on the device. Unmatched punches are skipped (and reported in the summary).</li>
                        <li><strong style="color:var(--bk-ink);">Self-signed certs OK:</strong> HTTPS devices use self-signed certificates — that's fine, the import will still work.</li>
                    </ul>

                    <div style="background:rgba(110,95,146,0.06);border:1px solid rgba(110,95,146,0.2);border-radius:10px;padding:14px;margin-bottom:20px;">
                        <div style="display:flex;align-items:flex-start;gap:10px;">
                            <span class="material-icons-round" style="color:var(--bk-accent);font-size:20px;margin-top:1px;">lightbulb</span>
                            <div style="font-size:12px;color:var(--bk-ink-2);line-height:1.5;">
                                <strong style="color:var(--bk-ink);">Tip:</strong> Not sure of the IP? Log into your router and look for "Hikvision" in the DHCP client list, or use the Hikvision SADP tool. You can also browse to the device's web UI first to confirm the credentials work.
                            </div>
                        </div>
                    </div>

                    <div style="display:flex;gap:10px;justify-content:flex-end;">
                        <button class="bk-btn bk-btn-secondary" @onclick="CloseImportInfoModal">Cancel</button>
                        <button class="bk-btn bk-btn-primary" @onclick="ProceedToImportForm">
                            <span class="material-icons-round" style="font-size:16px;">arrow_forward</span>
                            Continue
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <!-- Import From Device — Stage 2: Credentials form                           -->
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    @if (_showImportForm)
    {
        <div style="position:fixed;inset:0;background:rgba(16,8,30,0.55);backdrop-filter:blur(4px);z-index:9998;display:flex;align-items:center;justify-content:center;padding:24px;" @onclick="CloseImportFormModal">
            <div style="background:var(--bk-surface,#fff);border-radius:16px;max-width:540px;width:100%;max-height:90vh;overflow-y:auto;box-shadow:0 24px 60px rgba(0,0,0,0.3);" @onclick:stopPropagation="true">
                <div style="padding:24px 28px;border-bottom:1px solid var(--bk-line);display:flex;justify-content:space-between;align-items:flex-start;gap:16px;">
                    <div>
                        <h3 style="margin:0 0 4px 0;font-size:18px;font-weight:700;color:var(--bk-ink);">Connect to Hikvision Device</h3>
                        <p style="margin:0;font-size:13px;color:var(--bk-ink-3);">Enter the device's network address and credentials to fetch attendance events.</p>
                    </div>
                    <button @onclick="CloseImportFormModal" style="background:none;border:none;cursor:pointer;color:var(--bk-ink-3);padding:4px;border-radius:6px;">
                        <span class="material-icons-round">close</span>
                    </button>
                </div>
                <div style="padding:24px 28px;">
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;">
                        <div>
                            <label style="display:block;font-size:12px;font-weight:600;color:var(--bk-ink-2);margin-bottom:6px;">IP Address or Hostname *</label>
                            <input type="text" @bind="_importIpAddress" placeholder="192.168.1.137" style="width:100%;height:40px;border:1px solid var(--bk-line);border-radius:8px;padding:0 12px;font-family:inherit;font-size:13px;color:var(--bk-ink);outline:none;box-sizing:border-box;" />
                        </div>
                        <div>
                            <label style="display:block;font-size:12px;font-weight:600;color:var(--bk-ink-2);margin-bottom:6px;">Port</label>
                            <input type="number" @bind="_importPort" placeholder="443 (HTTPS) or 80 (HTTP)" style="width:100%;height:40px;border:1px solid var(--bk-line);border-radius:8px;padding:0 12px;font-family:inherit;font-size:13px;color:var(--bk-ink);outline:none;box-sizing:border-box;" />
                        </div>
                    </div>
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;">
                        <div>
                            <label style="display:block;font-size:12px;font-weight:600;color:var(--bk-ink-2);margin-bottom:6px;">Username *</label>
                            <input type="text" @bind="_importUsername" placeholder="admin" style="width:100%;height:40px;border:1px solid var(--bk-line);border-radius:8px;padding:0 12px;font-family:inherit;font-size:13px;color:var(--bk-ink);outline:none;box-sizing:border-box;" />
                        </div>
                        <div>
                            <label style="display:block;font-size:12px;font-weight:600;color:var(--bk-ink-2);margin-bottom:6px;">Password *</label>
                            <input type="password" @bind="_importPassword" placeholder="••••••••" style="width:100%;height:40px;border:1px solid var(--bk-line);border-radius:8px;padding:0 12px;font-family:inherit;font-size:13px;color:var(--bk-ink);outline:none;box-sizing:border-box;" />
                        </div>
                    </div>
                    <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px;padding:10px 12px;background:var(--bk-muted);border-radius:8px;">
                        <input id="useHttps" type="checkbox" @bind="_importUseHttps" style="width:16px;height:16px;cursor:pointer;" />
                        <label for="useHttps" style="font-size:13px;color:var(--bk-ink-2);cursor:pointer;user-select:none;">Use HTTPS (recommended — most Hikvision devices use HTTPS with self-signed certs)</label>
                    </div>
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;">
                        <div>
                            <label style="display:block;font-size:12px;font-weight:600;color:var(--bk-ink-2);margin-bottom:6px;">From Date</label>
                            <input type="date" @bind="_importFromDate" style="width:100%;height:40px;border:1px solid var(--bk-line);border-radius:8px;padding:0 12px;font-family:inherit;font-size:13px;color:var(--bk-ink);outline:none;box-sizing:border-box;" />
                        </div>
                        <div>
                            <label style="display:block;font-size:12px;font-weight:600;color:var(--bk-ink-2);margin-bottom:6px;">To Date</label>
                            <input type="date" @bind="_importToDate" style="width:100%;height:40px;border:1px solid var(--bk-line);border-radius:8px;padding:0 12px;font-family:inherit;font-size:13px;color:var(--bk-ink);outline:none;box-sizing:border-box;" />
                        </div>
                    </div>
                    <div style="margin-bottom:20px;">
                        <label style="display:block;font-size:12px;font-weight:600;color:var(--bk-ink-2);margin-bottom:6px;">Max Records (1–5000, default 1000)</label>
                        <input type="number" @bind="_importMaxResults" min="1" max="5000" style="width:100%;height:40px;border:1px solid var(--bk-line);border-radius:8px;padding:0 12px;font-family:inherit;font-size:13px;color:var(--bk-ink);outline:none;box-sizing:border-box;" />
                    </div>

                    @if (_importLoading)
                    {
                        <div style="background:rgba(37,99,235,0.06);border:1px solid rgba(37,99,235,0.2);border-radius:10px;padding:14px;margin-bottom:16px;display:flex;align-items:center;gap:12px;">
                            <div style="width:20px;height:20px;border:2px solid rgba(37,99,235,0.2);border-top-color:var(--bk-info);border-radius:50%;animation:bk-spin 0.8s linear infinite;"></div>
                            <div style="font-size:13px;color:var(--bk-ink);font-weight:600;">@_importProgressMessage</div>
                        </div>
                        <style>@@keyframes bk-spin { to { transform: rotate(360deg); } }</style>
                    }

                    @if (!string.IsNullOrEmpty(_importErrorMessage))
                    {
                        <div style="background:rgba(244,63,94,0.08);border:1px solid rgba(244,63,94,0.3);border-radius:10px;padding:14px;margin-bottom:16px;display:flex;align-items:flex-start;gap:10px;">
                            <span class="material-icons-round" style="color:var(--bk-error);font-size:20px;margin-top:1px;">error_outline</span>
                            <div style="font-size:13px;color:var(--bk-ink);line-height:1.5;flex:1;">@_importErrorMessage</div>
                        </div>
                    }

                    @if (_importResult != null)
                    {
                        <div style="background:rgba(20,163,127,0.08);border:1px solid rgba(20,163,127,0.3);border-radius:10px;padding:16px;margin-bottom:16px;">
                            <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;">
                                <span class="material-icons-round" style="color:var(--bk-success);font-size:20px;">check_circle</span>
                                <strong style="font-size:14px;color:var(--bk-ink);">Import Complete</strong>
                            </div>
                            <div style="font-size:13px;color:var(--bk-ink-2);line-height:1.7;">
                                <div><strong>Device:</strong> @_importResult.Device.Name (@_importResult.Device.Model)</div>
                                <div><strong>Events fetched:</strong> @_importResult.EventsFetched</div>
                                <div><strong>Employees matched:</strong> @_importResult.EmployeesMatched</div>
                                @if (_importResult.EmployeesUnmatched > 0)
                                {
                                    <div><strong>Unmatched punches skipped:</strong> @_importResult.EmployeesUnmatched
                                        @if (_importResult.UnmatchedSampleCodes.Any())
                                        {
                                            <span style="color:var(--bk-ink-3);">(codes: @string.Join(", ", _importResult.UnmatchedSampleCodes)…)</span>
                                        }
                                    </div>
                                }
                                <div><strong>Records imported/updated:</strong> @_importResult.RecordsImported</div>
                                @if (_importResult.DuplicatesSkipped > 0)
                                {
                                    <div><strong>Duplicates skipped:</strong> @_importResult.DuplicatesSkipped</div>
                                }
                                @if (_importResult.Errors.Any())
                                {
                                    <div style="color:var(--bk-error);margin-top:6px;"><strong>Errors:</strong> @string.Join("; ", _importResult.Errors.Take(3))</div>
                                }
                            </div>
                        </div>
                    }

                    <div style="display:flex;gap:10px;justify-content:flex-end;">
                        <button class="bk-btn bk-btn-secondary" @onclick="CloseImportFormModal" disabled="@_importLoading">Close</button>
                        <button class="bk-btn bk-btn-primary" @onclick="ExecuteImport" disabled="@_importLoading">
                            @if (_importLoading)
                            {
                                <span class="material-icons-round" style="font-size:16px;animation:bk-spin 0.8s linear infinite;">sync</span>
                                <span>Importing…</span>
                            }
                            else
                            {
                                <span class="material-icons-round" style="font-size:16px;">download_for_offline</span>
                                <span>Fetch & Import</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

</div>

}

@code {
    private DateTime _selectedDate = DateTime.Today;
    private string _filter = "all";
    private List<Attendance> _records = new();
    private List<Employee> _employees = new();
    private AttendanceTolerance? _tolerance;
    private int _present, _late, _absent, _onLeave, _remote;
    private int _orgId;

    /// <summary>Per-row payload: attendance record + engine resolution + computation.</summary>
    private sealed record AttendanceRow(Attendance Attendance, ShiftResolution Resolution, AttendanceComputation Computation);

    private List<AttendanceRow> _rows = new();

    private IEnumerable<AttendanceRow> _filtered => _filter switch
    {
        "present" => _rows.Where(r => r.Attendance.Status == AttendanceStatus.Present),
        "late" => _rows.Where(r => r.Attendance.Status == AttendanceStatus.Late),
        "absent" => _rows.Where(r => r.Attendance.Status == AttendanceStatus.Absent),
        "onleave" => _rows.Where(r => r.Attendance.Status == AttendanceStatus.OnLeave),
        "remote" => _rows.Where(r => r.Attendance.Status == AttendanceStatus.Remote),
        _ => _rows
    };

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var org = await Db.Organizations.FirstOrDefaultAsync();
        if (org == null) return;
        _orgId = org.Id;
        _records = await AttendanceSvc.ForDateAsync(_orgId, _selectedDate);
        _employees = await Db.Employees.Where(e => e.OrganizationId == _orgId).ToListAsync();
        _tolerance = await ShiftSvc.GetOrCreateToleranceAsync(_orgId);

        // For each record, resolve the shift + compute the status via ShiftEngine.
        _rows.Clear();
        foreach (var a in _records)
        {
            var resolution = await ShiftSvc.ResolveForEmployeeAsync(_orgId, a.EmployeeId, _selectedDate);
            var computation = _tolerance != null
                ? ShiftEngine.ComputeStatus(resolution, _tolerance, a.CheckIn, a.CheckOut, _selectedDate)
                : new AttendanceComputation(a.Status, a.WorkedHours, 0, 0, a.BreakMinutes, null);
            _rows.Add(new AttendanceRow(a, resolution, computation));
        }

        _present = _records.Count(r => r.Status == AttendanceStatus.Present);
        _late = _records.Count(r => r.Status == AttendanceStatus.Late);
        _absent = _records.Count(r => r.Status == AttendanceStatus.Absent);
        _onLeave = _records.Count(r => r.Status == AttendanceStatus.OnLeave);
        _remote = _records.Count(r => r.Status == AttendanceStatus.Remote);
    }

    private async Task RecomputeStatuses()
    {
        try
        {
            if (_tolerance == null) { Snackbar.Add("No tolerance policy configured.", Severity.Warning); return; }
            var updated = 0;
            foreach (var row in _rows)
            {
                var newStatus = row.Computation.Status;
                if (row.Attendance.Status != newStatus)
                {
                    row.Attendance.Status = newStatus;
                    row.Attendance.Notes = row.Computation.Notes;
                    updated++;
                }
            }
            if (updated > 0) await Db.SaveChangesAsync();
            Snackbar.Add($"Recomputed statuses for {_rows.Count} records ({updated} changed).", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    // ───── Clock In/Out dialog ─────
    private bool _showClockDialog;
    private int _clockEmployeeId;
    private bool _clockSaving;

    private void OpenClockDialog()
    {
        _clockEmployeeId = 0;
        _clockSaving = false;
        _showClockDialog = true;
    }

    private void CloseClockDialog() => _showClockDialog = false;

    private void OnClockEmployeeChanged(ChangeEventArgs e)
    {
        _clockEmployeeId = int.TryParse(e.Value?.ToString(), out var v) ? v : 0;
    }

    private async Task ClockEmployee(bool clockIn)
    {
        if (_clockEmployeeId == 0)
        {
            Snackbar.Add("Please select an employee first.", Severity.Warning);
            return;
        }

        _clockSaving = true;
        try
        {
            var emp = _employees.FirstOrDefault(e => e.Id == _clockEmployeeId);
            if (emp == null)
            {
                Snackbar.Add("Employee not found.", Severity.Error);
                return;
            }

            var result = await AttendanceSvc.ClockAsync(_orgId, _clockEmployeeId, clockIn);
            if (result == null)
            {
                Snackbar.Add("Failed to clock — employee not found.", Severity.Error);
                return;
            }

            var action = clockIn ? "clocked in" : "clocked out";
            var time = DateTime.UtcNow.ToString("HH:mm:ss");
            Snackbar.Add($"{emp.FullName} {action} at {time} UTC.", Severity.Success);

            await LoadAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _clockSaving = false;
        }
    }

    private string GetInitials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length < 2 ? (name.Length > 2 ? name[..2].ToUpper() : name.ToUpper()) : $"{parts[0][0]}{parts[^1][0]}".ToUpper();
    }

    private string GetDept(int empId) => _employees.FirstOrDefault(e => e.Id == empId)?.Department ?? "—";

    // ═══════════════════════════════════════════════════════════════════════
    // Import From Device — state + handlers
    // ═══════════════════════════════════════════════════════════════════════

    // Modal visibility
    private bool _showImportInfo = false;   // Stage 1: requirements popup
    private bool _showImportForm = false;   // Stage 2: credentials form

    // Form fields
    private string _importIpAddress = "192.168.1.137";
    private int _importPort = 443;
    private bool _importUseHttps = true;
    private string _importUsername = "admin";
    private string _importPassword = "";
    private DateTime _importFromDate = DateTime.Today.AddDays(-7);
    private DateTime _importToDate = DateTime.Today;
    private int _importMaxResults = 1000;

    // Async state
    private bool _importLoading = false;
    private string _importProgressMessage = "Connecting to device…";
    private string? _importErrorMessage = null;
    private ImportResult? _importResult = null;

    /// <summary>Stage 1: open the info popup.</summary>
    private void OpenImportInfoModal()
    {
        _importErrorMessage = null;
        _importResult = null;
        _showImportInfo = true;
    }

    private void CloseImportInfoModal() => _showImportInfo = false;

    /// <summary>Move from Stage 1 (info) to Stage 2 (form).</summary>
    private void ProceedToImportForm()
    {
        _showImportInfo = false;
        _showImportForm = true;
    }

    private void CloseImportFormModal()
    {
        if (_importLoading) return; // don't allow closing mid-import
        _showImportForm = false;
        _importErrorMessage = null;
        // Keep _importResult so the user can see it on next open if they re-open quickly
    }

    /// <summary>Stage 2 submit: validate inputs, POST to the API, handle the response.</summary>
    private async Task ExecuteImport()
    {
        // ── Client-side validation ──────────────────────────────────────────
        _importErrorMessage = null;
        _importResult = null;

        if (string.IsNullOrWhiteSpace(_importIpAddress))
        {
            _importErrorMessage = "Please enter the device's IP address or hostname.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_importUsername))
        {
            _importErrorMessage = "Please enter the username (default is 'admin').";
            return;
        }
        if (string.IsNullOrWhiteSpace(_importPassword))
        {
            _importErrorMessage = "Please enter the password.";
            return;
        }
        if (_importPort < 1 || _importPort > 65535)
        {
            _importErrorMessage = "Port must be between 1 and 65535.";
            return;
        }
        if (_importFromDate > _importToDate)
        {
            _importErrorMessage = "The 'From' date cannot be after the 'To' date.";
            return;
        }

        // ── Build the request payload ───────────────────────────────────────
        var payload = new
        {
            ipAddress = _importIpAddress.Trim(),
            port = _importPort,
            useHttps = _importUseHttps,
            username = _importUsername.Trim(),
            password = _importPassword,
            from = _importFromDate.ToString("yyyy-MM-dd") + "T00:00:00Z",
            to = _importToDate.ToString("yyyy-MM-dd") + "T23:59:59Z",
            maxResults = _importMaxResults
        };

        _importLoading = true;
        _importProgressMessage = "Connecting to device…";

        try
        {
            // Blazor Server: HttpClient is configured with a BaseAddress at startup.
            // We use a relative URL so it works regardless of where the app is hosted.
            var apiUrl = "/api/attendance/import-from-device";

            // Update progress message before the call (Blazor will re-render)
            _importProgressMessage = $"Connecting to {(_importUseHttps ? "https" : "http")}://{_importIpAddress}:{_importPort} as {_importUsername}…";
            StateHasChanged();

            var response = await Http.PostAsJsonAsync(apiUrl, payload);

            if (response.IsSuccessStatusCode)
            {
                _importResult = await response.Content.ReadFromJsonAsync<ImportResult>();
                _importProgressMessage = "";
                Snackbar.Add($"Import complete: {_importResult?.RecordsImported ?? 0} record(s) imported from {_importResult?.EventsFetched ?? 0} events.", Severity.Success);
                // Reload the attendance list to show the new records
                await LoadAsync();
            }
            else
            {
                var errorBody = await response.Content.ReadFromJsonAsync<ImportErrorResponse>();
                _importErrorMessage = errorBody?.Error ?? $"HTTP {response.StatusCode}";
                _importProgressMessage = "";
            }
        }
        catch (HttpRequestException ex)
        {
            _importErrorMessage = $"Network error reaching the Ukuu HR server: {ex.Message}. " +
                                  "If you're running on https://, the browser may be blocking mixed-content requests to an http:// device. " +
                                  "Try the same URL over http:// or ensure both use the same scheme.";
            _importProgressMessage = "";
        }
        catch (TaskCanceledException)
        {
            _importErrorMessage = "The import request timed out. The device may be unreachable or the date range too large. Try a smaller range (e.g. 7 days).";
            _importProgressMessage = "";
        }
        catch (Exception ex)
        {
            _importErrorMessage = $"Unexpected error: {ex.Message}";
            _importProgressMessage = "";
        }
        finally
        {
            _importLoading = false;
        }
    }

    // ── DTOs for the API response ───────────────────────────────────────────
    private sealed class ImportResult
    {
        public bool Success { get; set; }
        public ImportDeviceInfo Device { get; set; } = new();
        public int EventsFetched { get; set; }
        public int EmployeesMatched { get; set; }
        public int EmployeesUnmatched { get; set; }
        public List<string> UnmatchedSampleCodes { get; set; } = new();
        public int RecordsImported { get; set; }
        public int DuplicatesSkipped { get; set; }
        public List<string> Errors { get; set; } = new();
    }

    private sealed class ImportDeviceInfo
    {
        public string Name { get; set; } = "";
        public string Model { get; set; } = "";
        public string Serial { get; set; } = "";
    }

    private sealed class ImportErrorResponse
    {
        public string? Error { get; set; }
        public string? Stage { get; set; }
    }
}
