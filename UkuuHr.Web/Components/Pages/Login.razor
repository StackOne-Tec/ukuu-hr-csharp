@page "/login"
@inject AuthService Auth
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject ILogger<Login> Logger
@inject NavigationManager Navigation
@layout UkuuHr.Components.Layout.PublicLayout
@attribute [AllowAnonymous]

<style>
/* ═══════════════════════════════════════════════════════════════════════
   UKUU HR — CINEMATIC LOGIN PAGE
   Aurora mesh gradients · Glassmorphism · Particle constellation
   Micro-interactions · Typographic excellence · Staggered entrances
   ═══════════════════════════════════════════════════════════════════════ */

/* ─── FONTS (CDN fallback) ─── */
@@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&family=Inter:wght@400;500;600&display=swap');

/* ─── ROOT LAYOUT ─── */
.bk-login-root {
    display: flex;
    min-height: 100vh;
    width: 100%;
    overflow: hidden;
    font-family: 'Plus Jakarta Sans', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}

/* ═══════════════════════════════════════════════════════
   LEFT PANEL — AURORA VISUAL
   ═══════════════════════════════════════════════════════ */
.bk-login-visual {
    position: relative;
    width: 52%;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 40px 48px;
    overflow: hidden;
    background: #0E0620;
    z-index: 1;
}

/* ─── AURORA MESH GRADIENT (layered animated gradients) ─── */
.bk-aurora-canvas {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
}

.bk-aurora-layer {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.55;
    will-change: transform;
}

.bk-aurora-1 {
    width: 140%;
    height: 100%;
    top: -20%;
    left: -30%;
    background: radial-gradient(ellipse at 30% 50%, #7B2FBE 0%, #5B1F96 40%, transparent 70%);
    animation: aurora-drift-1 18s ease-in-out infinite;
}

.bk-aurora-2 {
    width: 100%;
    height: 120%;
    top: -10%;
    right: -20%;
    background: radial-gradient(ellipse at 70% 40%, #6c63ff 0%, #A78BFA 35%, transparent 65%);
    animation: aurora-drift-2 22s ease-in-out infinite;
}

.bk-aurora-3 {
    width: 80%;
    height: 80%;
    bottom: -15%;
    left: 10%;
    background: radial-gradient(ellipse at 50% 80%, #e85d75 0%, #7B2FBE 40%, transparent 70%);
    animation: aurora-drift-3 25s ease-in-out infinite;
    opacity: 0.3;
}

.bk-aurora-4 {
    width: 60%;
    height: 60%;
    top: 20%;
    right: 5%;
    background: radial-gradient(ellipse at 60% 30%, #14a37f 0%, #5B1F96 50%, transparent 70%);
    animation: aurora-drift-4 30s ease-in-out infinite;
    opacity: 0.2;
}

/* ─── NOISE TEXTURE OVERLAY ─── */
.bk-aurora-noise {
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: 0.03;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    background-size: 128px 128px;
    pointer-events: none;
}

/* ─── CONSTELLATION SVG ─── */
.bk-constellation {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    opacity: 0.12;
}

.bk-constellation line {
    stroke: #A78BFA;
    stroke-width: 0.5;
    stroke-dasharray: 4 8;
    animation: constellation-draw 8s ease-in-out infinite;
}

.bk-constellation circle {
    fill: #A78BFA;
    animation: constellation-pulse 4s ease-in-out infinite;
}

.bk-constellation circle:nth-child(odd) {
    animation-delay: -2s;
}

/* ─── FLOATING ORBS / PARTICLES ─── */
.bk-particles {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    overflow: hidden;
}

.bk-orb {
    position: absolute;
    border-radius: 50%;
    background: radial-gradient(circle at 30% 30%, rgba(167, 139, 250, 0.6), rgba(123, 47, 190, 0.15));
    box-shadow: 0 0 20px rgba(123, 47, 190, 0.3);
    animation: orb-float linear infinite;
    will-change: transform;
}

.bk-orb:nth-child(1) { width:6px; height:6px; top:12%; left:20%; animation-duration:28s; animation-delay:0s; }
.bk-orb:nth-child(2) { width:4px; height:4px; top:28%; left:65%; animation-duration:32s; animation-delay:-4s; }
.bk-orb:nth-child(3) { width:8px; height:8px; top:45%; left:35%; animation-duration:24s; animation-delay:-8s; }
.bk-orb:nth-child(4) { width:3px; height:3px; top:62%; left:75%; animation-duration:36s; animation-delay:-2s; }
.bk-orb:nth-child(5) { width:5px; height:5px; top:78%; left:15%; animation-duration:30s; animation-delay:-12s; }
.bk-orb:nth-child(6) { width:4px; height:4px; top:35%; left:85%; animation-duration:26s; animation-delay:-6s; }
.bk-orb:nth-child(7) { width:7px; height:7px; top:55%; left:50%; animation-duration:34s; animation-delay:-10s; opacity:0.7; }
.bk-orb:nth-child(8) { width:3px; height:3px; top:88%; left:42%; animation-duration:22s; animation-delay:-14s; }
.bk-orb:nth-child(9) { width:5px; height:5px; top:18%; left:48%; animation-duration:38s; animation-delay:-3s; }
.bk-orb:nth-child(10) { width:4px; height:4px; top:72%; left:60%; animation-duration:27s; animation-delay:-9s; }

/* ─── VISUAL CONTENT (above aurora) ─── */
.bk-visual-content {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    flex: 1;
}

/* ─── BRAND ─── */
.bk-login-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: #FFFFFF;
    animation: entrance-down 0.8s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: 0.1s;
}

.bk-login-brand-logo {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.bk-login-brand-logo img {
    width: 28px;
    height: 28px;
    object-fit: contain;
}

.bk-login-brand-name {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.95);
}

.bk-login-brand-tag {
    font-size: 10.5px;
    font-weight: 400;
    letter-spacing: 0.04em;
    color: rgba(167, 139, 250, 0.8);
    margin-top: 1px;
}

/* ─── SYSTEM STATUS ─── */
.bk-status-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
    animation: entrance-down 0.8s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: 0.3s;
}

.bk-status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #14a37f;
    box-shadow: 0 0 8px rgba(20, 163, 127, 0.6);
    animation: status-pulse 2s ease-in-out infinite;
}

.bk-status-text {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px;
    letter-spacing: 0.06em;
    color: rgba(255, 255, 255, 0.5);
}

/* ─── HERO TEXT ─── */
.bk-visual-hero {
    max-width: 480px;
    animation: entrance-up 1s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: 0.25s;
}

.bk-visual-eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #A78BFA;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 10px;
}

.bk-visual-eyebrow::before {
    content: '';
    display: block;
    width: 24px;
    height: 1px;
    background: linear-gradient(90deg, #A78BFA, transparent);
}

.bk-visual-h1 {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 42px;
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.03em;
    color: #FFFFFF;
    margin: 0 0 18px 0;
}

.bk-visual-h1 .bk-word-glow {
    background: linear-gradient(135deg, #A78BFA 0%, #e85d75 50%, #6c63ff 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.bk-visual-lead {
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.55);
    letter-spacing: -0.01em;
    max-width: 420px;
}

/* ─── FEATURE CARDS ─── */
.bk-features-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    animation: entrance-up 1s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: 0.5s;
}

.bk-feature-card {
    background: rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 20px 18px;
    transition: all 0.35s cubic-bezier(0.22, 1, 0.36, 1);
}

.bk-feature-card:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(167, 139, 250, 0.25);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(123, 47, 190, 0.15);
}

.bk-feature-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
    font-size: 18px;
}

.bk-feature-icon--purple {
    background: rgba(123, 47, 190, 0.2);
    color: #A78BFA;
}

.bk-feature-icon--green {
    background: rgba(20, 163, 127, 0.15);
    color: #14a37f;
}

.bk-feature-icon--pink {
    background: rgba(232, 93, 117, 0.15);
    color: #e85d75;
}

.bk-feature-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 13px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
    letter-spacing: -0.01em;
    margin-bottom: 4px;
}

.bk-feature-desc {
    font-family: 'Inter', sans-serif;
    font-size: 11.5px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.4);
}

/* ═══════════════════════════════════════════════════════
   RIGHT PANEL — FORM
   ═══════════════════════════════════════════════════════ */
.bk-login-form-side {
    flex: 1;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40px 48px;
    position: relative;
    background: #FAFAFE;
    background-image:
        radial-gradient(ellipse at 20% 0%, rgba(123, 47, 190, 0.04) 0%, transparent 50%),
        radial-gradient(ellipse at 80% 100%, rgba(167, 139, 250, 0.03) 0%, transparent 50%);
}

/* ─── BACK LINK ─── */
.bk-back-link {
    position: absolute;
    top: 32px;
    left: 40px;
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12.5px;
    font-weight: 500;
    color: var(--bk-ink-3, #7C6BAA);
    text-decoration: none;
    letter-spacing: -0.01em;
    transition: color 0.2s ease;
    animation: entrance-down 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: 0.15s;
}

.bk-back-link:hover {
    color: var(--bk-accent, #7B2FBE);
}

.bk-back-link .material-icons-round {
    font-size: 16px;
    transition: transform 0.2s ease;
}

.bk-back-link:hover .material-icons-round {
    transform: translateX(-3px);
}

/* ─── GLASSMORPHISM CARD ─── */
.bk-login-card {
    width: 100%;
    max-width: 420px;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(24px) saturate(1.2);
    border: 1px solid rgba(123, 47, 190, 0.08);
    border-radius: 20px;
    padding: 40px 36px 36px;
    box-shadow:
        0 0 0 1px rgba(255, 255, 255, 0.6),
        0 4px 6px rgba(123, 47, 190, 0.03),
        0 12px 24px rgba(123, 47, 190, 0.06),
        0 32px 64px rgba(123, 47, 190, 0.04);
    position: relative;
    animation: card-entrance 1s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: 0.2s;
}

/* ─── Subtle inner glow on card ─── */
.bk-login-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 20%;
    right: 20%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(123, 47, 190, 0.2), transparent);
    border-radius: 1px;
}

/* ─── MOBILE BRAND (hidden on desktop) ─── */
.bk-mobile-brand {
    display: none;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    margin-bottom: 28px;
    animation: entrance-up 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: 0.1s;
}

.bk-mobile-brand-logo {
    width: 36px;
    height: 36px;
    border-radius: 9px;
    background: linear-gradient(135deg, #7B2FBE, #5B1F96);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.bk-mobile-brand-logo img {
    width: 24px;
    height: 24px;
    object-fit: contain;
}

.bk-mobile-brand-name {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--bk-ink, #2D1B69);
}

.bk-mobile-brand-tag {
    font-size: 10px;
    color: var(--bk-ink-3, #7C6BAA);
    letter-spacing: 0.03em;
}

/* ─── HEADER ─── */
.bk-form-header {
    margin-bottom: 28px;
    animation: entrance-up 0.8s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: 0.3s;
}

.bk-form-eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #7B2FBE;
    margin-bottom: 8px;
    display: block;
}

.bk-form-h1 {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--bk-ink, #2D1B69);
    margin: 0 0 6px 0;
    line-height: 1.2;
}

.bk-form-sub {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    color: var(--bk-ink-3, #7C6BAA);
    letter-spacing: -0.01em;
    line-height: 1.5;
}

/* ─── ERROR BANNER ─── */
.bk-error-banner {
    margin-bottom: 20px;
    padding: 12px 16px;
    background: linear-gradient(135deg, rgba(220, 38, 38, 0.06), rgba(220, 38, 38, 0.1));
    border: 1px solid rgba(220, 38, 38, 0.18);
    border-radius: 12px;
    color: #991b1b;
    font-size: 13px;
    font-family: 'Inter', sans-serif;
    display: flex;
    align-items: center;
    gap: 10px;
    animation: shake 0.5s cubic-bezier(0.22, 1, 0.36, 1);
}

.bk-error-banner .material-icons-round {
    font-size: 18px;
    color: #DC2626;
    flex-shrink: 0;
}

/* ─── FORM FIELDS ─── */
.bk-field {
    margin-bottom: 20px;
    animation: entrance-up 0.8s cubic-bezier(0.22, 1, 0.36, 1) both;
}

.bk-field:nth-child(1) { animation-delay: 0.35s; }
.bk-field:nth-child(2) { animation-delay: 0.42s; }

.bk-label {
    display: block;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--bk-ink, #2D1B69);
    letter-spacing: 0.01em;
    margin-bottom: 7px;
}

.bk-field-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 7px;
}

.bk-field-link {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 500;
    color: #7B2FBE;
    text-decoration: none;
    letter-spacing: -0.01em;
    transition: color 0.2s ease;
}

.bk-field-link:hover {
    color: #5B1F96;
    text-decoration: underline;
}

/* ─── INPUT WRAPPER ─── */
.bk-input-wrap {
    position: relative;
    display: flex;
    align-items: center;
}

.bk-input-icon {
    position: absolute;
    left: 14px;
    font-size: 18px;
    color: var(--bk-ink-3, #7C6BAA);
    pointer-events: none;
    transition: color 0.25s ease;
    z-index: 2;
}

/* ─── INPUT ─── */
.bk-input {
    width: 100%;
    height: 48px;
    padding: 0 16px 0 44px;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--bk-ink, #2D1B69);
    background: rgba(248, 246, 255, 0.6);
    border: 1.5px solid rgba(123, 47, 190, 0.1);
    border-radius: 12px;
    outline: none;
    transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
}

.bk-input::placeholder {
    color: rgba(124, 107, 170, 0.5);
    font-weight: 400;
}

.bk-input:hover {
    border-color: rgba(123, 47, 190, 0.22);
    background: rgba(248, 246, 255, 0.8);
}

/* ─── GLOW FOCUS ─── */
.bk-input:focus {
    border-color: rgba(123, 47, 190, 0.45);
    background: #FFFFFF;
    box-shadow:
        0 0 0 3px rgba(123, 47, 190, 0.08),
        0 0 0 6px rgba(123, 47, 190, 0.03),
        0 2px 8px rgba(123, 47, 190, 0.06);
}

.bk-input:focus ~ .bk-input-icon,
.bk-input-wrap:focus-within .bk-input-icon {
    color: #7B2FBE;
}

/* ─── PASSWORD TOGGLE ─── */
.bk-pwd-toggle {
    position: absolute;
    right: 4px;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    border: none;
    background: transparent;
    border-radius: 10px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--bk-ink-3, #7C6BAA);
    transition: all 0.2s ease;
    z-index: 2;
}

.bk-pwd-toggle:hover {
    background: rgba(123, 47, 190, 0.06);
    color: #7B2FBE;
}

.bk-pwd-toggle .material-icons-round {
    font-size: 18px;
}

/* ─── CHECKBOX ─── */
.bk-check-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 24px;
    cursor: pointer;
    animation: entrance-up 0.8s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: 0.48s;
    user-select: none;
}

.bk-check-row input[type="checkbox"] {
    display: none;
}

.bk-check-box {
    width: 18px;
    height: 18px;
    border-radius: 5px;
    border: 1.5px solid rgba(123, 47, 190, 0.25);
    background: rgba(248, 246, 255, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.25s cubic-bezier(0.22, 1, 0.36, 1);
    position: relative;
}

.bk-check-box svg {
    width: 11px;
    height: 11px;
    opacity: 0;
    transform: scale(0.5);
    transition: all 0.25s cubic-bezier(0.22, 1, 0.36, 1);
}

.bk-check-row input:checked + .bk-check-box {
    background: #7B2FBE;
    border-color: #7B2FBE;
    box-shadow: 0 0 0 2px rgba(123, 47, 190, 0.15);
}

.bk-check-row input:checked + .bk-check-box svg {
    opacity: 1;
    transform: scale(1);
}

.bk-check-label {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    color: var(--bk-ink-2, #5B3A9E);
    letter-spacing: -0.01em;
}

/* ─── SUBMIT BUTTON ─── */
.bk-submit-btn {
    width: 100%;
    height: 50px;
    border: none;
    border-radius: 12px;
    background: linear-gradient(135deg, #7B2FBE 0%, #5B1F96 100%);
    color: #FFFFFF;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 14.5px;
    font-weight: 600;
    letter-spacing: -0.01em;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    position: relative;
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    animation: entrance-up 0.8s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: 0.52s;
    box-shadow:
        0 2px 4px rgba(123, 47, 190, 0.15),
        0 8px 16px rgba(123, 47, 190, 0.1);
}

.bk-submit-btn:hover {
    transform: translateY(-1px);
    box-shadow:
        0 4px 8px rgba(123, 47, 190, 0.2),
        0 12px 24px rgba(123, 47, 190, 0.15);
}

.bk-submit-btn:active {
    transform: translateY(0px);
    box-shadow:
        0 1px 2px rgba(123, 47, 190, 0.15),
        0 4px 8px rgba(123, 47, 190, 0.1);
}

/* ─── SHIMMER EFFECT ─── */
.bk-submit-btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
        90deg,
        transparent 0%,
        rgba(255, 255, 255, 0.15) 40%,
        rgba(255, 255, 255, 0.25) 50%,
        rgba(255, 255, 255, 0.15) 60%,
        transparent 100%
    );
    animation: shimmer 3s ease-in-out infinite;
    animation-delay: 1.5s;
}

.bk-submit-btn .material-icons-round {
    font-size: 18px;
    transition: transform 0.2s ease;
}

.bk-submit-btn:hover .material-icons-round {
    transform: translateX(3px);
}

/* ─── DIVIDER ─── */
.bk-divider {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 24px 0;
    animation: entrance-up 0.8s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: 0.56s;
}

.bk-divider::before,
.bk-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(123, 47, 190, 0.12), transparent);
}

.bk-divider span {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    color: var(--bk-ink-3, #7C6BAA);
    letter-spacing: 0.02em;
    white-space: nowrap;
}

/* ─── SOCIAL BUTTONS ─── */
.bk-social-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    animation: entrance-up 0.8s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: 0.6s;
}

.bk-social-btn {
    height: 44px;
    border: 1.5px solid rgba(123, 47, 190, 0.1);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.7);
    color: var(--bk-ink, #2D1B69);
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: -0.01em;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: all 0.25s cubic-bezier(0.22, 1, 0.36, 1);
}

.bk-social-btn:hover {
    border-color: rgba(123, 47, 190, 0.22);
    background: #FFFFFF;
    box-shadow: 0 2px 8px rgba(123, 47, 190, 0.06);
    transform: translateY(-1px);
}

.bk-social-btn:active {
    transform: translateY(0px);
}

/* Google icon */
.bk-social-icon--google {
    width: 18px;
    height: 18px;
    display: inline-block;
}

/* Microsoft icon */
.bk-social-icon--ms {
    width: 18px;
    height: 18px;
    display: inline-grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5px;
}

.bk-social-icon--ms span {
    display: block;
    width: 7px;
    height: 7px;
    border-radius: 1px;
}

.bk-social-icon--ms span:nth-child(1) { background: #F25022; }
.bk-social-icon--ms span:nth-child(2) { background: #7FBA00; }
.bk-social-icon--ms span:nth-child(3) { background: #00A4EF; }
.bk-social-icon--ms span:nth-child(4) { background: #FFB900; }

/* ─── DEMO CREDENTIALS ─── */
.bk-demo-creds {
    margin-top: 24px;
    padding: 14px 16px;
    background: linear-gradient(135deg, rgba(123, 47, 190, 0.04), rgba(167, 139, 250, 0.06));
    border: 1px solid rgba(123, 47, 190, 0.08);
    border-radius: 10px;
    animation: entrance-up 0.8s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: 0.64s;
}

.bk-demo-creds-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bk-ink-3, #7C6BAA);
    margin-bottom: 6px;
}

.bk-demo-creds-row {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
}

.bk-demo-email {
    color: #7B2FBE;
    font-weight: 500;
}

.bk-demo-sep {
    color: rgba(123, 47, 190, 0.2);
}

.bk-demo-pass {
    color: var(--bk-ink-2, #5B3A9E);
    font-weight: 400;
}

/* ─── FOOTER ─── */
.bk-form-footer {
    margin-top: 24px;
    text-align: center;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    color: var(--bk-ink-3, #7C6BAA);
    letter-spacing: -0.01em;
    animation: entrance-up 0.8s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: 0.68s;
}

.bk-form-footer a {
    color: #7B2FBE;
    text-decoration: none;
    font-weight: 600;
    transition: color 0.2s ease;
}

.bk-form-footer a:hover {
    color: #5B1F96;
    text-decoration: underline;
}

/* ═══════════════════════════════════════════════════════
   KEYFRAMES
   ═══════════════════════════════════════════════════════ */

/* Aurora drift animations */
@@keyframes aurora-drift-1 {
    0%, 100% { transform: translate(0%, 0%) scale(1); }
    33% { transform: translate(8%, -5%) scale(1.05); }
    66% { transform: translate(-3%, 8%) scale(0.97); }
}

@@keyframes aurora-drift-2 {
    0%, 100% { transform: translate(0%, 0%) scale(1); }
    33% { transform: translate(-6%, 6%) scale(1.03); }
    66% { transform: translate(5%, -4%) scale(0.98); }
}

@@keyframes aurora-drift-3 {
    0%, 100% { transform: translate(0%, 0%) scale(1) rotate(0deg); }
    50% { transform: translate(10%, -8%) scale(1.08) rotate(5deg); }
}

@@keyframes aurora-drift-4 {
    0%, 100% { transform: translate(0%, 0%) scale(1); }
    40% { transform: translate(-8%, 6%) scale(1.04); }
    80% { transform: translate(4%, -3%) scale(0.96); }
}

/* Constellation animations */
@@keyframes constellation-draw {
    0%, 100% { stroke-dashoffset: 0; opacity: 0.6; }
    50% { stroke-dashoffset: 12; opacity: 1; }
}

@@keyframes constellation-pulse {
    0%, 100% { r: 1.5; opacity: 0.5; }
    50% { r: 2.5; opacity: 1; }
}

/* Floating orbs */
@@keyframes orb-float {
    0% { transform: translate(0, 0) scale(1); opacity: 0.6; }
    25% { transform: translate(30px, -20px) scale(1.2); opacity: 0.9; }
    50% { transform: translate(-15px, 25px) scale(0.8); opacity: 0.5; }
    75% { transform: translate(20px, 10px) scale(1.1); opacity: 0.8; }
    100% { transform: translate(0, 0) scale(1); opacity: 0.6; }
}

/* Status pulse */
@@keyframes status-pulse {
    0%, 100% { box-shadow: 0 0 4px rgba(20, 163, 127, 0.4); }
    50% { box-shadow: 0 0 12px rgba(20, 163, 127, 0.8), 0 0 24px rgba(20, 163, 127, 0.3); }
}

/* Entrance animations */
@@keyframes entrance-up {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
}

@@keyframes entrance-down {
    from { opacity: 0; transform: translateY(-12px); }
    to { opacity: 1; transform: translateY(0); }
}

@@keyframes card-entrance {
    from {
        opacity: 0;
        transform: translateY(24px) scale(0.98);
    }
    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

/* Shimmer */
@@keyframes shimmer {
    0% { left: -100%; }
    50%, 100% { left: 100%; }
}

/* Error shake */
@@keyframes shake {
    0%, 100% { transform: translateX(0); }
    20% { transform: translateX(-6px); }
    40% { transform: translateX(6px); }
    60% { transform: translateX(-4px); }
    80% { transform: translateX(4px); }
}

