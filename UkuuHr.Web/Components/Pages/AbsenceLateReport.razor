@page "/reports/absence"
@rendermode RenderMode.InteractiveServer
@attribute [Authorize]
@using Microsoft.EntityFrameworkCore
@inject UkuuHrDbContext Db
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<div class="bk-admin-fade-in">
    <div class="bk-admin-section-header">
        <div class="bk-admin-section-header-left">
            <div class="bk-admin-greeting">Reports · Absence & Late</div>
            <h1 class="bk-admin-h1">Absence & Late Report</h1>
            <p class="bk-admin-sub">
                Track absent and late attendance records by employee, department, and period. Export to CSV or Excel.
            </p>
        </div>
        <div class="bk-admin-actions">
            <button class="bk-btn bk-btn-secondary" @onclick="GenerateReport" disabled="@(_loading)">
                <span class="material-icons-round" style="font-size:16px;">refresh</span>
                Generate
            </button>
            <button class="bk-btn bk-btn-secondary" @onclick="ExportCsv" disabled="@(_records.Count == 0)">
                <span class="material-icons-round" style="font-size:16px;">download</span>
                Export CSV
            </button>
            <button class="bk-btn bk-btn-primary" @onclick="ExportXlsx" disabled="@(_records.Count == 0)">
                <span class="material-icons-round" style="font-size:16px;">table_view</span>
                Export Excel
            </button>
        </div>
    </div>

    <!-- Filters -->
    <div class="bk-admin-card" style="margin-bottom:24px;">
        <div class="bk-admin-card-header">
            <h3>Report Filters</h3>
            <p>Select the period and optional filters for your absence/late report.</p>
        </div>
        <div class="bk-admin-card-content">
            <div style="display:flex;flex-wrap:wrap;gap:12px;border-bottom:1px solid var(--bk-line);margin-bottom:18px;padding-bottom:12px;">
                @foreach (var option in _periodOptions)
                {
                    var isActive = _selectedPeriod == option.Value;
                    <button type="button"
                            @onclick="() => SelectPeriod(option.Value)"
                            style="display:inline-flex;align-items:center;gap:10px;padding:12px 18px;border:none;border-bottom:2px solid @(isActive ? "var(--bk-accent)" : "transparent");background:transparent;color:@(isActive ? "var(--bk-ink)" : "var(--bk-ink-3)");font-size:14px;font-weight:@(isActive ? "700" : "600");cursor:pointer;">
                        <span class="material-icons-round" style="font-size:20px;">@option.Icon</span>
                        <span>@option.Label</span>
                    </button>
                }
            </div>

            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:16px;">
                <div class="bk-field">
                    <label class="bk-label">Start Date</label>
                    <div class="bk-input-wrap">
                        <span class="material-icons-round bk-input-icon">today</span>
                        <input type="date" class="bk-input" @bind="_fromDate" @bind:event="onchange"
                               style="padding-left:44px;" />
                    </div>
                </div>

                <div class="bk-field">
                    <label class="bk-label">End Date</label>
                    <div class="bk-input-wrap">
                        <span class="material-icons-round bk-input-icon">event</span>
                        <input type="date" class="bk-input" @bind="_toDate" @bind:event="onchange"
                               style="padding-left:44px;" />
                    </div>
                </div>

                <div class="bk-field">
                    <label class="bk-label">Status</label>
                    <select class="bk-input" @bind="_statusFilter" style="padding-left:16px;">
                        <option value="">All (Absent + Late)</option>
                        <option value="Absent">Absent Only</option>
                        <option value="Late">Late Only</option>
                    </select>
                </div>

                <div class="bk-field">
                    <label class="bk-label">Department</label>
                    <select class="bk-input" @bind="_departmentFilter" style="padding-left:16px;">
                        <option value="">All Departments</option>
                        @foreach (var dept in _departments)
                        {
                            <option value="@dept">@dept</option>
                        }
                    </select>
                </div>
            </div>

            <div style="display:flex;gap:8px;margin-top:12px;padding-top:12px;border-top:1px solid var(--bk-line);">
                <span style="font-size:12px;color:var(--bk-ink-3);padding:6px 0;">Quick range:</span>
                <button class="bk-btn bk-btn-secondary" style="font-size:11px;padding:4px 10px;min-height:30px;" @onclick="SetLast7">Last 7 days</button>
                <button class="bk-btn bk-btn-secondary" style="font-size:11px;padding:4px 10px;min-height:30px;" @onclick="SetLast30">Last 30 days</button>
                <button class="bk-btn bk-btn-secondary" style="font-size:11px;padding:4px 10px;min-height:30px;" @onclick="SetLast90">Last 90 days</button>
                <button class="bk-btn bk-btn-secondary" style="font-size:11px;padding:4px 10px;min-height:30px;" @onclick="SetThisMonth">This month</button>
                <button class="bk-btn bk-btn-secondary" style="font-size:11px;padding:4px 10px;min-height:30px;" @onclick="SetLastMonth">Last month</button>
            </div>
        </div>
    </div>

    <!-- Loading -->
    @if (_loading)
    {
        <div style="display:flex;justify-content:center;padding:60px;">
            <div class="ukuu-loader"></div>
        </div>
    }
    else if (_records.Count > 0)
    {
        <!-- Summary KPIs -->
        <div class="bk-admin-kpi-grid" style="grid-template-columns:repeat(auto-fit,minmax(160px,1fr));margin-bottom:24px;">
            <div class="bk-admin-kpi-card" style="padding:14px 16px;">
                <div class="bk-admin-kpi-value" style="font-size:22px;">@GetFilteredCount()</div>
                <div class="bk-admin-kpi-label">Total Records</div>
            </div>
            <div class="bk-admin-kpi-card" style="padding:14px 16px;">
                <div class="bk-admin-kpi-value" style="font-size:22px;color:#DC2626;">@GetFilteredByStatus("Absent")</div>
                <div class="bk-admin-kpi-label">Absent</div>
            </div>
            <div class="bk-admin-kpi-card" style="padding:14px 16px;">
                <div class="bk-admin-kpi-value" style="font-size:22px;color:#d89c11;">@GetFilteredByStatus("Late")</div>
                <div class="bk-admin-kpi-label">Late</div>
            </div>
            <div class="bk-admin-kpi-card" style="padding:14px 16px;">
                <div class="bk-admin-kpi-value" style="font-size:22px;">@GetFilteredEmployeeCount()</div>
                <div class="bk-admin-kpi-label">Employees Affected</div>
            </div>
        </div>

        <!-- Breakdown by Department -->
        <div class="bk-admin-card" style="margin-bottom:24px;">
            <div class="bk-admin-card-header">
                <h3>By Department</h3>
                <p>Absence and late records by department</p>
            </div>
            <div style="padding:0 20px 20px;">
                <div style="display:flex;flex-direction:column;gap:10px;">
                    @{
                        var byDept = GetByDepartment();
                        var total = GetFilteredCount();
                    }
                    @foreach (var dept in byDept.OrderByDescending(d => d.Value))
                    {
                        <div style="display:flex;align-items:center;gap:12px;">
                            <div style="width:12px;height:12px;border-radius:3px;background:#d89c11;"></div>
                            <span style="flex:1;font-size:13px;color:var(--bk-ink);">@(string.IsNullOrEmpty(dept.Key) ? "Unassigned" : dept.Key)</span>
                            <span style="font-weight:700;font-size:13px;">@dept.Value</span>
                            <span style="font-size:11px;color:var(--bk-ink-3);width:40px;text-align:right;">@(total > 0 ? (dept.Value * 100.0 / total).ToString("0") : "0")%</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Detail table -->
        <div class="bk-admin-card" style="overflow:hidden;">
            <div class="bk-admin-card-header">
                <h3>Detail — @GetFilteredCount() records</h3>
                <p>@_fromDate.ToString("yyyy-MM-dd") to @_toDate.ToString("yyyy-MM-dd")</p>
            </div>
            <div style="overflow-x:auto;">
                <table class="bk-admin-table">
                    <thead>
                        <tr>
                            <th>Employee</th>
                            <th>Department</th>
                            <th>Branch</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Check In</th>
                            <th>Check Out</th>
                            <th>Hours</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in GetFilteredRecords().Take(100))
                        {
                            <tr>
                                <td style="font-weight:600;font-size:13px;">@r.EmployeeName</td>
                                <td style="font-size:12px;">@GetDepartment(r.EmployeeId)</td>
                                <td style="font-size:12px;">@GetBranch(r.EmployeeId)</td>
                                <td style="font-family:var(--ukuu-font-mono);font-size:12px;">@r.Date.ToString("dd MMM yyyy")<br/><span style="font-size:10px;color:var(--bk-ink-3);">@r.Date.ToString("dddd")</span></td>
                                <td><span class="bk-admin-pill @(r.Status == AttendanceStatus.Absent ? "inactive" : "pending")" style="font-size:10px;">@r.Status</span></td>
                                <td style="font-family:var(--ukuu-font-mono);font-size:12px;">@(r.CheckIn?.ToString("HH:mm") ?? "—")</td>
                                <td style="font-family:var(--ukuu-font-mono);font-size:12px;">@(r.CheckOut?.ToString("HH:mm") ?? "—")</td>
                                <td style="font-weight:600;">@(r.WorkedHours > 0 ? r.WorkedHours.ToString("0.0") + "h" : "—")</td>
                                <td style="font-size:11px;color:var(--bk-ink-3);max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@(r.Notes ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (GetFilteredCount() > 100)
                {
                    <div style="padding:12px 16px;text-align:center;font-size:12px;color:var(--bk-ink-3);">
                        Showing 100 of @GetFilteredCount() records. Export to CSV or Excel for the full dataset.
                    </div>
                }
            </div>
        </div>
    }
    else if (!_loading)
    {
        <div class="bk-admin-card">
            <div style="padding:64px 24px;text-align:center;color:var(--bk-ink-3);">
                <span class="material-icons-round" style="font-size:64px;opacity:0.4;">event_busy</span>
                <h3 style="margin-top:16px;font-size:18px;color:var(--bk-ink-2);">No absence or late records found</h3>
                <p style="font-size:14px;margin-top:4px;">All employees are on time for this period. Adjust filters to see more.</p>
            </div>
        </div>
    }
</div>

@code {
    private string _selectedPeriod = "Monthly";
    private DateTime _fromDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime _toDate = DateTime.Today;
    private string _statusFilter = "";
    private string _departmentFilter = "";
    private List<Attendance> _records = new();
    private List<string> _departments = new();
    private Dictionary<int, Employee> _employeeMap = new();
    private bool _loading;
    private int _orgId;

    private readonly (string Value, string Label, string Icon)[] _periodOptions =
    {
        ("Monthly", "Monthly", "calendar_view_month"),
        ("Last7", "Last 7 Days", "date_range"),
        ("Last30", "Last 30 Days", "date_range"),
        ("Custom", "Custom", "edit_calendar")
    };

    protected override async Task OnInitializedAsync()
    {
        var org = await Db.Organizations.FirstOrDefaultAsync();
        if (org == null) return;
        _orgId = org.Id;

        // Load departments for filter
        _departments = await Db.Employees
            .Where(e => e.OrganizationId == org.Id && e.Department != null)
            .Select(e => e.Department!)
            .Distinct()
            .OrderBy(d => d)
            .ToListAsync();

        UpdateDateRange();
        await GenerateReport();
    }

    private void SelectPeriod(string period)
    {
        _selectedPeriod = period;
        UpdateDateRange();
    }

    private void UpdateDateRange()
    {
        switch (_selectedPeriod)
        {
            case "Monthly":
                _fromDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
                _toDate = DateTime.Today;
                break;
            case "Last7":
                _fromDate = DateTime.Today.AddDays(-6);
                _toDate = DateTime.Today;
                break;
            case "Last30":
                _fromDate = DateTime.Today.AddDays(-29);
                _toDate = DateTime.Today;
                break;
        }
    }

    private List<Attendance> GetFilteredRecords()
    {
        return _records
            .Where(r => string.IsNullOrEmpty(_statusFilter) || r.Status.ToString() == _statusFilter)
            .Where(r => string.IsNullOrEmpty(_departmentFilter) || GetDepartment(r.EmployeeId) == _departmentFilter)
            .ToList();
    }

    private int GetFilteredCount() => GetFilteredRecords().Count;
    private int GetFilteredByStatus(string status) => GetFilteredRecords().Count(r => r.Status.ToString() == status);
    private int GetFilteredEmployeeCount() => GetFilteredRecords().Select(r => r.EmployeeId).Distinct().Count();
    private Dictionary<string, int> GetByDepartment()
    {
        return GetFilteredRecords()
            .GroupBy(r => GetDepartment(r.EmployeeId))
            .ToDictionary(g => g.Key, g => g.Count());
    }

    private string GetDepartment(int employeeId)
    {
        if (_employeeMap.TryGetValue(employeeId, out var emp) && !string.IsNullOrWhiteSpace(emp.Department))
            return emp.Department;
        return "";
    }

    private string GetBranch(int employeeId)
    {
        if (_employeeMap.TryGetValue(employeeId, out var emp) && !string.IsNullOrWhiteSpace(emp.City))
            return emp.City;
        return "";
    }

    private async Task GenerateReport()
    {
        _loading = true;
        try
        {
            _records = await Db.Attendances
                .Where(a => a.OrganizationId == _orgId && a.Date >= _fromDate && a.Date <= _toDate.AddDays(1).AddTicks(-1)
                         && (a.Status == AttendanceStatus.Absent || a.Status == AttendanceStatus.Late))
                .OrderByDescending(a => a.Date)
                .ToListAsync();

            // Load employee map
            var empIds = _records.Select(r => r.EmployeeId).Distinct().ToList();
            if (empIds.Count > 0)
            {
                var employees = await Db.Employees.Where(e => empIds.Contains(e.Id)).ToListAsync();
                _employeeMap = employees.ToDictionary(e => e.Id);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SetLast7()
    {
        _fromDate = DateTime.Today.AddDays(-6);
        _toDate = DateTime.Today;
        await GenerateReport();
    }

    private async Task SetLast30()
    {
        _fromDate = DateTime.Today.AddDays(-29);
        _toDate = DateTime.Today;
        await GenerateReport();
    }

    private async Task SetLast90()
    {
        _fromDate = DateTime.Today.AddDays(-89);
        _toDate = DateTime.Today;
        await GenerateReport();
    }

    private async Task SetThisMonth()
    {
        _fromDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        _toDate = DateTime.Today;
        await GenerateReport();
    }

    private async Task SetLastMonth()
    {
        var lastMonth = DateTime.Today.AddMonths(-1);
        _fromDate = new DateTime(lastMonth.Year, lastMonth.Month, 1);
        _toDate = _fromDate.AddMonths(1).AddDays(-1);
        await GenerateReport();
    }

    private void ExportCsv()
    {
        if (_records.Count == 0) return;
        var from = _fromDate.ToString("yyyy-MM-dd");
        var to = _toDate.ToString("yyyy-MM-dd");
        var url = $"/api/reports/absence/csv?orgId={_orgId}&from={Uri.EscapeDataString(from)}&to={Uri.EscapeDataString(to)}";
        Nav.NavigateTo(url, forceLoad: true);
        Snackbar.Add("CSV export downloading...", Severity.Success);
    }

    private void ExportXlsx()
    {
        if (_records.Count == 0) return;
        var from = _fromDate.ToString("yyyy-MM-dd");
        var to = _toDate.ToString("yyyy-MM-dd");
        var url = $"/api/reports/absence/xlsx?orgId={_orgId}&from={Uri.EscapeDataString(from)}&to={Uri.EscapeDataString(to)}";
        Nav.NavigateTo(url, forceLoad: true);
        Snackbar.Add("Excel export downloading...", Severity.Success);
    }
}
