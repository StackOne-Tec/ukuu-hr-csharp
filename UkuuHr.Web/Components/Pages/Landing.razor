<script>
    // ─────────────────────────────────────────────────────────────────────────
    // Scroll progress indicator — updates the bar width as the user scrolls.
    // ─────────────────────────────────────────────────────────────────────────
    (function () {
        const bar = document.getElementById('lpScrollProgress');
        if (!bar) return;
        function updateProgress() {
            const scrollTop = window.scrollY || document.documentElement.scrollTop;
            const scrollHeight = document.documentElement.scrollHeight - window.innerHeight;
            const pct = scrollHeight > 0 ? Math.min(100, (scrollTop / scrollHeight) * 100) : 0;
            bar.style.width = pct + '%';
        }
        window.addEventListener('scroll', updateProgress, { passive: true });
        updateProgress();
    })();

    // ─────────────────────────────────────────────────────────────────────────
    // Scroll-triggered animations via IntersectionObserver.
    // Animates: stat counters (count-up), and any .lp-animate / .lp-stat-card
    // that scrolls into view. Respects prefers-reduced-motion.
    // ─────────────────────────────────────────────────────────────────────────
    (function () {
        const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (prefersReduced) {
            document.querySelectorAll('.lp-stat-counter').forEach(el => {
                el.textContent = el.getAttribute('data-target') || '0';
            });
            document.querySelectorAll('.lp-animate, .lp-stat-card').forEach(el => el.classList.add('lp-visible'));
            return;
        }

        function animateCounter(el, target, durationMs) {
            const start = 0, startTime = performance.now();
            function tick(now) {
                const elapsed = now - startTime;
                const p = Math.min(1, elapsed / durationMs);
                const eased = 1 - Math.pow(1 - p, 3); // easeOutCubic
                el.textContent = Math.round(start + (target - start) * eased).toLocaleString();
                if (p < 1) requestAnimationFrame(tick);
                else el.textContent = target.toLocaleString();
            }
            requestAnimationFrame(tick);
        }

        const statsObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    const card = entry.target;
                    card.classList.add('lp-visible');
                    const counter = card.querySelector('.lp-stat-counter');
                    if (counter && !counter.dataset.animated) {
                        const target = parseInt(counter.getAttribute('data-target') || '0', 10);
                        animateCounter(counter, target, 1800);
                        counter.dataset.animated = '1';
                    }
                    statsObserver.unobserve(card);
                }
            });
        }, { threshold: 0.4 });
        document.querySelectorAll('.lp-stat-card').forEach(el => statsObserver.observe(el));

        const animateObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('lp-visible');
                    animateObserver.unobserve(entry.target);
                }
            });
        }, { threshold: 0.15 });
        document.querySelectorAll('.lp-animate').forEach(el => animateObserver.observe(el));
    })();

    // ─────────────────────────────────────────────────────────────────────────
    // Before/After slider — drag the handle to reveal more of either pane.
    // ─────────────────────────────────────────────────────────────────────────
    (function () {
        const slider = document.getElementById('lpCompareSlider');
        if (!slider) return;
        const before = slider.querySelector('.lp-compare-before');
        const handle = document.getElementById('lpCompareHandle');
        let dragging = false;

        function setPos(clientX) {
            const rect = slider.getBoundingClientRect();
            const pct = Math.max(0, Math.min(100, ((clientX - rect.left) / rect.width) * 100));
            before.style.width = pct + '%';
            handle.style.left = pct + '%';
        }
        slider.addEventListener('mousedown', (e) => { dragging = true; setPos(e.clientX); });
        document.addEventListener('mousemove', (e) => { if (dragging) setPos(e.clientX); });
        document.addEventListener('mouseup', () => { dragging = false; });
        slider.addEventListener('touchstart', (e) => { dragging = true; setPos(e.touches[0].clientX); }, { passive: true });
        document.addEventListener('touchmove', (e) => { if (dragging) setPos(e.touches[0].clientX); }, { passive: true });
        document.addEventListener('touchend', () => { dragging = false; });

        // Hint animation: slide from 50% to 35% on first scroll into view
        const hintObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    let pos = 50, target = 35, steps = 30, i = 0;
                    const t = setInterval(() => {
                        if (i++ >= steps) { clearInterval(t); return; }
                        pos = 50 + (target - 50) * (i / steps);
                        before.style.width = pos + '%';
                        handle.style.left = pos + '%';
                    }, 30);
                    hintObserver.unobserve(entry.target);
                }
            });
        }, { threshold: 0.6 });
        hintObserver.observe(slider);
    })();
</script>

