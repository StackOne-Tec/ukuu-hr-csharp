    margin-bottom: 40px; padding: 14px 20px;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 12px;
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
}
.lp-build-status-item {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 12px; font-weight: 600; letter-spacing: 0.04em;
    color: rgba(255,255,255,0.75);
}
.lp-build-badge { height: 18px; width: auto; border-radius: 3px; }

/* ─── Video frame — cinematic product reel ─── */
.lp-video-frame {
    position: relative;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 40px 100px rgba(0,0,0,0.5), 0 0 0 1px rgba(123,47,190,0.2);
    transition: box-shadow 0.4s ease;
}
.lp-video-frame:hover {
    box-shadow: 0 50px 120px rgba(0,0,0,0.6), 0 0 0 1px rgba(167,139,250,0.35);
}
.lp-video-overlay {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
    background: rgba(0,0,0,0.15);
    opacity: 0; transition: opacity 0.3s ease;
    cursor: pointer;
}
.lp-video-play-btn {
    width: 80px; height: 80px; border-radius: 50%;
