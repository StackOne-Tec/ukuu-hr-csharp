    // Cache-busting version for the demo video + images.
    // Uses the assembly build timestamp so every deploy generates a new URL,
    // forcing browsers to fetch fresh assets instead of serving stale cache.
    private string _videoVersion = System.IO.File.GetLastWriteTime(typeof(Program).Assembly.Location).ToString("yyyyMMddHHmmss");

    protected override void OnInitialized()
    {
        // If user is already authenticated, redirect straight to Dashboard
        var user = HttpAccessor.HttpContext?.User;
        if (user?.Identity?.IsAuthenticated == true)
        {
            Nav.NavigateTo("/dashboard", forceLoad: true);
            return;
        }

        DetectFileSizes();
        DetectVersion();
    }

    private void DetectFileSizes()
    {
        try
        {
            var wwwroot = Path.Combine(AppContext.BaseDirectory, "wwwroot", "downloads");
            var winPath = Path.Combine(wwwroot, "UkuuHr-Windows-x64.exe");
            var macPath = Path.Combine(wwwroot, "UkuuHr-macOS-arm64");

            if (File.Exists(winPath))
            {
                var mb = new FileInfo(winPath).Length / (1024.0 * 1024.0);
                _winFileSize = $"~{mb:F0} MB";
            }
            else
            {
                _winFileSize = "not available";
            }

            if (File.Exists(macPath))
            {
                var mb = new FileInfo(macPath).Length / (1024.0 * 1024.0);
                _macFileSize = $"~{mb:F0} MB";
            }
            else
            {
                _macFileSize = "not available";
            }
        }
        catch
        {
            _winFileSize = "~36 MB";
            _macFileSize = "~35 MB";
        }
    }

    private void DetectVersion()
    {
        try
        {
            var version = System.Reflection.Assembly.GetExecutingAssembly()
                .GetName().Version;
            if (version != null)
            {
                _latestVersion = $"v{version.Major}.{version.Minor}";
            }
        }
        catch
        {
        }
    }

