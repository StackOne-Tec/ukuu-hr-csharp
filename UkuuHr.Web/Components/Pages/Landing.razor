@page "/landing"
@layout UkuuHr.Components.Layout.PublicLayout
@attribute [AllowAnonymous]

<style>
/* ═══════════════════════════════════════════════════════════════
   UKUU HR LANDING — World-Class Design System (Scoped)
   8px grid · Mobile-first · Award-quality typography
   ═══════════════════════════════════════════════════════════════ */

:root {
    --lp-purple: #7B2FBE;
    --lp-purple-deep: #5B1F96;
    --lp-purple-mid: #6A24A8;
    --lp-ink: #2D1B69;
    --lp-lavender: #A78BFA;
    --lp-gold: #d89c11;
    --lp-green: #14a37f;
    --lp-pink: #e85d75;
    --lp-surface: #F8F6FF;
    --lp-surface-strong: #E8DFF5;
    --lp-white: #FFFFFF;
    --lp-dark: #0E0620;
    --lp-dark-2: #160A30;
}

html { scroll-behavior: smooth; }

@@keyframes lpAurora {
    0%   { background-position: 0% 50%; opacity: 0.6; }
    25%  { opacity: 0.8; }
    50%  { background-position: 100% 50%; opacity: 0.5; }
    75%  { opacity: 0.7; }
    100% { background-position: 0% 50%; opacity: 0.6; }
}

@@keyframes lpAurora2 {
    0%   { background-position: 100% 0%; opacity: 0.4; }
    50%  { background-position: 0% 100%; opacity: 0.6; }
    100% { background-position: 100% 0%; opacity: 0.4; }
}

@@keyframes lpMeshFloat {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33%      { transform: translate(30px, -20px) scale(1.05); }
    66%      { transform: translate(-20px, 15px) scale(0.97); }
}

@@keyframes lpBadgeFloat {
    0%, 100% { transform: translateY(0px); }
    50%      { transform: translateY(-8px); }
}

@@keyframes lpBadgeFloat2 {
    0%, 100% { transform: translateY(0px); }
    50%      { transform: translateY(-12px); }
}

@@keyframes lpScrollHint {
    0%, 100% { transform: translateY(0); opacity: 1; }
    50%      { transform: translateY(8px); opacity: 0.4; }
}

@@keyframes lpFadeUp {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
}

@@keyframes lpCounterPulse {
    0%, 100% { text-shadow: 0 0 20px rgba(123,47,190,0.3); }
    50%      { text-shadow: 0 0 40px rgba(123,47,190,0.6), 0 0 80px rgba(123,47,190,0.2); }
}

@@keyframes lpStepPulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(123,47,190,0.4); }
    50%      { box-shadow: 0 0 0 8px rgba(123,47,190,0); }
}

@@keyframes lpStatusPulse {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0.5; }
}

@@keyframes lpCardShine {
    from { transform: translateX(-100%); }
    to   { transform: translateX(100%); }
}

/* Header */
.lp-header {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    padding: 0 24px; height: 64px;
    display: flex; align-items: center; justify-content: space-between;
    background: rgba(14, 6, 32, 0.85);
    backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(255,255,255,0.06);
}
.lp-header-brand { display: flex; align-items: center; gap: 10px; text-decoration: none; }
.lp-header-brand img { height: 32px; }
.lp-header-brand-text { display: flex; flex-direction: column; }
.lp-header-brand-name { font-size: 15px; font-weight: 800; color: #fff; letter-spacing: 0.02em; line-height: 1.2; }
.lp-header-brand-tag { font-size: 9px; color: rgba(255,255,255,0.5); letter-spacing: 0.08em; text-transform: uppercase; font-weight: 700; }
.lp-nav { display: flex; align-items: center; gap: 28px; }
.lp-nav a { font-size: 13px; font-weight: 500; color: rgba(255,255,255,0.6); text-decoration: none; transition: color 0.2s ease; }
.lp-nav a:hover { color: rgba(255,255,255,0.95); }
.lp-header-right { display: flex; align-items: center; gap: 16px; }
.lp-status-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--lp-green); animation: lpStatusPulse 2s ease-in-out infinite; }
.lp-status-text { font-size: 11px; color: rgba(255,255,255,0.4); display: flex; align-items: center; gap: 6px; }
.lp-btn-signin { font-size: 13px; font-weight: 600; color: #fff; background: var(--lp-purple); padding: 8px 20px; border-radius: 8px; text-decoration: none; transition: all 0.2s ease; }
.lp-btn-signin:hover { background: var(--lp-purple-mid); transform: translateY(-1px); box-shadow: 0 8px 24px rgba(123,47,190,0.3); }

/* Hero */
.lp-hero {
    position: relative; min-height: 100vh;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    overflow: hidden; background: var(--lp-dark); padding: 80px 24px 40px;
}
.lp-hero-aurora {
    position: absolute; inset: 0;
    background: linear-gradient(135deg, rgba(123,47,190,0.12), rgba(232,93,117,0.08), rgba(108,99,255,0.12), rgba(20,163,127,0.08));
    background-size: 400% 400%; animation: lpAurora 12s ease-in-out infinite; pointer-events: none;
}
.lp-hero-aurora2 {
    position: absolute; inset: 0;
    background: radial-gradient(ellipse at 70% 20%, rgba(123,47,190,0.25), transparent 60%),
                radial-gradient(ellipse at 20% 80%, rgba(232,93,117,0.15), transparent 50%);
    background-size: 200% 200%; animation: lpAurora2 15s ease-in-out infinite; pointer-events: none;
}
.lp-hero-mesh1 {
    position: absolute; width: 600px; height: 600px; top: -200px; right: -150px;
    background: radial-gradient(circle, rgba(123,47,190,0.12), transparent 70%);
    border-radius: 50%; animation: lpMeshFloat 20s ease-in-out infinite; filter: blur(60px); pointer-events: none;
}
.lp-hero-mesh2 {
    position: absolute; width: 500px; height: 500px; bottom: -100px; left: -100px;
    background: radial-gradient(circle, rgba(232,93,117,0.1), transparent 70%);
    border-radius: 50%; animation: lpMeshFloat 25s ease-in-out infinite reverse; filter: blur(80px); pointer-events: none;
}
.lp-hero-mesh3 {
    position: absolute; width: 400px; height: 400px; top: 30%; left: 40%;
    background: radial-gradient(circle, rgba(108,99,255,0.08), transparent 70%);
    border-radius: 50%; animation: lpMeshFloat 18s ease-in-out infinite 3s; filter: blur(60px); pointer-events: none;
}
.lp-hero-content { position: relative; z-index: 2; text-align: center; max-width: 900px; margin: 0 auto; }
.lp-hero-eyebrow {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 12px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase;
    color: rgba(255,255,255,0.5); margin-bottom: 24px; animation: lpFadeUp 0.8s ease-out both;
}
.lp-hero-eyebrow::before {
    content: ''; width: 6px; height: 6px; border-radius: 50%;
    background: var(--lp-purple); box-shadow: 0 0 0 3px rgba(123,47,190,0.3);
}
.lp-hero-h1 {
    font-size: clamp(40px, 7vw, 80px); font-weight: 800; line-height: 1.05;
    letter-spacing: -0.03em; color: #fff; margin-bottom: 24px;
    animation: lpFadeUp 0.8s ease-out 0.1s both;
}
.lp-gradient-text {
    background: linear-gradient(135deg, #A78BFA 0%, #7B2FBE 30%, #e85d75 70%, #d89c11 100%);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
}
.lp-hero-sub {
    font-size: clamp(16px, 2vw, 20px); line-height: 1.6; color: rgba(255,255,255,0.55);
    max-width: 600px; margin: 0 auto 40px; letter-spacing: -0.01em;
    animation: lpFadeUp 0.8s ease-out 0.2s both;
}
.lp-hero-actions {
    display: flex; align-items: center; justify-content: center; gap: 16px; flex-wrap: wrap;
    margin-bottom: 56px; animation: lpFadeUp 0.8s ease-out 0.3s both;
}
.lp-btn-hero-primary {
    display: inline-flex; align-items: center; gap: 8px; font-size: 15px; font-weight: 600; color: #fff;
    background: linear-gradient(135deg, var(--lp-purple), var(--lp-purple-mid));
    padding: 14px 32px; border-radius: 12px; text-decoration: none; transition: all 0.25s ease;
    box-shadow: 0 4px 24px rgba(123,47,190,0.3);
}
.lp-btn-hero-primary:hover { transform: translateY(-2px); box-shadow: 0 12px 40px rgba(123,47,190,0.4); }
.lp-btn-hero-secondary {
    display: inline-flex; align-items: center; gap: 8px; font-size: 15px; font-weight: 600;
    color: rgba(255,255,255,0.8); background: rgba(255,255,255,0.08);
    padding: 14px 32px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.15);
    text-decoration: none; transition: all 0.25s ease;
}
.lp-btn-hero-secondary:hover { background: rgba(255,255,255,0.12); border-color: rgba(255,255,255,0.3); transform: translateY(-1px); }
.lp-hero-badges { display: flex; align-items: center; justify-content: center; gap: 20px; flex-wrap: wrap; animation: lpFadeUp 0.8s ease-out 0.4s both; }
.lp-float-badge {
    display: flex; align-items: center; gap: 10px; padding: 10px 20px;
    background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.08);
    border-radius: 12px; backdrop-filter: blur(12px);
    animation: lpBadgeFloat 4s ease-in-out infinite; animation-delay: var(--delay, 0s);
}
.lp-float-badge:nth-child(2) { animation: lpBadgeFloat2 5s ease-in-out infinite; animation-delay: 0.5s; }
.lp-float-badge:nth-child(3) { animation: lpBadgeFloat 4.5s ease-in-out infinite; animation-delay: 1s; }
.lp-float-badge-icon { width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; }
.lp-float-badge-text { font-size: 12px; color: rgba(255,255,255,0.7); line-height: 1.3; }
.lp-float-badge-text strong { display: block; font-size: 14px; color: #fff; font-weight: 700; }
.lp-scroll-hint {
    position: absolute; bottom: 32px; left: 50%; transform: translateX(-50%);
    display: flex; flex-direction: column; align-items: center; gap: 8px;
    animation: lpScrollHint 2s ease-in-out infinite; z-index: 2;
}
.lp-scroll-hint-line { width: 1px; height: 32px; background: linear-gradient(to bottom, rgba(255,255,255,0.4), transparent); }
.lp-scroll-hint-text { font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255,255,255,0.3); }

/* Trust Strip */
.lp-trust-strip { background: var(--lp-surface); border-bottom: 1px solid var(--lp-surface-strong); padding: 16px 24px; text-align: center; }
.lp-trust-strip-inner { display: flex; align-items: center; justify-content: center; gap: 6px; flex-wrap: wrap; font-size: 13px; color: var(--lp-ink); font-weight: 500; }
.lp-flag-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; margin: 0 2px; }
.lp-trust-divider { color: rgba(45,27,105,0.3); margin: 0 8px; }

/* Bento Grid */
.lp-bento { padding: 96px 24px; background: var(--lp-white); }
.lp-bento-header { text-align: center; max-width: 600px; margin: 0 auto 56px; }
.lp-bento-eyebrow { font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--lp-purple); margin-bottom: 16px; }
.lp-bento-title { font-size: clamp(28px, 4vw, 40px); font-weight: 800; letter-spacing: -0.03em; color: var(--lp-ink); line-height: 1.15; margin-bottom: 16px; }
.lp-bento-sub { font-size: 16px; line-height: 1.6; color: #5B3A9E; margin: 0; }
.lp-bento-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; max-width: 1120px; margin: 0 auto; }
.lp-bento-card { position: relative; border-radius: 20px; padding: 32px; overflow: hidden; transition: transform 0.3s ease, box-shadow 0.3s ease; cursor: default; }
.lp-bento-card::before {
    content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 100%;
    background: linear-gradient(105deg, transparent 40%, rgba(255,255,255,0.05) 45%, rgba(255,255,255,0.1) 50%, rgba(255,255,255,0.05) 55%, transparent 60%);
    transform: translateX(-100%); pointer-events: none;
}
.lp-bento-card:hover::before { animation: lpCardShine 0.6s ease-out; }
.lp-bento-card:hover { transform: translateY(-4px); }
.lp-bento-card-light { background: var(--lp-surface); border: 1px solid var(--lp-surface-strong); }
.lp-bento-card-light:hover { box-shadow: 0 12px 40px rgba(123,47,190,0.08); }
.lp-bento-card-dark { background: var(--lp-ink); border: 1px solid rgba(123,47,190,0.3); color: #fff; }
.lp-bento-card-dark:hover { box-shadow: 0 12px 40px rgba(45,27,105,0.3); }
.lp-bento-card-accent { background: linear-gradient(135deg, var(--lp-purple), var(--lp-purple-mid)); border: none; color: #fff; }
.lp-bento-card-accent:hover { box-shadow: 0 12px 40px rgba(123,47,190,0.3); }
.lp-bento-icon { display: flex; align-items: center; justify-content: center; width: 48px; height: 48px; border-radius: 14px; margin-bottom: 20px; }
.lp-bento-icon-light { background: rgba(123,47,190,0.08); color: var(--lp-purple); }
.lp-bento-icon-dark { background: rgba(255,255,255,0.1); color: rgba(255,255,255,0.9); }
.lp-bento-icon-accent { background: rgba(255,255,255,0.2); color: #fff; }
.lp-bento-card h3 { font-size: 18px; font-weight: 700; margin-bottom: 8px; letter-spacing: -0.02em; line-height: 1.3; }
.lp-bento-card p { font-size: 14px; line-height: 1.6; margin: 0; }
.lp-bento-card-light p { color: #5B3A9E; }
.lp-bento-card-light h3 { color: var(--lp-ink); }
.lp-bento-card-dark p, .lp-bento-card-accent p { color: rgba(255,255,255,0.7); }
.lp-bento-card-dark h3, .lp-bento-card-accent h3 { color: #fff; }
.lp-bento-tag { display: inline-block; font-size: 11px; font-weight: 600; letter-spacing: 0.04em; padding: 4px 10px; border-radius: 6px; margin-top: 16px; margin-right: 4px; }
.lp-bento-tag-light { background: rgba(123,47,190,0.08); color: var(--lp-purple); }
.lp-bento-tag-dark { background: rgba(255,255,255,0.1); color: rgba(255,255,255,0.8); }
.lp-bento-span-2 { grid-column: span 2; }

/* Metrics */
.lp-metrics { background: var(--lp-dark); padding: 80px 24px; position: relative; overflow: hidden; }
.lp-metrics::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse at 50% 0%, rgba(123,47,190,0.15), transparent 70%); pointer-events: none; }
.lp-metrics-inner { max-width: 1000px; margin: 0 auto; text-align: center; position: relative; z-index: 1; }
.lp-metrics-eyebrow { font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--lp-lavender); margin-bottom: 8px; }
.lp-metrics-title { font-size: clamp(24px, 3.5vw, 36px); font-weight: 800; color: #fff; letter-spacing: -0.03em; margin-bottom: 48px; }
.lp-metrics-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; }
.lp-metric-item { text-align: center; }
.lp-metric-number {
    font-size: clamp(36px, 5vw, 56px); font-weight: 800; letter-spacing: -0.04em;
    background: linear-gradient(135deg, #fff, var(--lp-lavender));
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
    animation: lpCounterPulse 3s ease-in-out infinite; line-height: 1.1; margin-bottom: 8px;
}
.lp-metric-label { font-size: 14px; color: rgba(255,255,255,0.5); font-weight: 500; }

/* Workflow */
.lp-workflow { padding: 96px 24px; background: var(--lp-white); }
.lp-workflow-header { text-align: center; max-width: 600px; margin: 0 auto 64px; }
.lp-workflow-steps { display: flex; align-items: flex-start; justify-content: center; max-width: 900px; margin: 0 auto; position: relative; }
.lp-workflow-step { display: flex; flex-direction: column; align-items: center; text-align: center; flex: 1; position: relative; padding: 0 16px; }
.lp-workflow-step::after {
    content: ''; position: absolute; top: 28px; right: -20px; width: 40px; height: 2px;
    background: linear-gradient(90deg, var(--lp-purple), rgba(123,47,190,0.2)); opacity: 0.3;
}
.lp-workflow-step:last-child::after { display: none; }
.lp-workflow-icon-ring {
    width: 56px; height: 56px; border-radius: 50%; border: 2px solid rgba(123,47,190,0.2);
    display: flex; align-items: center; justify-content: center; margin-bottom: 20px;
    background: var(--lp-surface); transition: all 0.3s ease;
}
.lp-workflow-step:hover .lp-workflow-icon-ring { border-color: var(--lp-purple); animation: lpStepPulse 1.5s ease-in-out infinite; background: rgba(123,47,190,0.06); }
.lp-workflow-icon-ring span { font-size: 24px; color: var(--lp-purple); }
.lp-workflow-num { font-size: 11px; font-weight: 700; letter-spacing: 0.08em; color: var(--lp-lavender); margin-bottom: 8px; }
.lp-workflow-step h3 { font-size: 16px; font-weight: 700; color: var(--lp-ink); margin-bottom: 8px; letter-spacing: -0.02em; }
.lp-workflow-step p { font-size: 13px; line-height: 1.5; color: #7C6BAA; margin: 0; max-width: 200px; }

/* Testimonials */
.lp-testimonials { padding: 96px 24px; background: var(--lp-dark-2); position: relative; overflow: hidden; }
.lp-testimonials::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse at 30% 50%, rgba(123,47,190,0.1), transparent 60%); pointer-events: none; }
.lp-testimonials-inner { max-width: 1000px; margin: 0 auto; position: relative; text-align: center; z-index: 1; }
.lp-testimonials-eyebrow { font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--lp-lavender); margin-bottom: 8px; }
.lp-testimonials-title { font-size: clamp(24px, 3.5vw, 36px); font-weight: 800; color: #fff; letter-spacing: -0.03em; margin-bottom: 48px; }
.lp-testimonial-cards { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
.lp-testimonial-card {
    background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08);
    border-radius: 20px; padding: 32px; backdrop-filter: blur(16px); text-align: left; transition: all 0.3s ease;
}
.lp-testimonial-card:hover { background: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.12); transform: translateY(-2px); }
.lp-testimonial-quote { font-size: 15px; line-height: 1.7; color: rgba(255,255,255,0.75); margin-bottom: 24px; position: relative; padding-left: 20px; font-style: italic; }
.lp-testimonial-quote::before { content: '\201C'; position: absolute; left: -4px; top: -8px; font-size: 48px; color: var(--lp-lavender); font-style: normal; opacity: 0.4; line-height: 1; }
.lp-testimonial-author { display: flex; align-items: center; gap: 12px; }
.lp-testimonial-avatar {
    width: 40px; height: 40px; border-radius: 50%;
    background: linear-gradient(135deg, var(--lp-purple), var(--lp-pink));
    display: flex; align-items: center; justify-content: center;
    font-size: 16px; font-weight: 700; color: #fff; flex-shrink: 0;
}
.lp-testimonial-name { font-size: 14px; font-weight: 600; color: #fff; }
.lp-testimonial-role { font-size: 12px; color: rgba(255,255,255,0.4); }

/* Download */
.lp-download { padding: 96px 24px; background: linear-gradient(180deg, var(--lp-ink) 0%, #1A0D42 100%); position: relative; overflow: hidden; }
.lp-download::before { content: ''; position: absolute; width: 600px; height: 600px; top: -300px; right: -200px; background: radial-gradient(circle, rgba(123,47,190,0.2), transparent 70%); border-radius: 50%; filter: blur(80px); pointer-events: none; }
.lp-download-inner { max-width: 900px; margin: 0 auto; text-align: center; position: relative; z-index: 1; }
.lp-download-eyebrow { font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--lp-lavender); margin-bottom: 8px; }
.lp-download-title { font-size: clamp(24px, 3.5vw, 36px); font-weight: 800; color: #fff; letter-spacing: -0.03em; margin-bottom: 12px; }
.lp-download-sub { font-size: 15px; color: rgba(255,255,255,0.5); margin-bottom: 40px; }
.lp-download-cards { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; max-width: 640px; margin: 0 auto 32px; }
.lp-dl-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 20px; padding: 32px 24px; backdrop-filter: blur(16px); transition: all 0.3s ease; }
.lp-dl-card:hover { background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.15); transform: translateY(-3px); }
.lp-dl-icon { width: 56px; height: 56px; border-radius: 16px; background: rgba(255,255,255,0.08); display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; }
.lp-dl-icon span { font-size: 28px; color: #fff; }
.lp-dl-card h3 { font-size: 18px; font-weight: 700; color: #fff; margin-bottom: 8px; }
.lp-dl-card p { font-size: 12px; line-height: 1.5; color: rgba(255,255,255,0.5); margin-bottom: 20px; }
.lp-dl-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px; width: 100%; padding: 12px 20px;
    background: linear-gradient(135deg, rgba(255,255,255,0.1), rgba(255,255,255,0.05));
    border: 1px solid rgba(255,255,255,0.15); border-radius: 10px; color: #fff; font-size: 14px; font-weight: 600;
    text-decoration: none; transition: all 0.2s ease;
}
.lp-dl-btn:hover { background: linear-gradient(135deg, rgba(255,255,255,0.15), rgba(255,255,255,0.08)); border-color: rgba(255,255,255,0.25); transform: translateY(-1px); }
.lp-dl-meta { font-size: 11px; color: rgba(255,255,255,0.35); margin-top: 12px; }
.lp-dl-note { font-size: 11px; color: rgba(255,255,255,0.25); margin-top: 4px; }
.lp-dl-pwa { max-width: 560px; margin: 0 auto; padding: 20px 24px; background: rgba(255,255,255,0.03); border-radius: 14px; border: 1px solid rgba(255,255,255,0.06); display: flex; align-items: flex-start; gap: 16px; text-align: left; }
.lp-dl-pwa-icon { width: 36px; height: 36px; flex-shrink: 0; border-radius: 10px; background: rgba(255,255,255,0.06); display: flex; align-items: center; justify-content: center; }
.lp-dl-pwa-icon span { font-size: 20px; color: rgba(255,255,255,0.7); }
.lp-dl-pwa h4 { font-size: 14px; font-weight: 700; color: #fff; margin-bottom: 4px; }
.lp-dl-pwa p { font-size: 12px; line-height: 1.5; color: rgba(255,255,255,0.5); margin: 0; }
.lp-dl-pwa a { color: var(--lp-lavender); text-decoration: underline; }

/* CTA */
.lp-cta { padding: 96px 24px; background: linear-gradient(135deg, var(--lp-purple) 0%, var(--lp-purple-deep) 50%, #1A0D42 100%); position: relative; overflow: hidden; text-align: center; }
.lp-cta::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse at 50% 100%, rgba(167,139,250,0.15), transparent 60%); pointer-events: none; }
.lp-cta-inner { max-width: 640px; margin: 0 auto; position: relative; z-index: 1; }
.lp-cta-title { font-size: clamp(28px, 4.5vw, 44px); font-weight: 800; color: #fff; letter-spacing: -0.03em; line-height: 1.15; margin-bottom: 16px; }
.lp-cta-sub { font-size: 16px; line-height: 1.6; color: rgba(255,255,255,0.65); margin-bottom: 32px; }
.lp-cta-btn {
    display: inline-flex; align-items: center; gap: 8px; font-size: 16px; font-weight: 700;
    color: var(--lp-purple); background: #fff; padding: 16px 40px; border-radius: 12px;
    text-decoration: none; transition: all 0.25s ease; box-shadow: 0 4px 24px rgba(0,0,0,0.15);
}
.lp-cta-btn:hover { transform: translateY(-2px); box-shadow: 0 12px 40px rgba(0,0,0,0.2); }
.lp-cta-creds { margin-top: 24px; font-size: 13px; color: rgba(255,255,255,0.45); }
.lp-cta-creds code { font-family: 'JetBrains Mono', monospace; font-size: 12px; color: var(--lp-lavender); background: rgba(255,255,255,0.08); padding: 2px 8px; border-radius: 4px; font-weight: 600; }

/* Footer */
.lp-footer { background: var(--lp-dark); padding: 48px 24px 24px; border-top: 1px solid rgba(255,255,255,0.06); }
.lp-footer-inner { max-width: 1000px; margin: 0 auto; }
.lp-footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 48px; margin-bottom: 40px; }
.lp-footer-brand { display: flex; align-items: center; gap: 10px; margin-bottom: 16px; }
.lp-footer-brand img { height: 28px; }
.lp-footer-brand span { font-size: 15px; font-weight: 800; color: #fff; letter-spacing: 0.02em; }
.lp-footer p { font-size: 13px; line-height: 1.6; color: rgba(255,255,255,0.45); margin: 0 0 12px; }
.lp-footer h4 { font-size: 12px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: rgba(255,255,255,0.6); margin-bottom: 16px; }
.lp-footer ul { list-style: none; padding: 0; margin: 0; }
.lp-footer li { margin-bottom: 10px; }
.lp-footer a { font-size: 13px; color: rgba(255,255,255,0.45); text-decoration: none; transition: color 0.2s ease; }
.lp-footer a:hover { color: rgba(255,255,255,0.9); }
.lp-footer-bottom { display: flex; align-items: center; justify-content: space-between; padding-top: 24px; border-top: 1px solid rgba(255,255,255,0.06); font-size: 12px; color: rgba(255,255,255,0.3); }
.lp-footer-status { display: inline-flex; align-items: center; gap: 6px; }
.lp-footer-status-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--lp-green); animation: lpStatusPulse 2s ease-in-out infinite; }

/* Responsive */
@@media (max-width: 900px) {
    .lp-bento-grid { grid-template-columns: repeat(2, 1fr); }
    .lp-bento-span-2 { grid-column: span 2; }
    .lp-metrics-grid { grid-template-columns: repeat(2, 1fr); gap: 24px; }
    .lp-testimonial-cards { grid-template-columns: 1fr; }
    .lp-download-cards { grid-template-columns: 1fr; max-width: 320px; }
    .lp-footer-grid { grid-template-columns: 1fr; gap: 32px; }
    .lp-workflow-steps { flex-direction: column; align-items: center; gap: 32px; }
    .lp-workflow-step::after { display: none; }
    .lp-nav { display: none; }
}
@@media (max-width: 600px) {
    .lp-bento-grid { grid-template-columns: 1fr; }
    .lp-bento-span-2 { grid-column: span 1; }
    .lp-metrics-grid { grid-template-columns: repeat(2, 1fr); }
    .lp-hero-h1 { font-size: 32px; }
    .lp-hero-badges { flex-direction: column; align-items: center; }
    .lp-status-text { display: none; }
    .lp-footer-bottom { flex-direction: column; gap: 8px; text-align: center; }
    .lp-hero-preview { max-width: 95%; }
    .lp-preview-sidebar { display: none; }
    .lp-preview-main { border-radius: 0; }
}

/* ─── Dashboard Preview (Hero) ─── */
.lp-hero-preview {
    position: relative; z-index: 2;
    max-width: 860px; width: 100%; margin: 0 auto;
    perspective: 1200px;
}
.lp-preview-window {
    background: rgba(14,6,32,0.85); border: 1px solid rgba(123,47,190,0.2);
    border-radius: 16px; overflow: hidden; backdrop-filter: blur(20px);
    box-shadow: 0 32px 80px rgba(0,0,0,0.5), 0 0 0 1px rgba(123,47,190,0.1), inset 0 1px 0 rgba(255,255,255,0.05);
    transform: rotateX(2deg); transition: transform 0.4s ease;
}
.lp-preview-window:hover { transform: rotateX(0deg) scale(1.01); }
.lp-preview-titlebar {
    display: flex; align-items: center; gap: 12px;
    padding: 12px 16px; border-bottom: 1px solid rgba(255,255,255,0.06);
}
.lp-preview-dots { display: flex; gap: 6px; }
.lp-preview-dots span { width: 10px; height: 10px; border-radius: 50%; }
.lp-preview-title { font-size: 12px; color: rgba(255,255,255,0.4); font-weight: 500; letter-spacing: 0.02em; }
.lp-preview-body { display: flex; min-height: 220px; }
.lp-preview-sidebar {
    width: 180px; padding: 12px 0; border-right: 1px solid rgba(255,255,255,0.06);
    display: flex; flex-direction: column; gap: 2px;
}
.lp-preview-sb-item {
    display: flex; align-items: center; gap: 10px; padding: 8px 16px;
    font-size: 12px; color: rgba(255,255,255,0.45); cursor: default;
}
.lp-preview-sb-item.active { color: #fff; background: rgba(123,47,190,0.15); border-right: 2px solid #7B2FBE; }
.lp-preview-main { flex: 1; padding: 16px; display: flex; flex-direction: column; gap: 16px; }
.lp-preview-kpi-row { display: grid; grid-template-columns: repeat(4,1fr); gap: 10px; }
.lp-preview-kpi {
    background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.06);
    border-radius: 10px; padding: 12px; text-align: center;
}
.lp-preview-kpi.accent { background: linear-gradient(135deg, rgba(123,47,190,0.2), rgba(123,47,190,0.08)); border-color: rgba(123,47,190,0.2); }
.lp-preview-kpi-label { font-size: 10px; color: rgba(255,255,255,0.4); text-transform: uppercase; letter-spacing: 0.06em; font-weight: 600; }
.lp-preview-kpi-value { font-size: 24px; font-weight: 800; color: #fff; margin: 4px 0 2px; }
.lp-preview-kpi-delta { font-size: 11px; font-weight: 600; }
.lp-preview-kpi-delta.up { color: #14a37f; }
.lp-preview-kpi-delta.warn { color: #d89c11; }
.lp-preview-chart { flex: 1; display: flex; align-items: flex-end; gap: 8px; padding-top: 8px; border-top: 1px solid rgba(255,255,255,0.06); }
.lp-preview-bar { flex: 1; border-radius: 4px 4px 0 0; min-height: 20px; transition: height 0.3s ease; opacity: 0.8; }
.lp-preview-bar:hover { opacity: 1; }
</style>

