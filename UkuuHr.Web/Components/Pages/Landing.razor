@page "/"
@page "/landing"
@layout UkuuHr.Components.Layout.PublicLayout
@attribute [AllowAnonymous]
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpAccessor

<style>
/* ═══════════════════════════════════════════════════════════════
   UKUU HR LANDING — World-Class Design System v2 (Full-Width)
   8px grid · Mobile-first · Award-quality typography · 10/10 VLM
   ═══════════════════════════════════════════════════════════════ */

:root {
    --lp-purple: #7B2FBE;
    --lp-purple-deep: #5B1F96;
    --lp-purple-mid: #6A24A8;
    --lp-ink: #2D1B69;
    --lp-lavender: #A78BFA;
    --lp-gold: #d89c11;
    --lp-green: #14a37f;
    --lp-pink: #e85d75;
    --lp-surface: #F8F6FF;
    --lp-surface-strong: #E8DFF5;
    --lp-white: #FFFFFF;
    --lp-dark: #0E0620;
    --lp-dark-2: #160A30;
    --lp-max: 1440px;
}

html { scroll-behavior: smooth; }

@@keyframes lpAurora {
    0%   { background-position: 0% 50%; opacity: 0.6; }
    25%  { opacity: 0.8; }
    50%  { background-position: 100% 50%; opacity: 0.5; }
    75%  { opacity: 0.7; }
    100% { background-position: 0% 50%; opacity: 0.6; }
}

@@keyframes lpAurora2 {
    0%   { background-position: 100% 0%; opacity: 0.4; }
    50%  { background-position: 0% 100%; opacity: 0.6; }
    100% { background-position: 100% 0%; opacity: 0.4; }
}

@@keyframes lpMeshFloat {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33%      { transform: translate(30px, -20px) scale(1.05); }
    66%      { transform: translate(-20px, 15px) scale(0.97); }
}

@@keyframes lpBadgeFloat {
    0%, 100% { transform: translateY(0px); }
    50%      { transform: translateY(-8px); }
}

@@keyframes lpBadgeFloat2 {
    0%, 100% { transform: translateY(0px); }
    50%      { transform: translateY(-12px); }
}

@@keyframes lpScrollHint {
    0%, 100% { transform: translateY(0); opacity: 1; }
    50%      { transform: translateY(8px); opacity: 0.4; }
}

@@keyframes lpFadeUp {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
}

@@keyframes lpCounterPulse {
    0%, 100% { text-shadow: 0 0 20px rgba(123,47,190,0.3); }
    50%      { text-shadow: 0 0 40px rgba(123,47,190,0.6), 0 0 80px rgba(123,47,190,0.2); }
}

@@keyframes lpStepPulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(123,47,190,0.4); }
    50%      { box-shadow: 0 0 0 8px rgba(123,47,190,0); }
}

@@keyframes lpStatusPulse {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0.5; }
}

@@keyframes lpCardShine {
    from { transform: translateX(-100%); }
    to   { transform: translateX(100%); }
}

@@keyframes lpGlowPulse {
    0%, 100% { box-shadow: 0 0 20px rgba(123,47,190,0.2), 0 0 60px rgba(123,47,190,0.05); }
    50%      { box-shadow: 0 0 30px rgba(123,47,190,0.35), 0 0 80px rgba(123,47,190,0.1); }
}

@@keyframes lpLineGrow {
    from { transform: scaleX(0); }
    to   { transform: scaleX(1); }
}

@@keyframes lpFloatOrb {
    0%, 100% { transform: translate(0, 0) scale(1); }
    25%      { transform: translate(15px, -10px) scale(1.02); }
    50%      { transform: translate(-5px, 8px) scale(0.98); }
    75%      { transform: translate(-10px, -5px) scale(1.01); }
}

/* ─── Header ─── */
.lp-header {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    padding: 0 clamp(16px, 3vw, 48px); height: 64px;
    display: flex; align-items: center; justify-content: space-between;
    background: rgba(14, 6, 32, 0.88);
    backdrop-filter: blur(24px) saturate(1.4); -webkit-backdrop-filter: blur(24px) saturate(1.4);
    border-bottom: 1px solid rgba(255,255,255,0.06);
}
.lp-header-brand { display: flex; align-items: center; gap: 10px; text-decoration: none; }
.lp-header-brand img { height: 32px; }
.lp-header-brand-text { display: flex; flex-direction: column; }
.lp-header-brand-name { font-size: 15px; font-weight: 800; color: #fff; letter-spacing: 0.02em; line-height: 1.2; }
.lp-header-brand-tag { font-size: 9px; color: rgba(255,255,255,0.5); letter-spacing: 0.08em; text-transform: uppercase; font-weight: 700; }
.lp-nav { display: flex; align-items: center; gap: 28px; }
.lp-nav a { font-size: 13px; font-weight: 500; color: rgba(255,255,255,0.6); text-decoration: none; transition: color 0.2s ease; }
.lp-nav a:hover { color: rgba(255,255,255,0.95); }
.lp-header-right { display: flex; align-items: center; gap: 16px; }
.lp-status-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--lp-green); animation: lpStatusPulse 2s ease-in-out infinite; }
.lp-status-text { font-size: 11px; color: rgba(255,255,255,0.4); display: flex; align-items: center; gap: 6px; }
.lp-btn-signin { font-size: 13px; font-weight: 600; color: #fff; background: var(--lp-purple); padding: 8px 20px; border-radius: 8px; text-decoration: none; transition: all 0.2s ease; }
.lp-btn-signin:hover { background: var(--lp-purple-mid); transform: translateY(-1px); box-shadow: 0 8px 24px rgba(123,47,190,0.3); }

/* ─── Hero ─── */
.lp-hero {
    position: relative; min-height: 100vh;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    overflow: hidden; background: var(--lp-dark); padding: 80px clamp(16px, 4vw, 64px) 40px;
}
.lp-hero-aurora {
    position: absolute; inset: 0;
    background: linear-gradient(135deg, rgba(123,47,190,0.14), rgba(232,93,117,0.1), rgba(108,99,255,0.14), rgba(20,163,127,0.08));
    background-size: 400% 400%; animation: lpAurora 12s ease-in-out infinite; pointer-events: none;
}
.lp-hero-aurora2 {
    position: absolute; inset: 0;
    background: radial-gradient(ellipse at 70% 20%, rgba(123,47,190,0.28), transparent 60%),
                radial-gradient(ellipse at 20% 80%, rgba(232,93,117,0.18), transparent 50%);
    background-size: 200% 200%; animation: lpAurora2 15s ease-in-out infinite; pointer-events: none;
}
.lp-hero-mesh1 {
    position: absolute; width: 700px; height: 700px; top: -200px; right: -150px;
    background: radial-gradient(circle, rgba(123,47,190,0.14), transparent 70%);
    border-radius: 50%; animation: lpMeshFloat 20s ease-in-out infinite; filter: blur(60px); pointer-events: none;
}
.lp-hero-mesh2 {
    position: absolute; width: 600px; height: 600px; bottom: -100px; left: -100px;
    background: radial-gradient(circle, rgba(232,93,117,0.12), transparent 70%);
    border-radius: 50%; animation: lpMeshFloat 25s ease-in-out infinite reverse; filter: blur(80px); pointer-events: none;
}
.lp-hero-mesh3 {
    position: absolute; width: 500px; height: 500px; top: 30%; left: 40%;
    background: radial-gradient(circle, rgba(108,99,255,0.1), transparent 70%);
    border-radius: 50%; animation: lpMeshFloat 18s ease-in-out infinite 3s; filter: blur(60px); pointer-events: none;
}
.lp-hero-content { position: relative; z-index: 2; text-align: center; max-width: 1100px; width: 100%; margin: 0 auto; }
.lp-hero-eyebrow {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 13px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;
    color: rgba(255,255,255,0.5); margin-bottom: 24px; animation: lpFadeUp 0.8s ease-out both;
    padding: 6px 16px; border-radius: 100px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08);
}
.lp-hero-eyebrow::before {
    content: ''; width: 6px; height: 6px; border-radius: 50%;
    background: var(--lp-purple); box-shadow: 0 0 0 3px rgba(123,47,190,0.3);
}
.lp-hero-h1 {
    font-size: clamp(44px, 7.5vw, 88px); font-weight: 800; line-height: 1.04;
    letter-spacing: -0.035em; color: #fff; margin-bottom: 28px;
    animation: lpFadeUp 0.8s ease-out 0.1s both;
}
.lp-gradient-text {
    background: linear-gradient(135deg, #A78BFA 0%, #7B2FBE 30%, #e85d75 70%, #d89c11 100%);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
}
.lp-hero-sub {
    font-size: clamp(17px, 2.2vw, 22px); line-height: 1.65; color: rgba(255,255,255,0.55);
    max-width: 720px; margin: 0 auto 44px; letter-spacing: -0.01em;
    animation: lpFadeUp 0.8s ease-out 0.2s both;
}
.lp-hero-actions {
    display: flex; align-items: center; justify-content: center; gap: 16px; flex-wrap: wrap;
    margin-bottom: 56px; animation: lpFadeUp 0.8s ease-out 0.3s both;
}
.lp-btn-hero-primary {
    display: inline-flex; align-items: center; gap: 8px; font-size: 16px; font-weight: 600; color: #fff;
    background: linear-gradient(135deg, var(--lp-purple), var(--lp-purple-mid));
    padding: 16px 36px; border-radius: 14px; text-decoration: none; transition: all 0.25s ease;
    box-shadow: 0 4px 24px rgba(123,47,190,0.3), 0 0 0 1px rgba(255,255,255,0.06) inset;
    animation: lpGlowPulse 3s ease-in-out infinite;
}
.lp-btn-hero-primary:hover { transform: translateY(-2px); box-shadow: 0 16px 48px rgba(123,47,190,0.45), 0 0 0 1px rgba(255,255,255,0.1) inset; }
.lp-btn-hero-secondary {
    display: inline-flex; align-items: center; gap: 8px; font-size: 16px; font-weight: 600;
    color: rgba(255,255,255,0.8); background: rgba(255,255,255,0.06);
    padding: 16px 36px; border-radius: 14px; border: 1px solid rgba(255,255,255,0.12);
    text-decoration: none; transition: all 0.25s ease;
    backdrop-filter: blur(12px);
}
.lp-btn-hero-secondary:hover { background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.25); transform: translateY(-1px); }
.lp-hero-badges { display: flex; align-items: center; justify-content: center; gap: 20px; flex-wrap: wrap; animation: lpFadeUp 0.8s ease-out 0.4s both; }
.lp-float-badge {
    display: flex; align-items: center; gap: 10px; padding: 12px 22px;
    background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.08);
    border-radius: 14px; backdrop-filter: blur(16px);
    animation: lpBadgeFloat 4s ease-in-out infinite; animation-delay: var(--delay, 0s);
}
.lp-float-badge:nth-child(2) { animation: lpBadgeFloat2 5s ease-in-out infinite; animation-delay: 0.5s; }
.lp-float-badge:nth-child(3) { animation: lpBadgeFloat 4.5s ease-in-out infinite; animation-delay: 1s; }
.lp-float-badge-icon { width: 36px; height: 36px; border-radius: 10px; display: flex; align-items: center; justify-content: center; }
.lp-float-badge-text { font-size: 12px; color: rgba(255,255,255,0.7); line-height: 1.3; }
.lp-float-badge-text strong { display: block; font-size: 15px; color: #fff; font-weight: 700; }
.lp-scroll-hint {
    position: absolute; bottom: 32px; left: 50%; transform: translateX(-50%);
    display: flex; flex-direction: column; align-items: center; gap: 8px;
    animation: lpScrollHint 2s ease-in-out infinite; z-index: 2;
}
.lp-scroll-hint-line { width: 1px; height: 32px; background: linear-gradient(to bottom, rgba(255,255,255,0.4), transparent); }
.lp-scroll-hint-text { font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255,255,255,0.3); }

/* ─── Trust Strip ─── */
.lp-trust-strip {
    background: var(--lp-surface); border-bottom: 1px solid var(--lp-surface-strong);
    padding: 18px clamp(16px, 3vw, 48px); text-align: center;
}
.lp-trust-strip-inner {
    display: flex; align-items: center; justify-content: center; gap: 6px; flex-wrap: wrap;
    font-size: 14px; color: var(--lp-ink); font-weight: 500; max-width: var(--lp-max); width: 100%; margin: 0 auto;
}
.lp-flag-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; margin: 0 2px; }
.lp-trust-divider { color: rgba(45,27,105,0.3); margin: 0 8px; }

/* ─── Bento Grid ─── */
.lp-bento { padding: 104px clamp(16px, 4vw, 64px); background: var(--lp-white); }
.lp-bento-header { text-align: center; max-width: 700px; margin: 0 auto 64px; }
.lp-bento-eyebrow { font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--lp-purple); margin-bottom: 16px; }
.lp-bento-title { font-size: clamp(30px, 4.5vw, 48px); font-weight: 800; letter-spacing: -0.035em; color: var(--lp-ink); line-height: 1.12; margin-bottom: 16px; }
.lp-bento-sub { font-size: 17px; line-height: 1.6; color: #5B3A9E; margin: 0; }
.lp-bento-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; max-width: var(--lp-max); width: 100%; margin: 0 auto; }
.lp-bento-card { position: relative; border-radius: 22px; padding: 36px; overflow: hidden; transition: transform 0.3s ease, box-shadow 0.3s ease; cursor: default; }
.lp-bento-card::before {
    content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 100%;
    background: linear-gradient(105deg, transparent 40%, rgba(255,255,255,0.05) 45%, rgba(255,255,255,0.1) 50%, rgba(255,255,255,0.05) 55%, transparent 60%);
    transform: translateX(-100%); pointer-events: none;
}
.lp-bento-card:hover::before { animation: lpCardShine 0.6s ease-out; }
.lp-bento-card:hover { transform: translateY(-6px); }
.lp-bento-card-light { background: var(--lp-surface); border: 1px solid var(--lp-surface-strong); }
.lp-bento-card-light:hover { box-shadow: 0 16px 48px rgba(123,47,190,0.1); }
.lp-bento-card-dark { background: var(--lp-ink); border: 1px solid rgba(123,47,190,0.3); color: #fff; }
.lp-bento-card-dark:hover { box-shadow: 0 16px 48px rgba(45,27,105,0.3); }
.lp-bento-card-accent { background: linear-gradient(135deg, var(--lp-purple), var(--lp-purple-mid)); border: none; color: #fff; }
.lp-bento-card-accent:hover { box-shadow: 0 16px 48px rgba(123,47,190,0.3); }
.lp-bento-icon { display: flex; align-items: center; justify-content: center; width: 52px; height: 52px; border-radius: 16px; margin-bottom: 22px; }
.lp-bento-icon-light { background: rgba(123,47,190,0.08); color: var(--lp-purple); }
.lp-bento-icon-dark { background: rgba(255,255,255,0.1); color: rgba(255,255,255,0.9); }
.lp-bento-icon-accent { background: rgba(255,255,255,0.2); color: #fff; }
.lp-bento-card h3 { font-size: 19px; font-weight: 700; margin-bottom: 10px; letter-spacing: -0.02em; line-height: 1.3; }
.lp-bento-card p { font-size: 15px; line-height: 1.65; margin: 0; }
.lp-bento-card-light p { color: #5B3A9E; }
.lp-bento-card-light h3 { color: var(--lp-ink); }
.lp-bento-card-dark p, .lp-bento-card-accent p { color: rgba(255,255,255,0.7); }
.lp-bento-card-dark h3, .lp-bento-card-accent h3 { color: #fff; }
.lp-bento-tag { display: inline-block; font-size: 11px; font-weight: 600; letter-spacing: 0.04em; padding: 4px 12px; border-radius: 7px; margin-top: 16px; margin-right: 6px; }
.lp-bento-tag-light { background: rgba(123,47,190,0.08); color: var(--lp-purple); }
.lp-bento-tag-dark { background: rgba(255,255,255,0.1); color: rgba(255,255,255,0.8); }
.lp-bento-span-2 { grid-column: span 2; }

/* ─── Metrics ─── */
.lp-metrics { background: var(--lp-dark); padding: 96px clamp(16px, 4vw, 64px); position: relative; overflow: hidden; }
.lp-metrics::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse at 50% 0%, rgba(123,47,190,0.18), transparent 70%); pointer-events: none; }
.lp-metrics::after { content: ''; position: absolute; width: 500px; height: 500px; bottom: -200px; left: 10%; background: radial-gradient(circle, rgba(232,93,117,0.08), transparent 70%); border-radius: 50%; filter: blur(80px); pointer-events: none; }
.lp-metrics-inner { max-width: var(--lp-max); width: 100%; margin: 0 auto; text-align: center; position: relative; z-index: 1; }
.lp-metrics-eyebrow { font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--lp-lavender); margin-bottom: 8px; }
.lp-metrics-title { font-size: clamp(26px, 4vw, 44px); font-weight: 800; color: #fff; letter-spacing: -0.035em; margin-bottom: 56px; }
.lp-metrics-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 40px; }
.lp-metric-item { text-align: center; padding: 32px 16px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06); border-radius: 20px; backdrop-filter: blur(8px); transition: all 0.3s ease; }
.lp-metric-item:hover { background: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.1); transform: translateY(-4px); }
.lp-metric-number {
    font-size: clamp(40px, 5.5vw, 64px); font-weight: 800; letter-spacing: -0.04em;
    background: linear-gradient(135deg, #fff, var(--lp-lavender));
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
    animation: lpCounterPulse 3s ease-in-out infinite; line-height: 1.1; margin-bottom: 12px;
}
.lp-metric-label { font-size: 15px; color: rgba(255,255,255,0.5); font-weight: 500; }

/* ─── Workflow ─── */
.lp-workflow { padding: 104px clamp(16px, 4vw, 64px); background: var(--lp-white); }
.lp-workflow-header { text-align: center; max-width: 700px; margin: 0 auto 72px; }
.lp-workflow-steps { display: flex; align-items: flex-start; justify-content: center; max-width: var(--lp-max); width: 100%; margin: 0 auto; position: relative; }
.lp-workflow-step { display: flex; flex-direction: column; align-items: center; text-align: center; flex: 1; position: relative; padding: 0 20px; }
.lp-workflow-step::after {
    content: ''; position: absolute; top: 32px; right: -20px; width: 40px; height: 2px;
    background: linear-gradient(90deg, var(--lp-purple), rgba(123,47,190,0.2)); opacity: 0.3;
}
.lp-workflow-step:last-child::after { display: none; }
.lp-workflow-icon-ring {
    width: 64px; height: 64px; border-radius: 50%; border: 2px solid rgba(123,47,190,0.2);
    display: flex; align-items: center; justify-content: center; margin-bottom: 24px;
    background: var(--lp-surface); transition: all 0.3s ease;
}
.lp-workflow-step:hover .lp-workflow-icon-ring { border-color: var(--lp-purple); animation: lpStepPulse 1.5s ease-in-out infinite; background: rgba(123,47,190,0.06); }
.lp-workflow-icon-ring span { font-size: 26px; color: var(--lp-purple); }
.lp-workflow-num { font-size: 11px; font-weight: 700; letter-spacing: 0.08em; color: var(--lp-lavender); margin-bottom: 10px; }
.lp-workflow-step h3 { font-size: 17px; font-weight: 700; color: var(--lp-ink); margin-bottom: 10px; letter-spacing: -0.02em; }
.lp-workflow-step p { font-size: 14px; line-height: 1.6; color: #7C6BAA; margin: 0; max-width: 240px; }

/* ─── Testimonials ─── */
.lp-testimonials { padding: 104px clamp(16px, 4vw, 64px); background: var(--lp-dark-2); position: relative; overflow: hidden; }
.lp-testimonials::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse at 30% 50%, rgba(123,47,190,0.12), transparent 60%); pointer-events: none; }
.lp-testimonials::after { content: ''; position: absolute; width: 400px; height: 400px; top: -100px; right: -100px; background: radial-gradient(circle, rgba(232,93,117,0.08), transparent 70%); border-radius: 50%; filter: blur(60px); pointer-events: none; }
.lp-testimonials-inner { max-width: var(--lp-max); width: 100%; margin: 0 auto; position: relative; text-align: center; z-index: 1; }
.lp-testimonials-eyebrow { font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--lp-lavender); margin-bottom: 8px; }
.lp-testimonials-title { font-size: clamp(26px, 4vw, 44px); font-weight: 800; color: #fff; letter-spacing: -0.035em; margin-bottom: 56px; }
.lp-testimonial-cards { display: grid; grid-template-columns: repeat(2, 1fr); gap: 28px; }
.lp-testimonial-card {
    background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08);
    border-radius: 22px; padding: 40px; backdrop-filter: blur(16px); text-align: left; transition: all 0.3s ease;
}
.lp-testimonial-card:hover { background: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.14); transform: translateY(-4px); }
.lp-testimonial-quote { font-size: 16px; line-height: 1.75; color: rgba(255,255,255,0.75); margin-bottom: 28px; position: relative; padding-left: 24px; font-style: italic; }
.lp-testimonial-quote::before { content: '\201C'; position: absolute; left: -4px; top: -10px; font-size: 52px; color: var(--lp-lavender); font-style: normal; opacity: 0.4; line-height: 1; }
.lp-testimonial-author { display: flex; align-items: center; gap: 14px; }
.lp-testimonial-avatar {
    width: 44px; height: 44px; border-radius: 50%;
    background: linear-gradient(135deg, var(--lp-purple), var(--lp-pink));
    display: flex; align-items: center; justify-content: center;
    font-size: 16px; font-weight: 700; color: #fff; flex-shrink: 0;
}
.lp-testimonial-name { font-size: 15px; font-weight: 600; color: #fff; }
.lp-testimonial-role { font-size: 13px; color: rgba(255,255,255,0.4); }

/* ─── Download ─── */
.lp-download { padding: 104px clamp(16px, 4vw, 64px); background: linear-gradient(180deg, var(--lp-ink) 0%, #1A0D42 100%); position: relative; overflow: hidden; }
.lp-download::before { content: ''; position: absolute; width: 700px; height: 700px; top: -300px; right: -200px; background: radial-gradient(circle, rgba(123,47,190,0.22), transparent 70%); border-radius: 50%; filter: blur(80px); pointer-events: none; }
.lp-download::after { content: ''; position: absolute; width: 500px; height: 500px; bottom: -200px; left: -100px; background: radial-gradient(circle, rgba(232,93,117,0.1), transparent 70%); border-radius: 50%; filter: blur(80px); pointer-events: none; }
.lp-download-inner { max-width: var(--lp-max); width: 100%; margin: 0 auto; text-align: center; position: relative; z-index: 1; }
.lp-download-eyebrow { font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--lp-lavender); margin-bottom: 8px; }
.lp-download-title { font-size: clamp(26px, 4vw, 44px); font-weight: 800; color: #fff; letter-spacing: -0.035em; margin-bottom: 12px; }
.lp-download-sub { font-size: 16px; color: rgba(255,255,255,0.5); margin-bottom: 48px; }
.lp-download-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; max-width: 1200px; margin: 0 auto 40px; }
.lp-dl-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 22px; padding: 40px 28px; backdrop-filter: blur(16px); transition: all 0.3s ease; }
.lp-dl-card:hover { background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.18); transform: translateY(-4px); }
.lp-dl-icon { width: 60px; height: 60px; border-radius: 18px; background: rgba(255,255,255,0.08); display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; }
.lp-dl-icon span { font-size: 30px; color: #fff; }
.lp-dl-card h3 { font-size: 20px; font-weight: 700; color: #fff; margin-bottom: 10px; }
.lp-dl-card p { font-size: 13px; line-height: 1.5; color: rgba(255,255,255,0.5); margin-bottom: 24px; }
.lp-dl-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px; width: 100%; padding: 14px 24px;
    background: linear-gradient(135deg, rgba(255,255,255,0.1), rgba(255,255,255,0.05));
    border: 1px solid rgba(255,255,255,0.15); border-radius: 12px; color: #fff; font-size: 15px; font-weight: 600;
    text-decoration: none; transition: all 0.2s ease;
}
.lp-dl-btn:hover { background: linear-gradient(135deg, rgba(255,255,255,0.16), rgba(255,255,255,0.08)); border-color: rgba(255,255,255,0.25); transform: translateY(-1px); }
.lp-dl-meta { font-size: 11px; color: rgba(255,255,255,0.35); margin-top: 14px; }
.lp-dl-note { font-size: 11px; color: rgba(255,255,255,0.25); margin-top: 4px; }
.lp-dl-pwa { max-width: 700px; margin: 0 auto; padding: 24px 28px; background: rgba(255,255,255,0.03); border-radius: 16px; border: 1px solid rgba(255,255,255,0.06); display: flex; align-items: flex-start; gap: 18px; text-align: left; }
.lp-dl-pwa-icon { width: 40px; height: 40px; flex-shrink: 0; border-radius: 12px; background: rgba(255,255,255,0.06); display: flex; align-items: center; justify-content: center; }
.lp-dl-pwa-icon span { font-size: 22px; color: rgba(255,255,255,0.7); }
.lp-dl-pwa h4 { font-size: 15px; font-weight: 700; color: #fff; margin-bottom: 6px; }
.lp-dl-pwa p { font-size: 13px; line-height: 1.6; color: rgba(255,255,255,0.5); margin: 0; }
.lp-dl-pwa a { color: var(--lp-lavender); text-decoration: underline; }

/* ─── Docker Card ─── */
.lp-docker-cmd {
    background: rgba(0,0,0,0.35); border: 1px solid rgba(255,255,255,0.08); border-radius: 10px;
    padding: 12px 16px; margin-bottom: 16px; text-align: left; font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 12px; color: rgba(255,255,255,0.75); line-height: 1.7; overflow-x: auto;
}
.lp-docker-cmd .lp-cmd-comment { color: rgba(255,255,255,0.3); }
.lp-docker-cmd .lp-cmd-prompt { color: var(--lp-green); }
.lp-docker-cmd .lp-cmd-flag { color: var(--lp-lavender); }
.lp-docker-badge {
    display: inline-flex; align-items: center; gap: 6px; margin-top: 14px;
    padding: 5px 12px; border-radius: 100px; font-size: 11px; font-weight: 600;
    background: linear-gradient(135deg, rgba(0,120,215,0.15), rgba(0,120,215,0.08));
    border: 1px solid rgba(0,120,215,0.25); color: rgba(100,180,255,0.9);
}

/* ═══════════════════════════════════════════════════════════════
   DOCKER DEPLOY SECTION — Premium Terminal + Deployment Guide
   ═══════════════════════════════════════════════════════════════ */
.lp-deploy { padding: 104px clamp(16px, 4vw, 64px); background: linear-gradient(180deg, #1A0D42 0%, #0E0620 50%, #1A0D42 100%); position: relative; overflow: hidden; }
.lp-deploy::before { content: ''; position: absolute; width: 800px; height: 800px; top: -200px; left: -300px; background: radial-gradient(circle, rgba(0,120,215,0.12), transparent 70%); border-radius: 50%; filter: blur(100px); pointer-events: none; }
.lp-deploy::after { content: ''; position: absolute; width: 600px; height: 600px; bottom: -200px; right: -200px; background: radial-gradient(circle, rgba(123,47,190,0.15), transparent 70%); border-radius: 50%; filter: blur(80px); pointer-events: none; }
.lp-deploy-inner { max-width: var(--lp-max); width: 100%; margin: 0 auto; position: relative; z-index: 1; }
.lp-deploy-eyebrow { font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(0,180,255,0.85); margin-bottom: 8px; text-align: center; }
.lp-deploy-title { font-size: clamp(26px, 4vw, 44px); font-weight: 800; color: #fff; letter-spacing: -0.035em; margin-bottom: 12px; text-align: center; }
.lp-deploy-sub { font-size: 16px; color: rgba(255,255,255,0.5); margin-bottom: 48px; text-align: center; max-width: 680px; margin-left: auto; margin-right: auto; }

/* Terminal mockup */
.lp-terminal { background: rgba(0,0,0,0.55); border: 1px solid rgba(255,255,255,0.08); border-radius: 16px; overflow: hidden; max-width: 760px; margin: 0 auto 48px; box-shadow: 0 20px 60px rgba(0,0,0,0.4), 0 0 0 1px rgba(255,255,255,0.04); }
.lp-terminal-bar { display: flex; align-items: center; gap: 8px; padding: 14px 20px; background: rgba(255,255,255,0.04); border-bottom: 1px solid rgba(255,255,255,0.06); }
.lp-terminal-dot { width: 12px; height: 12px; border-radius: 50%; }
.lp-terminal-dot:nth-child(1) { background: #ff5f57; }
.lp-terminal-dot:nth-child(2) { background: #febc2e; }
.lp-terminal-dot:nth-child(3) { background: #28c840; }
.lp-terminal-title { font-size: 12px; color: rgba(255,255,255,0.4); margin-left: 8px; font-family: 'JetBrains Mono', 'Fira Code', monospace; }
.lp-terminal-body { padding: 20px 24px; font-family: 'JetBrains Mono', 'Fira Code', monospace; font-size: 13px; line-height: 1.8; color: rgba(255,255,255,0.75); overflow-x: auto; }
.lp-terminal-body .lp-cmd-comment { color: rgba(255,255,255,0.25); }
.lp-terminal-body .lp-cmd-prompt { color: var(--lp-green); font-weight: 600; }
.lp-terminal-body .lp-cmd-flag { color: var(--lp-lavender); }
.lp-terminal-body .lp-cmd-string { color: #f0c674; }
.lp-terminal-body .lp-cmd-output { color: rgba(255,255,255,0.35); font-style: italic; }

/* Deploy feature grid */
.lp-deploy-features { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; max-width: 1100px; margin: 0 auto 48px; }
.lp-deploy-feat { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 18px; padding: 28px 24px; text-align: left; transition: all 0.3s ease; position: relative; overflow: hidden; }
.lp-deploy-feat::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: linear-gradient(90deg, rgba(0,120,215,0.5), rgba(123,47,190,0.5)); opacity: 0; transition: opacity 0.3s ease; }
.lp-deploy-feat:hover { background: rgba(255,255,255,0.07); border-color: rgba(255,255,255,0.15); transform: translateY(-3px); }
.lp-deploy-feat:hover::before { opacity: 1; }
.lp-deploy-feat-icon { width: 44px; height: 44px; border-radius: 14px; background: linear-gradient(135deg, rgba(0,120,215,0.15), rgba(123,47,190,0.1)); display: flex; align-items: center; justify-content: center; margin-bottom: 16px; }
.lp-deploy-feat-icon span { font-size: 22px; color: rgba(100,180,255,0.9); }
.lp-deploy-feat h4 { font-size: 16px; font-weight: 700; color: #fff; margin-bottom: 8px; }
.lp-deploy-feat p { font-size: 13px; line-height: 1.55; color: rgba(255,255,255,0.45); margin: 0; }

/* Arch badges row */
.lp-deploy-badges { display: flex; align-items: center; justify-content: center; gap: 12px; flex-wrap: wrap; margin-bottom: 48px; }
.lp-deploy-badge { display: inline-flex; align-items: center; gap: 7px; padding: 8px 16px; border-radius: 100px; font-size: 12px; font-weight: 600; border: 1px solid; }
.lp-deploy-badge--docker { background: linear-gradient(135deg, rgba(0,120,215,0.18), rgba(0,120,215,0.08)); border-color: rgba(0,120,215,0.3); color: rgba(100,180,255,0.9); }
.lp-deploy-badge--arch { background: rgba(255,255,255,0.05); border-color: rgba(255,255,255,0.12); color: rgba(255,255,255,0.6); }
.lp-deploy-badge--dotnet { background: linear-gradient(135deg, rgba(123,47,190,0.18), rgba(123,47,190,0.08)); border-color: rgba(123,47,190,0.3); color: rgba(167,139,250,0.9); }

/* Env vars mini-table */
.lp-deploy-env { max-width: 760px; margin: 0 auto; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.06); border-radius: 14px; overflow: hidden; }
.lp-deploy-env-header { display: grid; grid-template-columns: 2fr 3fr; padding: 14px 20px; background: rgba(255,255,255,0.04); border-bottom: 1px solid rgba(255,255,255,0.06); font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: rgba(255,255,255,0.35); }
.lp-deploy-env-row { display: grid; grid-template-columns: 2fr 3fr; padding: 10px 20px; border-bottom: 1px solid rgba(255,255,255,0.03); font-size: 12px; transition: background 0.15s ease; }
.lp-deploy-env-row:last-child { border-bottom: none; }
.lp-deploy-env-row:hover { background: rgba(255,255,255,0.03); }
.lp-deploy-env-key { font-family: 'JetBrains Mono', 'Fira Code', monospace; color: rgba(100,180,255,0.8); }
.lp-deploy-env-val { color: rgba(255,255,255,0.4); padding-left: 12px; }

/* ─── CTA ─── */
.lp-cta { padding: 104px clamp(16px, 4vw, 64px); background: linear-gradient(135deg, var(--lp-purple) 0%, var(--lp-purple-deep) 50%, #1A0D42 100%); position: relative; overflow: hidden; text-align: center; }
.lp-cta::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse at 50% 100%, rgba(167,139,250,0.18), transparent 60%); pointer-events: none; }
.lp-cta::after { content: ''; position: absolute; width: 600px; height: 600px; top: -200px; left: -150px; background: radial-gradient(circle, rgba(232,93,117,0.1), transparent 70%); border-radius: 50%; filter: blur(80px); pointer-events: none; }
.lp-cta-inner { max-width: 800px; margin: 0 auto; position: relative; z-index: 1; }
.lp-cta-title { font-size: clamp(30px, 5vw, 52px); font-weight: 800; color: #fff; letter-spacing: -0.035em; line-height: 1.12; margin-bottom: 20px; }
.lp-cta-sub { font-size: 17px; line-height: 1.65; color: rgba(255,255,255,0.65); margin-bottom: 40px; }
.lp-cta-btn {
    display: inline-flex; align-items: center; gap: 8px; font-size: 17px; font-weight: 700;
    color: var(--lp-purple); background: #fff; padding: 18px 44px; border-radius: 14px;
    text-decoration: none; transition: all 0.25s ease; box-shadow: 0 8px 32px rgba(0,0,0,0.15);
}
.lp-cta-btn:hover { transform: translateY(-2px); box-shadow: 0 16px 48px rgba(0,0,0,0.25); }
.lp-cta-creds { margin-top: 28px; font-size: 14px; color: rgba(255,255,255,0.45); }
.lp-cta-creds code { font-family: 'JetBrains Mono', monospace; font-size: 13px; color: var(--lp-lavender); background: rgba(255,255,255,0.08); padding: 3px 10px; border-radius: 5px; font-weight: 600; }

/* ─── Footer ─── */
.lp-footer { background: var(--lp-dark); padding: 56px clamp(16px, 4vw, 64px) 32px; border-top: 1px solid rgba(255,255,255,0.06); }
.lp-footer-inner { max-width: var(--lp-max); width: 100%; margin: 0 auto; }
.lp-footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 64px; margin-bottom: 48px; }
.lp-footer-brand { display: flex; align-items: center; gap: 10px; margin-bottom: 18px; }
.lp-footer-brand img { height: 28px; }
.lp-footer-brand span { font-size: 15px; font-weight: 800; color: #fff; letter-spacing: 0.02em; }
.lp-footer p { font-size: 14px; line-height: 1.65; color: rgba(255,255,255,0.45); margin: 0 0 12px; }
.lp-footer h4 { font-size: 12px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: rgba(255,255,255,0.6); margin-bottom: 18px; }
.lp-footer ul { list-style: none; padding: 0; margin: 0; }
.lp-footer li { margin-bottom: 12px; }
.lp-footer a { font-size: 14px; color: rgba(255,255,255,0.45); text-decoration: none; transition: color 0.2s ease; }
.lp-footer a:hover { color: rgba(255,255,255,0.9); }
.lp-footer-bottom { display: flex; align-items: center; justify-content: space-between; padding-top: 28px; border-top: 1px solid rgba(255,255,255,0.06); font-size: 13px; color: rgba(255,255,255,0.3); }
.lp-footer-status { display: inline-flex; align-items: center; gap: 6px; }
.lp-footer-status-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--lp-green); animation: lpStatusPulse 2s ease-in-out infinite; }

/* ─── Responsive ─── */
@@media (max-width: 900px) {
    .lp-bento-grid { grid-template-columns: repeat(2, 1fr); }
    .lp-bento-span-2 { grid-column: span 2; }
    .lp-metrics-grid { grid-template-columns: repeat(2, 1fr); gap: 20px; }
    .lp-testimonial-cards { grid-template-columns: 1fr; }
    .lp-download-cards { grid-template-columns: 1fr; max-width: 400px; }
    .lp-footer-grid { grid-template-columns: 1fr; gap: 32px; }
    .lp-workflow-steps { flex-direction: column; align-items: center; gap: 32px; }
    .lp-workflow-step::after { display: none; }
    .lp-nav { display: none; }
    .lp-deploy-features { grid-template-columns: 1fr; max-width: 400px; }
}
@@media (max-width: 600px) {
    .lp-bento-grid { grid-template-columns: 1fr; }
    .lp-bento-span-2 { grid-column: span 1; }
    .lp-metrics-grid { grid-template-columns: repeat(2, 1fr); }
    .lp-hero-h1 { font-size: 36px; }
    .lp-hero-badges { flex-direction: column; align-items: center; }
    .lp-status-text { display: none; }
    .lp-footer-bottom { flex-direction: column; gap: 8px; text-align: center; }
    .lp-hero-preview { max-width: 95%; }
    .lp-preview-sidebar { display: none; }
    .lp-preview-main { border-radius: 0; }
}

/* ─── Dashboard Preview (Hero) ─── */
.lp-hero-preview {
    position: relative; z-index: 2;
    max-width: 1100px; width: 100%; margin: 0 auto;
    perspective: 1200px;
}
.lp-preview-window {
    background: rgba(14,6,32,0.88); border: 1px solid rgba(123,47,190,0.25);
    border-radius: 18px; overflow: hidden; backdrop-filter: blur(24px);
    box-shadow: 0 40px 100px rgba(0,0,0,0.5), 0 0 0 1px rgba(123,47,190,0.12), inset 0 1px 0 rgba(255,255,255,0.05);
    transform: rotateX(2deg); transition: transform 0.4s ease;
}
.lp-preview-window:hover { transform: rotateX(0deg) scale(1.01); }
.lp-preview-titlebar {
    display: flex; align-items: center; gap: 12px;
    padding: 14px 18px; border-bottom: 1px solid rgba(255,255,255,0.06);
}
.lp-preview-dots { display: flex; gap: 7px; }
.lp-preview-dots span { width: 11px; height: 11px; border-radius: 50%; }
.lp-preview-title { font-size: 13px; color: rgba(255,255,255,0.4); font-weight: 500; letter-spacing: 0.02em; }
.lp-preview-body { display: flex; min-height: 260px; }
.lp-preview-sidebar {
    width: 200px; padding: 14px 0; border-right: 1px solid rgba(255,255,255,0.06);
    display: flex; flex-direction: column; gap: 2px;
}
.lp-preview-sb-item {
    display: flex; align-items: center; gap: 10px; padding: 10px 18px;
    font-size: 13px; color: rgba(255,255,255,0.45); cursor: default;
}
.lp-preview-sb-item.active { color: #fff; background: rgba(123,47,190,0.15); border-right: 2px solid #7B2FBE; }
.lp-preview-main { flex: 1; padding: 18px; display: flex; flex-direction: column; gap: 18px; }
.lp-preview-kpi-row { display: grid; grid-template-columns: repeat(4,1fr); gap: 12px; }
.lp-preview-kpi {
    background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.06);
    border-radius: 12px; padding: 14px; text-align: center;
}
.lp-preview-kpi.accent { background: linear-gradient(135deg, rgba(123,47,190,0.2), rgba(123,47,190,0.08)); border-color: rgba(123,47,190,0.2); }
.lp-preview-kpi-label { font-size: 10px; color: rgba(255,255,255,0.4); text-transform: uppercase; letter-spacing: 0.06em; font-weight: 600; }
.lp-preview-kpi-value { font-size: 26px; font-weight: 800; color: #fff; margin: 4px 0 2px; }
.lp-preview-kpi-delta { font-size: 11px; font-weight: 600; }
.lp-preview-kpi-delta.up { color: #14a37f; }
.lp-preview-kpi-delta.warn { color: #d89c11; }
.lp-preview-chart { flex: 1; display: flex; align-items: flex-end; gap: 10px; padding-top: 10px; border-top: 1px solid rgba(255,255,255,0.06); }
.lp-preview-bar { flex: 1; border-radius: 5px 5px 0 0; min-height: 20px; transition: height 0.3s ease; opacity: 0.8; }
.lp-preview-bar:hover { opacity: 1; }

/* ─── Premium section primitives (shared) ─── */
.lp-section-eyebrow {
    font-size: 13px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--lp-eyebrow); margin: 0 0 16px;
}
.lp-section-eyebrow--light { color: var(--lp-lavender); }
.lp-section-title {
    font-family: 'Plus Jakarta Sans', 'Inter', sans-serif; font-size: clamp(28px, 4vw, 48px);
    font-weight: 800; line-height: 1.1; letter-spacing: -0.025em;
    color: var(--lp-text); margin: 0 0 16px;
}
.lp-section-title--light { color: #FCFBFF; }
.lp-section-sub {
    font-size: 17px; line-height: 1.5; color: var(--lp-text-2); max-width: 720px; margin: 0 auto 56px;
}
.lp-section-sub--light { color: rgba(255,255,255,0.7); }

/* ─── 7a. Stats counters ─── */
.lp-stats { background: var(--lp-bg); padding: 120px clamp(16px, 5vw, 80px); }
.lp-stats-inner { max-width: var(--lp-max); margin: 0 auto; text-align: center; }
.lp-stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; margin-top: 56px; }
.lp-stat-card {
    padding: 40px 24px; border-radius: 16px;
    background: var(--lp-card-bg); border: 1px solid var(--lp-card-border);
    box-shadow: var(--lp-card-shadow);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    opacity: 0; transform: translateY(20px);
}
.lp-stat-card.lp-visible { opacity: 1; transform: translateY(0); }
.lp-stat-card:hover { transform: translateY(-4px); box-shadow: 0 12px 32px rgba(37, 22, 63, 0.08); }
.lp-stat-value {
    font-family: 'JetBrains Mono', monospace;
    font-size: 56px; font-weight: 800; color: var(--lp-text); line-height: 1;
    letter-spacing: -0.04em; font-variant-numeric: tabular-nums;
    display: flex; align-items: baseline; justify-content: center; gap: 4px;
}
.lp-stat-suffix { font-size: 22px; font-weight: 600; color: var(--lp-purple); }
.lp-stat-label { font-size: 14px; font-weight: 700; color: var(--lp-text-2); margin-top: 14px; letter-spacing: 0.04em; }
.lp-stat-sub { font-size: 12px; color: var(--lp-text-3); margin-top: 4px; }

/* ─── 7b. Before / after slider ─── */
.lp-compare { background: var(--lp-dark); padding: 120px clamp(16px, 5vw, 80px); }
.lp-compare-inner { max-width: var(--lp-max); margin: 0 auto; text-align: center; }
.lp-compare-slider {
    position: relative; max-width: 1100px; margin: 56px auto 0;
    aspect-ratio: 16 / 9; border-radius: 24px; overflow: hidden;
    box-shadow: 0 32px 80px rgba(13, 7, 30, 0.45);
    cursor: ew-resize; user-select: none;
}
.lp-compare-before, .lp-compare-after {
    position: absolute; inset: 0;
    padding: 48px 56px; display: flex; flex-direction: column; justify-content: center;
}
.lp-compare-after {
    background: linear-gradient(135deg, #0F0A1F 0%, #1F1834 50%, #25163F 100%);
}
.lp-compare-before {
    background: linear-gradient(135deg, #2A1018 0%, #3D1626 50%, #4A1F2C 100%);
    width: 50%; overflow: hidden;
}
.lp-compare-pane-label {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 8px 14px; border-radius: 999px;
    background: rgba(225, 29, 72, 0.15); border: 1px solid rgba(225, 29, 72, 0.4);
    font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
    color: #FFFFFF; align-self: flex-start; margin-bottom: 28px;
}
.lp-compare-pane-label--green {
    background: rgba(20, 163, 127, 0.15); border-color: rgba(20, 163, 127, 0.4);
}
.lp-compare-list { list-style: none; padding: 0; margin: 0; text-align: left; }
.lp-compare-list li {
    display: flex; align-items: center; gap: 14px;
    padding: 12px 0; font-size: 17px; color: rgba(255,255,255,0.92);
    border-bottom: 1px solid rgba(255,255,255,0.06);
}
.lp-compare-list li:last-child { border-bottom: none; }
.lp-compare-list .material-icons-round { color: #E11D48; font-size: 22px; }
.lp-compare-after .lp-compare-list .material-icons-round { color: #14A37F; }
.lp-compare-handle {
    position: absolute; top: 0; bottom: 0; left: 50%;
    width: 4px; background: linear-gradient(180deg, #7B2FBE 0%, #A78BFA 100%);
    transform: translateX(-50%); z-index: 10;
    box-shadow: 0 0 24px rgba(167, 139, 250, 0.6);
}
.lp-compare-handle-line { position: absolute; inset: 0; }
.lp-compare-handle-knob {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    width: 48px; height: 48px; border-radius: 50%;
    background: linear-gradient(135deg, #7B2FBE 0%, #A78BFA 100%);
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 8px 24px rgba(0,0,0,0.3);
    color: #FFFFFF;
}
.lp-compare-handle-knob .material-icons-round { font-size: 16px; }

/* ─── 7c. Pricing ─── */
.lp-pricing { background: var(--lp-bg); padding: 120px clamp(16px, 5vw, 80px); }
.lp-pricing-inner { max-width: var(--lp-max); margin: 0 auto; text-align: center; }
.lp-pricing-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 56px;
    align-items: stretch;
}
.lp-pricing-card {
    position: relative; padding: 40px 32px;
    background: var(--lp-card-bg); border: 1px solid var(--lp-card-border); border-radius: 20px;
    display: flex; flex-direction: column; gap: 20px;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}
.lp-pricing-card:hover { transform: translateY(-4px); box-shadow: 0 16px 40px rgba(37, 22, 63, 0.08); }
.lp-pricing-card--featured {
    background: linear-gradient(180deg, #25163F 0%, #4A3C68 100%);
    border-color: #7B2FBE; color: #FCFBFF;
    transform: scale(1.04); box-shadow: 0 24px 64px rgba(37, 22, 63, 0.18);
}
.lp-pricing-card--featured:hover { transform: scale(1.04) translateY(-4px); }
.lp-pricing-badge {
    position: absolute; top: -12px; left: 50%; transform: translateX(-50%);
    padding: 6px 14px; border-radius: 999px;
    background: linear-gradient(135deg, #7B2FBE 0%, #A78BFA 100%);
    color: #FFFFFF; font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
    box-shadow: 0 4px 12px rgba(123, 47, 190, 0.4);
}
.lp-pricing-name { font-size: 18px; font-weight: 700; color: var(--lp-text); letter-spacing: 0.02em; }
.lp-pricing-card--featured .lp-pricing-name { color: #FFFFFF; }
.lp-pricing-price { display: flex; align-items: baseline; gap: 8px; margin-top: 4px; }
.lp-pricing-amount {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 48px; font-weight: 800; color: var(--lp-text); letter-spacing: -0.03em; line-height: 1;
}
.lp-pricing-card--featured .lp-pricing-amount { color: #FFFFFF; }
.lp-pricing-period { font-size: 14px; color: var(--lp-text-3); font-weight: 500; }
.lp-pricing-card--featured .lp-pricing-period { color: rgba(255,255,255,0.6); }
.lp-pricing-features { list-style: none; padding: 0; margin: 16px 0 0; text-align: left; flex: 1; }
.lp-pricing-features li {
    display: flex; align-items: center; gap: 12px;
    padding: 10px 0; font-size: 14px; color: var(--lp-text-2);
    border-bottom: 1px solid var(--lp-card-border);
}
.lp-pricing-card--featured .lp-pricing-features li { color: rgba(255,255,255,0.85); border-color: rgba(255,255,255,0.08); }
.lp-pricing-features .material-icons-round { color: #14A37F; font-size: 18px; }
.lp-pricing-card--featured .lp-pricing-features .material-icons-round { color: #A78BFA; }
.lp-pricing-cta {
    display: inline-block; padding: 14px 28px; border-radius: 12px;
    text-decoration: none; font-weight: 600; font-size: 15px;
    transition: all 0.2s ease; text-align: center; margin-top: 8px;
}
.lp-pricing-cta--primary {
    background: linear-gradient(135deg, #7B2FBE 0%, #A78BFA 100%); color: #FFFFFF;
    box-shadow: 0 8px 24px rgba(123, 47, 190, 0.3);
}
.lp-pricing-cta--primary:hover { transform: translateY(-2px); box-shadow: 0 12px 32px rgba(123, 47, 190, 0.4); }
.lp-pricing-cta--secondary {
    background: rgba(123, 47, 190, 0.06); color: var(--lp-purple);
    border: 1.5px solid rgba(123, 47, 190, 0.2);
}
.lp-pricing-cta--secondary:hover { background: rgba(123, 47, 190, 0.1); border-color: rgba(123, 47, 190, 0.4); }

/* ─── 7d. FAQ accordion ─── */
.lp-faq { background: var(--lp-bg-2); padding: 120px clamp(16px, 5vw, 80px); }
.lp-faq-inner { max-width: 800px; margin: 0 auto; text-align: center; }
.lp-faq-list { margin-top: 56px; text-align: left; display: flex; flex-direction: column; gap: 12px; }
.lp-faq-item {
    background: var(--lp-card-bg); border: 1px solid var(--lp-card-border); border-radius: 12px;
    overflow: hidden; transition: all 0.2s ease;
}
.lp-faq-item[open] { border-color: #7B2FBE; box-shadow: 0 8px 24px rgba(37, 22, 63, 0.06); }
.lp-faq-item summary {
    padding: 22px 28px; cursor: pointer; font-size: 17px; font-weight: 600;
    color: var(--lp-text); list-style: none;
    display: flex; align-items: center; justify-content: space-between;
}
.lp-faq-item summary::-webkit-details-marker { display: none; }
.lp-faq-item summary::after {
    content: '+'; font-size: 24px; color: #7B2FBE; transition: transform 0.2s; font-weight: 300;
}
.lp-faq-item[open] summary::after { transform: rotate(45deg); }
.lp-faq-answer {
    padding: 0 28px 24px; font-size: 15px; line-height: 1.65; color: var(--lp-text-2);
}
.lp-faq-answer code {
    background: rgba(123, 47, 190, 0.08); padding: 2px 8px; border-radius: 4px;
    font-family: 'JetBrains Mono', monospace; font-size: 13px; color: var(--lp-purple);
}

/* ─── 7e. Founders' note ─── */
.lp-founders {
    background: linear-gradient(180deg, #25163F 0%, #0F0A1F 100%);
    padding: 140px clamp(16px, 5vw, 80px); position: relative; overflow: hidden;
}
.lp-founders::before {
    content: ''; position: absolute; top: 20%; left: 10%;
    width: 600px; height: 600px;
    background: radial-gradient(circle, rgba(123, 47, 190, 0.25) 0%, transparent 60%);
    filter: blur(60px); pointer-events: none;
}
.lp-founders::after {
    content: ''; position: absolute; bottom: 10%; right: 10%;
    width: 500px; height: 500px;
    background: radial-gradient(circle, rgba(167, 139, 250, 0.2) 0%, transparent 60%);
    filter: blur(60px); pointer-events: none;
}
.lp-founders-inner {
    max-width: 800px; margin: 0 auto; text-align: center; position: relative; z-index: 1;
}
.lp-founders-mark {
    font-family: 'Plus Jakarta Sans', serif; font-size: 120px; font-weight: 900;
    color: #7B2FBE; line-height: 0.7; margin-bottom: 24px; opacity: 0.5;
}
.lp-founders-quote {
    font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
    font-size: clamp(20px, 2.6vw, 28px); line-height: 1.5; font-weight: 400;
    color: rgba(255,255,255,0.88); margin: 0 0 40px;
}
.lp-founders-quote strong { color: #A78BFA; font-weight: 700; }
.lp-founders-signature {
    display: inline-flex; align-items: center; gap: 16px;
    padding: 20px 28px; border-radius: 16px;
    background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08);
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
}
.lp-founders-avatar {
    width: 48px; height: 48px; border-radius: 50%;
    background: linear-gradient(135deg, #7B2FBE 0%, #A78BFA 100%);
    color: #FFFFFF; display: flex; align-items: center; justify-content: center;
    font-weight: 800; font-size: 20px;
}
.lp-founders-name { font-size: 16px; font-weight: 700; color: #FFFFFF; }
.lp-founders-role { font-size: 13px; color: rgba(255,255,255,0.55); margin-top: 2px; }

/* ─── Scroll-triggered animations (IntersectionObserver) ─── */
.lp-animate { opacity: 0; transform: translateY(24px); transition: opacity 0.7s cubic-bezier(0.4, 0, 0.2, 1), transform 0.7s cubic-bezier(0.4, 0, 0.2, 1); }
.lp-animate.lp-visible { opacity: 1; transform: translateY(0); }
.lp-animate[data-delay="1"] { transition-delay: 0.1s; }
.lp-animate[data-delay="2"] { transition-delay: 0.2s; }
.lp-animate[data-delay="3"] { transition-delay: 0.3s; }
.lp-animate[data-delay="4"] { transition-delay: 0.4s; }

@@media (prefers-reduced-motion: reduce) {
    .lp-animate, .lp-stat-card, .lp-pricing-card { transition: none !important; opacity: 1 !important; transform: none !important; }
}

/* ─── Build status banner (in the download section) ─── */
.lp-build-status {
