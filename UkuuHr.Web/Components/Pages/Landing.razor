            <div class="lp-deploy-env-row">
                <span class="lp-deploy-env-key">UKUU_ENCRYPTION_KEY</span>
                <span class="lp-deploy-env-val">AES-256-CBC master key for secrets encryption</span>
            </div>
            <div class="lp-deploy-env-row">
                <span class="lp-deploy-env-key">RESEND_API_KEY</span>
