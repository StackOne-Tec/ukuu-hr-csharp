    private string? _latestVersion;
    private string _winFileSize = "calculating\u2026";
    private string _macFileSize = "calculating\u2026";

    protected override void OnInitialized()
    {
        DetectFileSizes();
        DetectVersion();
    }

    private void DetectFileSizes()
    {
        try
        {
            var wwwroot = Path.Combine(AppContext.BaseDirectory, "wwwroot", "downloads");
            var winPath = Path.Combine(wwwroot, "UkuuHr-Windows-x64.exe");
            var macPath = Path.Combine(wwwroot, "UkuuHr-macOS-arm64");

            if (File.Exists(winPath))
            {
                var mb = new FileInfo(winPath).Length / (1024.0 * 1024.0);
                _winFileSize = $"~{mb:F0} MB";
            }
            else
            {
                _winFileSize = "not available";
            }

            if (File.Exists(macPath))
            {
                var mb = new FileInfo(macPath).Length / (1024.0 * 1024.0);
                _macFileSize = $"~{mb:F0} MB";
            }
            else
            {
                _macFileSize = "not available";
            }
        }
        catch
        {
            _winFileSize = "~36 MB";
            _macFileSize = "~35 MB";
        }
    }

    private void DetectVersion()
    {
        try
        {
            var version = System.Reflection.Assembly.GetExecutingAssembly()
                .GetName().Version;
            if (version != null)
            {
                _latestVersion = $"v{version.Major}.{version.Minor}";
            }
        }
        catch
        {
        }
    }

