        </div>

        @* ── Table View ─ *@
        <div class="emp-table-wrap" id="emp-table-view" style="display:none;">
            <table class="emp-table">
                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>Department</th>
                        <th>Job Title</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th>Actions</th>
