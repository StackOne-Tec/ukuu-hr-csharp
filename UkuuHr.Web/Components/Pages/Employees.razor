</div>

<script>
function ukuuFilterEmployees() {
    var search = (document.getElementById('ukuu-emp-search') || {}).value || '';
    var dept = (document.getElementById('ukuu-emp-dept') || {}).value || 'All';
    var status = (document.getElementById('ukuu-emp-status') || {}).value || 'All';
    search = search.toLowerCase().trim();

    var isGrid = document.getElementById('emp-grid-view') && document.getElementById('emp-grid-view').style.display !== 'none';
    var container = isGrid
        ? document.getElementById('emp-grid-view')
        : (document.getElementById('ukuu-emp-tbody'));

    if (!container) return;
    var items = container.querySelectorAll(isGrid ? '.emp-card' : 'tr');
    var visible = 0;

    items.forEach(function(item) {
        var searchData = (item.getAttribute('data-search') || '').toLowerCase();
        var rowDept = item.getAttribute('data-dept') || '';
        var rowStatus = item.getAttribute('data-status') || '';
        var matchSearch = !search || searchData.indexOf(search) >= 0;
        var matchDept = dept === 'All' || rowDept === dept;
        var matchStatus = status === 'All' || rowStatus === status;
        if (matchSearch && matchDept && matchStatus) {
            item.style.display = '';
            visible++;
        } else {
            item.style.display = 'none';
        }
    });

    var emptyGrid = document.getElementById('ukuu-emp-empty-grid');
    var emptyTable = document.getElementById('ukuu-emp-empty-table');
    if (emptyGrid) emptyGrid.style.display = (visible === 0 && isGrid) ? 'block' : 'none';
    if (emptyTable) emptyTable.style.display = (visible === 0 && !isGrid) ? 'block' : 'none';
}

function empToggleView(view) {
    var gridView = document.getElementById('emp-grid-view');
    var tableView = document.getElementById('emp-table-view');
    var btnGrid = document.getElementById('emp-view-grid');
    var btnTable = document.getElementById('emp-view-table');
    if (!gridView || !tableView) return;

    if (view === 'grid') {
        gridView.style.display = '';
        tableView.style.display = 'none';
        btnGrid.classList.add('active');
        btnTable.classList.remove('active');
    } else {
        gridView.style.display = 'none';
        tableView.style.display = '';
        btnGrid.classList.remove('active');
        btnTable.classList.add('active');
    }
    ukuuFilterEmployees();
}

// Employee CSV import
(function() {
    var input = document.getElementById('emp-csv-input');
    if (!input) return;
    input.addEventListener('change', function(e) {
        var file = e.target.files && e.target.files[0];
        if (!file) return;
        if (!file.name.endsWith('.csv')) {
            alert('Please select a .csv file.');
            return;
        }
        var formData = new FormData();
        formData.append('file', file);
        var btn = document.querySelector('[onclick*="emp-csv-input"]');
        if (btn) { btn.disabled = true; btn.textContent = 'Importing...'; }
        fetch('/api/employees/import', { method: 'POST', body: formData })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.error) {
                    alert('Import failed: ' + data.error);
                } else {
                    alert(data.message || ('Imported ' + data.imported + ' employee(s).'));
                    if (data.errors && data.errors.length > 0) {
                        console.warn('Import warnings:', data.errors);
                    }
                    if (data.imported > 0) {
                        window.location.reload();
                    }
                }
            })
            .catch(function(err) {
                alert('Import failed: ' + err.message);
            })
            .finally(function() {
                if (btn) { btn.disabled = false; btn.innerHTML = '<span class="material-icons-round" style="font-size:16px;">upload</span> Import CSV'; }
                input.value = '';
            });
    });
})();
</script>

@code {
    private List<Employee> _employees = new();
    private List<string> _departments = new();
    private bool _loading = true;
    private string? _banner;
    private bool _bannerIsError;

    [SupplyParameterFromQuery] private int? Imported { get; set; }
    [SupplyParameterFromQuery] private int? Skipped { get; set; }
    [SupplyParameterFromQuery] private string? Deleted { get; set; }
    [SupplyParameterFromQuery] private string? Status { get; set; }
    [SupplyParameterFromQuery] private string? Name { get; set; }
    [SupplyParameterFromQuery] private string? Error { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try { await LoadAsync(); }
        catch { /* fall back to empty */ }
    }

    protected override void OnParametersSet()
    {
        // Result banners from the form-post endpoints (import / status / delete).
        if (Imported > 0)
        {
            _banner = $"CSV import complete: {Imported} employee(s) imported" +
                      (Skipped > 0 ? $", {Skipped} skipped." : ".");
            _bannerIsError = false;
        }
        else if (Imported == 0 && Skipped > 0)
        {
            _banner = $"CSV import skipped {Skipped} row(s) — check your file (names + unique employee codes required).";
            _bannerIsError = true;
        }
        else if (!string.IsNullOrWhiteSpace(Deleted))
        {
            _banner = $"Employee '{Deleted}' permanently deleted.";
            _bannerIsError = false;
        }
        else if (!string.IsNullOrWhiteSpace(Status) && !string.IsNullOrWhiteSpace(Name))
        {
            _banner = $"{Name} is now {Status}.";
            _bannerIsError = false;
        }
        else if (!string.IsNullOrWhiteSpace(Error))
        {
            _banner = Uri.UnescapeDataString(Error);
            _bannerIsError = true;
        }
        else _banner = null;
    }

    private async Task LoadAsync()
    {
        _loading = true;
        var org = await Db.ResolveOrgAsync(); /* multi-tenant org resolution */
        if (org != null)
        {
            _employees = await EmployeeSvc.GetAllAsync(org.Id);
            _departments = await EmployeeSvc.GetDepartmentsAsync(org.Id);
        }
        _loading = false;
    }

    private int GetAvatarColorIndex(int id) => id % 4;
}
