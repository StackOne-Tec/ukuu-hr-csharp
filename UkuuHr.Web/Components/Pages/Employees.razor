                                    </a>
                                    <a href="/employees/@emp.Id/edit" class="emp-table-action" title="Edit">
                                        <span class="material-icons-round" style="font-size:16px;">edit</span>
                                    </a>
                                    <form method="post" action="/api/employees/@emp.Id/status" style="display:inline;">
                                        <input type="hidden" name="Status" value="@(emp.Status == EmploymentStatus.Inactive ? "Active" : "Inactive")" />
                                        <button type="submit" style="cursor:pointer;background:none;border:none;padding:4px;display:inline-flex;align-items:center;"
                                                title="@(emp.Status == EmploymentStatus.Inactive ? "Reactivate employee" : "Deactivate employee")">
                                            <span class="material-icons-round" style="font-size:16px;color:var(--bk-ink-3);">@(emp.Status == EmploymentStatus.Inactive ? "play_circle" : "pause_circle")</span>
