        <div id="ukuu-emp-empty-table" style="display:none;padding:24px;">
            <div class="emp-empty">
                <div class="emp-empty-icon"><span class="material-icons-round">person_off</span></div>
                <h3>No employees found</h3>
                <p>Try adjusting your search or filters, or add a new employee.</p>
            </div>
