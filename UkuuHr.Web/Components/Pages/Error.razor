@page "/Error"
@using System.Diagnostics
@inject NavigationManager Nav

<PageTitle>Error</PageTitle>

<div style="max-width:480px;margin:80px auto;text-align:center;padding:0 24px;">
    <span class="material-icons-round" style="font-size:56px;color:#DC2626;">error_outline</span>
    <h2 style="margin-top:16px;color:var(--bk-ink);">Something went wrong</h2>
    <p style="color:var(--bk-ink-3);margin-top:8px;font-size:14px;">
        An unexpected error occurred while processing your request.
        This is usually temporary — try refreshing the page.
    </p>

    @if (ShowRequestId)
    {
        <p style="margin-top:16px;font-size:12px;color:var(--bk-ink-3);">
            <strong>Request ID:</strong> <code style="font-size:11px;">@RequestId</code>
        </p>
    }

    <div style="margin-top:24px;display:flex;gap:12px;justify-content:center;">
        <a href="/dashboard" class="bk-btn bk-btn-primary" style="text-decoration:none;">
            <span class="material-icons-round" style="font-size:16px;">home</span>
            Go to Dashboard
        </a>
        <a href="/landing" class="bk-btn bk-btn-secondary" style="text-decoration:none;">
            <span class="material-icons-round" style="font-size:16px;">refresh</span>
            Start Over
        </a>
    </div>

    <details style="margin-top:32px;text-align:left;font-size:12px;color:var(--bk-ink-3);">
        <summary style="cursor:pointer;color:var(--bk-ink-2);">Technical Details</summary>
        <p style="margin-top:8px;">
            Swapping to <strong>Development</strong> environment will display more detailed information about the error that occurred.
        </p>
        <p>
            Set the <strong>ASPNETCORE_ENVIRONMENT</strong> environment variable to <strong>Development</strong> and restart the app.
        </p>
    </details>
</div>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
