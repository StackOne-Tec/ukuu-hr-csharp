<script>
function ukuuFilterOvertime() {
    var search = (document.getElementById('ukuu-ot-search') || {}).value || '';
    search = search.toLowerCase().trim();

    var isGrid = document.getElementById('ot-grid-view') && document.getElementById('ot-grid-view').style.display !== 'none';
    var container = isGrid
        ? document.getElementById('ot-grid-view')
        : document.getElementById('ukuu-ot-tbody');
    if (!container) return;

    var items = container.querySelectorAll(isGrid ? '.ot-card' : 'tr');
    var visible = 0;
    items.forEach(function(item) {
        var data = (item.getAttribute('data-search') || '').toLowerCase();
        if (!search || data.indexOf(search) >= 0) {
            item.style.display = '';
            visible++;
        } else {
            item.style.display = 'none';
        }
    });
}

function otToggleView(view) {
    var gridView = document.getElementById('ot-grid-view');
    var tableView = document.getElementById('ot-table-view');
    var btnGrid = document.getElementById('ot-view-grid');
    var btnTable = document.getElementById('ot-view-table');
    if (!gridView || !tableView) return;

    if (view === 'grid') {
        gridView.style.display = '';
        tableView.style.display = 'none';
        btnGrid.classList.add('active');
        btnTable.classList.remove('active');
    } else {
        gridView.style.display = 'none';
        tableView.style.display = '';
        btnGrid.classList.remove('active');
        btnTable.classList.add('active');
    }
    ukuuFilterOvertime();
}
</script>

@code {
    private string _tab = "pending";
    private List<OvertimeRecord> _all = new();
    private OvertimeSummary _summary = new();
    private Dictionary<int, Employee> _employeeMap = new();
    private int _orgId;
    private double _totalPay;

    private IEnumerable<OvertimeRecord> _filtered => _tab switch
    {
        "pending" => _all.Where(o => o.Status == OvertimeStatus.Pending),
        "approved" => _all.Where(o => o.Status == OvertimeStatus.Approved || o.Status == OvertimeStatus.AutoApproved),
        _ => _all
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var uri = Nav.ToAbsoluteUri(Nav.Uri);
            var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
            var qTab = query["tab"];
            if (!string.IsNullOrEmpty(qTab) && (qTab == "pending" || qTab == "approved" || qTab == "all"))
                _tab = qTab;

            if (query["added"] == "1")
                Snackbar.Add("Overtime record created successfully.", Severity.Success);
            if (query["updated"] == "1")
                Snackbar.Add("Overtime record updated successfully.", Severity.Success);
        }
        catch { }

        var org = await Db.Organizations.FirstOrDefaultAsync();
        if (org == null) return;
        _orgId = org.Id;
        await LoadData();
    }

    private async Task LoadData()
    {
        _all = await OvertimeSvc.GetAllAsync(_orgId);
        var now = DateTime.Now;
        _summary = await OvertimeSvc.GetSummaryAsync(_orgId, now.Month, now.Year);
        _totalPay = _all.Where(o => o.Status == OvertimeStatus.Approved || o.Status == OvertimeStatus.AutoApproved).Sum(o => o.Pay);

        var empIds = _all.Select(o => o.EmployeeId).Distinct().ToList();
        if (empIds.Any())
        {
            var employees = await Db.Employees.Where(e => empIds.Contains(e.Id)).ToListAsync();
            _employeeMap = employees.ToDictionary(e => e.Id);
        }
    }

    private string GetFullName(int employeeId)
    {
        if (_employeeMap.TryGetValue(employeeId, out var emp))
            return emp.FullName;
        return "Unknown";
    }

    private string GetEmployeeCode(int employeeId)
    {
        if (_employeeMap.TryGetValue(employeeId, out var emp) && !string.IsNullOrWhiteSpace(emp.EmployeeCode))
            return emp.EmployeeCode;
        return "—";
    }

    private string GetDepartment(int employeeId)
    {
        if (_employeeMap.TryGetValue(employeeId, out var emp) && !string.IsNullOrWhiteSpace(emp.Department))
            return emp.Department;
        return "—";
    }

    private string GetInitials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length < 2 ? (name.Length > 2 ? name[..2].ToUpper() : name.ToUpper()) : $"{parts[0][0]}{parts[^1][0]}".ToUpper();
    }
}
