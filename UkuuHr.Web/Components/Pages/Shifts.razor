@page "/shifts"
@attribute [Authorize(Policy = "HrOrAdmin")]
@page "/scheduling"
@attribute [Authorize(Policy = "HrOrAdmin")]
@using Microsoft.EntityFrameworkCore
@inject ShiftService ShiftSvc
@inject UkuuHrDbContext Db

<style>
/* ═══════════════════════════════════════════════════════════════
   UKUU HR — Shift Management · World-Class Redesign
   Premium design language · Animated stats · Shift cards · Micro-interactions
   ═══════════════════════════════════════════════════════════════ */

@@keyframes sfFadeIn {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
}
@@keyframes sfSlideUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
}
@@keyframes sfCountUp {
    from { opacity: 0; transform: scale(0.8); }
    to   { opacity: 1; transform: scale(1); }
}
@@keyframes sfShimmer {
    0%   { background-position: -200% 0; }
    100% { background-position: 200% 0; }
}
@@keyframes sfPulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(123,47,190,0.2); }
    50%      { box-shadow: 0 0 0 6px rgba(123,47,190,0); }
}

.sf-page { animation: sfFadeIn 0.4s ease-out both; }

/* ─── Stats Row ─── */
.sf-stats {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px;
    margin-bottom: 28px; animation: sfSlideUp 0.5s ease-out 0.1s both;
}
.sf-stat {
    background: var(--bk-bg); border: 1px solid var(--bk-line); border-radius: 16px;
    padding: 20px 24px; display: flex; align-items: center; gap: 16px;
    transition: all 0.25s ease; position: relative; overflow: hidden;
}
.sf-stat::before {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(135deg, rgba(123,47,190,0.03), transparent 60%);
    pointer-events: none;
}
.sf-stat:hover {
    border-color: rgba(123,47,190,0.25); transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(123,47,190,0.08);
}
.sf-stat-icon {
    width: 48px; height: 48px; border-radius: 14px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    font-size: 22px; transition: transform 0.3s ease;
}
.sf-stat:hover .sf-stat-icon { transform: scale(1.08); }
.sf-stat-icon.purple { background: rgba(123,47,190,0.1); color: #7B2FBE; }
.sf-stat-icon.green  { background: rgba(20,163,127,0.1); color: #14a37f; }
.sf-stat-icon.gold   { background: rgba(216,156,17,0.1); color: #d89c11; }
.sf-stat-icon.blue   { background: rgba(37,99,235,0.1); color: #2563EB; }
.sf-stat-value {
    font-size: 28px; font-weight: 800; color: var(--bk-ink);
    letter-spacing: -0.03em; line-height: 1.1; animation: sfCountUp 0.6s ease-out 0.3s both;
}
.sf-stat-label {
    font-size: 12px; font-weight: 600; color: var(--bk-ink-3);
    letter-spacing: 0.04em; text-transform: uppercase; margin-top: 2px;
}

/* ─── Section Header ─── */
.sf-header {
    display: flex; align-items: flex-start; justify-content: space-between;
    margin-bottom: 24px; gap: 20px; flex-wrap: wrap;
    animation: sfSlideUp 0.5s ease-out 0.15s both;
}
.sf-header-eyebrow {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--bk-accent); margin-bottom: 6px;
}
.sf-header-eyebrow::before {
    content: ''; width: 6px; height: 6px; border-radius: 50%;
    background: #7B2FBE; box-shadow: 0 0 0 3px rgba(123,47,190,0.2);
    animation: sfPulse 2s ease-in-out infinite;
}
.sf-header h1 {
    font-size: clamp(24px, 3vw, 32px); font-weight: 800; color: var(--bk-ink);
    letter-spacing: -0.03em; line-height: 1.15; margin: 0 0 4px;
}
.sf-header-sub { font-size: 14px; color: var(--bk-ink-3); line-height: 1.5; }
.sf-header-actions { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }

/* ─── Action Buttons ─── */
.sf-btn {
    display: inline-flex; align-items: center; gap: 7px;
    padding: 10px 20px; border-radius: 12px; font-size: 13px; font-weight: 600;
    text-decoration: none; border: none; cursor: pointer;
    transition: all 0.2s ease; font-family: inherit;
}
.sf-btn-ghost {
    background: transparent; color: var(--bk-ink-2);
    border: 1px solid var(--bk-line);
}
.sf-btn-ghost:hover { background: var(--bk-muted); border-color: var(--bk-line-strong); }
.sf-btn-primary {
    background: linear-gradient(135deg, #7B2FBE, #6A24A8); color: #fff;
    box-shadow: 0 4px 16px rgba(123,47,190,0.25);
}
.sf-btn-primary:hover {
    transform: translateY(-1px); box-shadow: 0 8px 24px rgba(123,47,190,0.35);
    background: linear-gradient(135deg, #8B3FCE, #7A34B8);
}
.sf-btn-danger {
    background: transparent; color: #DC2626; border: 1px solid rgba(220,38,38,0.3);
}
.sf-btn-danger:hover { background: rgba(220,38,38,0.08); border-color: #DC2626; }

/* ─── Quick Nav Cards ─── */
.sf-nav-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px;
    margin-bottom: 28px; animation: sfSlideUp 0.5s ease-out 0.2s both;
}
.sf-nav-card {
    background: var(--bk-bg); border: 1px solid var(--bk-line); border-radius: 18px;
    padding: 24px; display: flex; align-items: flex-start; gap: 16px;
    text-decoration: none; transition: all 0.3s ease; position: relative; overflow: hidden;
}
.sf-nav-card::before {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(135deg, rgba(123,47,190,0.02), transparent 50%);
    pointer-events: none;
}
.sf-nav-card:hover {
    border-color: rgba(123,47,190,0.22); transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(123,47,190,0.08), 0 0 0 1px rgba(123,47,190,0.04);
}
.sf-nav-icon {
    width: 52px; height: 52px; border-radius: 16px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    font-size: 24px; transition: transform 0.3s ease;
}
.sf-nav-card:hover .sf-nav-icon { transform: scale(1.1) rotate(-3deg); }
.sf-nav-icon.blue   { background: rgba(37,99,235,0.1); color: #2563EB; }
.sf-nav-icon.gold   { background: rgba(216,156,17,0.1); color: #d89c11; }
.sf-nav-icon.green  { background: rgba(20,163,127,0.1); color: #14a37f; }
.sf-nav-title {
    font-size: 15px; font-weight: 700; color: var(--bk-ink); margin-bottom: 4px;
}
.sf-nav-desc {
    font-size: 12px; color: var(--bk-ink-3); line-height: 1.45;
}
.sf-nav-badge {
    font-size: 11px; font-weight: 700; padding: 3px 10px; border-radius: 8px;
    display: inline-block; margin-top: 8px;
}
.sf-nav-badge.blue  { background: rgba(37,99,235,0.1); color: #2563EB; }
.sf-nav-badge.gold  { background: rgba(216,156,17,0.1); color: #d89c11; }
.sf-nav-badge.green { background: rgba(20,163,127,0.1); color: #14a37f; }

/* ─── Shift Kind Badges ─── */
.sf-kind {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 11px; font-weight: 700; padding: 5px 12px; border-radius: 100px;
    letter-spacing: 0.04em; text-transform: uppercase; white-space: nowrap;
}
.sf-kind::before {
    content: ''; width: 6px; height: 6px; border-radius: 50%;
}
.sf-kind.fixed     { background: rgba(37,99,235,0.1); color: #2563EB; }
.sf-kind.fixed::before     { background: #2563EB; }
.sf-kind.rotating  { background: rgba(123,47,190,0.1); color: #7B2FBE; }
.sf-kind.rotating::before  { background: #7B2FBE; }
.sf-kind.flexible  { background: rgba(20,163,127,0.1); color: #14a37f; }
.sf-kind.flexible::before  { background: #14a37f; }
.sf-kind.overnight { background: rgba(216,156,17,0.1); color: #d89c11; }
.sf-kind.overnight::before { background: #d89c11; }

/* ─── Shift Kind Gradient Icons ─── */
.sf-kind-icon {
    width: 44px; height: 44px; border-radius: 14px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    font-size: 20px; transition: transform 0.3s ease;
}
.sf-kind-icon.fixed     { background: linear-gradient(135deg, #2563EB, #4F83F0); color: #fff; }
.sf-kind-icon.rotating  { background: linear-gradient(135deg, #7B2FBE, #9B4FD8); color: #fff; }
.sf-kind-icon.flexible  { background: linear-gradient(135deg, #14a37f, #2BC4A1); color: #fff; }
.sf-kind-icon.overnight { background: linear-gradient(135deg, #d89c11, #F0B840); color: #fff; }

/* ─── Shift Cards ─── */
.sf-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
    gap: 20px; animation: sfSlideUp 0.5s ease-out 0.3s both;
}
.sf-card {
    background: var(--bk-bg); border: 1px solid var(--bk-line); border-radius: 18px;
    overflow: hidden; transition: all 0.3s ease; position: relative;
}
.sf-card:hover {
    border-color: rgba(123,47,190,0.22); transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(123,47,190,0.1), 0 0 0 1px rgba(123,47,190,0.06);
}
.sf-card-banner {
    height: 6px; width: 100%;
}
.sf-card-body { padding: 20px 24px; }
.sf-card-top {
    display: flex; align-items: flex-start; justify-content: space-between;
    gap: 12px; margin-bottom: 14px;
}
.sf-card-left { display: flex; align-items: flex-start; gap: 14px; flex: 1; min-width: 0; }
.sf-card-info { flex: 1; min-width: 0; }
.sf-card-name {
    font-size: 16px; font-weight: 700; color: var(--bk-ink);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    margin-bottom: 4px;
}
.sf-card-time {
    font-size: 13px; color: var(--bk-ink-2); display: flex; align-items: center; gap: 6px;
}
.sf-card-time .material-icons-round { font-size: 16px; color: var(--bk-ink-3); }
.sf-card-desc {
    font-size: 13px; color: var(--bk-ink-3); line-height: 1.5; margin: 0 0 14px;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}

/* ─── Days Chips ─── */
.sf-days {
    display: flex; gap: 4px; flex-wrap: wrap; margin-bottom: 14px;
}
.sf-day-chip {
    font-size: 10px; font-weight: 700; padding: 3px 8px; border-radius: 6px;
    background: var(--bk-muted); color: var(--bk-ink-3); letter-spacing: 0.02em;
    text-transform: uppercase;
}
.sf-day-chip.active {
    background: rgba(123,47,190,0.08); color: #7B2FBE;
}

/* ─── Card Meta ─── */
.sf-card-meta {
    display: grid; grid-template-columns: 1fr 1fr; gap: 10px;
    padding-top: 14px; border-top: 1px solid var(--bk-line);
    margin-top: 0;
}
.sf-card-meta-item { display: flex; flex-direction: column; gap: 2px; }
.sf-card-meta-label {
    font-size: 10px; font-weight: 700; letter-spacing: 0.06em;
    text-transform: uppercase; color: var(--bk-ink-3);
}
.sf-card-meta-value { font-size: 13px; font-weight: 600; color: var(--bk-ink); }

/* ─── Card Actions ─── */
.sf-card-actions {
    display: flex; gap: 8px; margin-top: 16px; padding-top: 16px;
    border-top: 1px solid var(--bk-line);
}
.sf-card-action {
    flex: 1; display: flex; align-items: center; justify-content: center; gap: 6px;
    padding: 10px 0; border-radius: 10px; font-size: 12px; font-weight: 600;
    text-decoration: none; transition: all 0.2s ease; cursor: pointer; border: none;
    font-family: inherit;
}
.sf-card-action.edit {
    background: var(--bk-muted); color: var(--bk-ink-2);
    border: 1px solid var(--bk-line);
}
.sf-card-action.edit:hover {
    background: rgba(123,47,190,0.06); border-color: rgba(123,47,190,0.2);
    color: #7B2FBE;
}
.sf-card-action.delete {
    background: transparent; color: #DC2626;
    border: 1px solid rgba(220,38,38,0.2);
}
.sf-card-action.delete:hover {
    background: rgba(220,38,38,0.06); border-color: #DC2626;
}

/* ─── Empty State ─── */
.sf-empty {
    text-align: center; padding: 80px 24px;
    animation: sfSlideUp 0.5s ease-out 0.3s both;
}
.sf-empty-icon {
    width: 80px; height: 80px; border-radius: 24px;
    background: var(--bk-muted); margin: 0 auto 20px;
    display: flex; align-items: center; justify-content: center;
}
.sf-empty-icon .material-icons-round { font-size: 36px; color: var(--bk-ink-3); }
.sf-empty h3 { font-size: 18px; font-weight: 700; color: var(--bk-ink); margin-bottom: 6px; }
.sf-empty p { font-size: 14px; color: var(--bk-ink-3); max-width: 400px; margin: 0 auto 24px; line-height: 1.5; }

/* ─── Loading Skeleton ─── */
.sf-skeleton {
    background: linear-gradient(90deg, var(--bk-muted) 25%, rgba(232,223,245,0.8) 50%, var(--bk-muted) 75%);
    background-size: 200% 100%; animation: sfShimmer 1.5s infinite;
    border-radius: 8px;
}
.sf-skeleton-page {
    animation: sfFadeIn 0.3s ease-out both;
}
.sf-skeleton-stats {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 28px;
}
.sf-skeleton-stat {
    background: var(--bk-bg); border: 1px solid var(--bk-line); border-radius: 16px;
    padding: 20px 24px; display: flex; align-items: center; gap: 16px;
}
.sf-skeleton-stat-icon { width: 48px; height: 48px; border-radius: 14px; }
.sf-skeleton-stat-text { flex: 1; }
.sf-skeleton-stat-val { height: 28px; width: 60%; margin-bottom: 6px; }
.sf-skeleton-stat-lbl { height: 12px; width: 80%; }
.sf-skeleton-header { margin-bottom: 24px; }
.sf-skeleton-h1 { height: 32px; width: 40%; margin-bottom: 8px; }
.sf-skeleton-sub { height: 14px; width: 65%; }
.sf-skeleton-cards {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(400px, 1fr)); gap: 20px;
}
.sf-skeleton-card {
    background: var(--bk-bg); border: 1px solid var(--bk-line); border-radius: 18px;
    padding: 24px;
}
.sf-skeleton-card-banner { height: 6px; width: 100%; border-radius: 3px; margin-bottom: 20px; }
.sf-skeleton-card-line1 { height: 16px; width: 55%; margin-bottom: 8px; }
.sf-skeleton-card-line2 { height: 13px; width: 80%; margin-bottom: 14px; }
.sf-skeleton-card-line3 { height: 13px; width: 45%; margin-bottom: 14px; }
.sf-skeleton-card-meta { height: 13px; width: 90%; margin-bottom: 8px; }
.sf-skeleton-card-actions { height: 36px; width: 100%; }

/* ─── Org Missing State ─── */
.sf-org-missing {
    text-align: center; padding: 80px 24px;
    animation: sfSlideUp 0.5s ease-out 0.2s both;
}
.sf-org-missing-icon {
    width: 80px; height: 80px; border-radius: 24px;
    background: rgba(216,156,17,0.1); margin: 0 auto 20px;
    display: flex; align-items: center; justify-content: center;
}
.sf-org-missing-icon .material-icons-round { font-size: 36px; color: #d89c11; }
.sf-org-missing h3 { font-size: 18px; font-weight: 700; color: var(--bk-ink); margin-bottom: 8px; }
.sf-org-missing p { font-size: 14px; color: var(--bk-ink-3); max-width: 400px; margin: 0 auto 24px; line-height: 1.5; }

/* ─── Responsive ─── */
@@media (max-width: 900px) {
    .sf-stats { grid-template-columns: repeat(2, 1fr); }
    .sf-grid { grid-template-columns: 1fr; }
    .sf-nav-grid { grid-template-columns: 1fr; }
    .sf-header { flex-direction: column; }
    .sf-header-actions { width: 100%; }
    .sf-skeleton-stats { grid-template-columns: repeat(2, 1fr); }
    .sf-skeleton-cards { grid-template-columns: 1fr; }
}
@@media (max-width: 600px) {
    .sf-stats { grid-template-columns: 1fr; gap: 12px; }
    .sf-stat { padding: 16px; }
    .sf-stat-value { font-size: 22px; }
    .sf-grid { grid-template-columns: 1fr; }
    .sf-card-meta { grid-template-columns: 1fr; }
    .sf-nav-grid { grid-template-columns: 1fr; }
    .sf-header-actions { flex-direction: column; }
    .sf-header-actions .sf-btn { width: 100%; justify-content: center; }
    .sf-card-actions { flex-direction: column; }
    .sf-skeleton-stats { grid-template-columns: 1fr; }
    .sf-skeleton-cards { grid-template-columns: 1fr; }
}
</style>

<div class="sf-page">

@if (!_loaded)
{
    @* ─── Shimmer Loading Skeleton ─── *@
    <div class="sf-skeleton-page">
        <div class="sf-skeleton-stats">
            @for (var i = 0; i < 4; i++)
            {
                <div class="sf-skeleton-stat">
                    <div class="sf-skeleton sf-skeleton-stat-icon"></div>
                    <div class="sf-skeleton-stat-text">
                        <div class="sf-skeleton sf-skeleton-stat-val"></div>
                        <div class="sf-skeleton sf-skeleton-stat-lbl"></div>
                    </div>
                </div>
            }
        </div>
        <div class="sf-skeleton-header">
            <div class="sf-skeleton sf-skeleton-h1"></div>
            <div class="sf-skeleton sf-skeleton-sub"></div>
        </div>
        <div class="sf-skeleton-cards">
            @for (var i = 0; i < 3; i++)
            {
                <div class="sf-skeleton-card">
                    <div class="sf-skeleton sf-skeleton-card-banner"></div>
                    <div class="sf-skeleton sf-skeleton-card-line1"></div>
                    <div class="sf-skeleton sf-skeleton-card-line2"></div>
                    <div class="sf-skeleton sf-skeleton-card-line3"></div>
                    <div class="sf-skeleton sf-skeleton-card-meta"></div>
                    <div class="sf-skeleton sf-skeleton-card-meta"></div>
                    <div class="sf-skeleton sf-skeleton-card-actions" style="margin-top:16px;"></div>
                </div>
            }
        </div>
    </div>
}
else if (_orgMissing)
{
    @* ─── Organization Missing State ─── *@
    <div class="sf-org-missing">
        <div class="sf-org-missing-icon">
            <span class="material-icons-round">business</span>
        </div>
        <h3>No Organization Found</h3>
        <p>You need to create an organization before you can manage shifts.</p>
        <form method="post" action="/api/organization/seed" style="display:inline;">
        <AntiforgeryToken />
            <button type="submit" class="sf-btn sf-btn-primary">
                <span class="material-icons-round" style="font-size:16px;">add_business</span>
                Create Default Organization
            </button>
        </form>
    </div>
}
else
{
    @* ─── Stats Row ─── *@
    <div class="sf-stats">
        <div class="sf-stat">
            <div class="sf-stat-icon purple"><span class="material-icons-round">schedule</span></div>
            <div>
                <div class="sf-stat-value">@_shifts.Count</div>
                <div class="sf-stat-label">Total Shifts</div>
            </div>
        </div>
        <div class="sf-stat">
            <div class="sf-stat-icon blue"><span class="material-icons-round">assignment_ind</span></div>
            <div>
                <div class="sf-stat-value">@_assignments.Count</div>
                <div class="sf-stat-label">Active Assignments</div>
            </div>
        </div>
        <div class="sf-stat">
            <div class="sf-stat-icon green"><span class="material-icons-round">category</span></div>
            <div>
                <div class="sf-stat-value">@_shifts.Select(s => s.Kind).Distinct().Count()</div>
                <div class="sf-stat-label">Shift Types Used</div>
            </div>
        </div>
        <div class="sf-stat">
            <div class="sf-stat-icon gold"><span class="material-icons-round">people</span></div>
            <div>
                <div class="sf-stat-value">@_assignments.Select(a => a.EmployeeId).Distinct().Count()</div>
                <div class="sf-stat-label">Employees Scheduled</div>
            </div>
        </div>
    </div>

    @* ─── Section Header ─── *@
    <div class="sf-header">
        <div>
            <div class="sf-header-eyebrow">Scheduling</div>
            <h1>Shift Management</h1>
            <p class="sf-header-sub">
                @_shifts.Count active shifts · @_assignments.Count assignments —
                Define fixed, rotating, flexible, and overnight shifts for your organization.
            </p>
        </div>
        <div class="sf-header-actions">
            <a href="/shifts/add" class="sf-btn sf-btn-primary">
                <span class="material-icons-round" style="font-size:16px;">add</span>
                New Shift
            </a>
        </div>
    </div>

    @* ─── Quick Nav Cards ─── *@
    <div class="sf-nav-grid">
        <a href="/shifts/assignments" class="sf-nav-card">
            <div class="sf-nav-icon blue"><span class="material-icons-round">assignment_ind</span></div>
            <div style="flex:1;">
                <div class="sf-nav-title">Assignments</div>
                <div class="sf-nav-desc">Manage employee shift assignments and scheduling rosters.</div>
                <span class="sf-nav-badge blue">@_assignments.Count assignments</span>
            </div>
        </a>
        <a href="/shifts/tolerance" class="sf-nav-card">
            <div class="sf-nav-icon gold"><span class="material-icons-round">tune</span></div>
            <div style="flex:1;">
                <div class="sf-nav-title">Tolerance Policy</div>
                <div class="sf-nav-desc">Configure late, early departure, and absent thresholds.</div>
                <span class="sf-nav-badge gold">Attendance rules</span>
            </div>
        </a>
        <a href="/shifts/coverage" class="sf-nav-card">
            <div class="sf-nav-icon green"><span class="material-icons-round">calendar_view_week</span></div>
            <div style="flex:1;">
                <div class="sf-nav-title">Weekly Coverage</div>
                <div class="sf-nav-desc">Staffing matrix per shift across each day of the week.</div>
                <span class="sf-nav-badge green">Coverage view</span>
            </div>
        </a>
    </div>

    @* ─── Shift Cards ─── *@
    @if (_shifts.Any())
    {
        <div class="sf-grid">
            @foreach (var s in _shifts)
            {
                var kindClass = s.Kind switch
                {
                    ShiftKind.Fixed => "fixed",
                    ShiftKind.Rotating => "rotating",
                    ShiftKind.Flexible => "flexible",
                    ShiftKind.Overnight => "overnight",
                    _ => "fixed"
                };
                var kindIcon = s.Kind switch
                {
                    ShiftKind.Fixed => "access_time",
                    ShiftKind.Rotating => "sync",
                    ShiftKind.Flexible => "tune",
                    ShiftKind.Overnight => "nights_stay",
                    _ => "access_time"
                };
                var assigned = _assignments.Count(a => a.ShiftId == s.Id);
                <div class="sf-card">
                    <div class="sf-card-banner" style="background:@(s.Color);"></div>
                    <div class="sf-card-body">
                        <div class="sf-card-top">
                            <div class="sf-card-left">
                                <div class="sf-kind-icon @kindClass">
                                    <span class="material-icons-round">@kindIcon</span>
                                </div>
                                <div class="sf-card-info">
                                    <div class="sf-card-name">@s.Name</div>
                                    <div class="sf-card-time">
                                        <span class="material-icons-round">schedule</span>
                                        @s.TimeWindow
                                    </div>
                                </div>
                            </div>
                            <span class="sf-kind @kindClass">@s.KindDisplay</span>
                        </div>

                        <div class="sf-card-desc">@(s.Description ?? "No description provided.")</div>

                        @* Days Chips *@
                        <div class="sf-days">
                            @foreach (var day in new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" })
                            {
                                var isActive = s.DaysDisplay?.Contains(day) == true;
                                <span class="sf-day-chip @(isActive ? "active" : "")">@day</span>
                            }
                        </div>

                        @* Meta Grid *@
                        <div class="sf-card-meta">
                            <div class="sf-card-meta-item">
                                <span class="sf-card-meta-label">Planned Hours</span>
                                <span class="sf-card-meta-value">@s.PlannedHours.ToString("0.0")h</span>
                            </div>
                            <div class="sf-card-meta-item">
                                <span class="sf-card-meta-label">Break</span>
                                <span class="sf-card-meta-value">@s.BreakMinutes min</span>
                            </div>
                            <div class="sf-card-meta-item">
                                <span class="sf-card-meta-label">Assigned</span>
                                <span class="sf-card-meta-value" style="color:#7B2FBE;">@assigned employees</span>
                            </div>
                            @if (s.Kind == ShiftKind.Rotating)
                            {
                                <div class="sf-card-meta-item">
                                    <span class="sf-card-meta-label">Rotation</span>
                                    <span class="sf-card-meta-value">@s.RotationSlots slots × @s.RotationCycleDays days</span>
                                </div>
                            }
                            else if (s.Kind == ShiftKind.Flexible)
                            {
                                <div class="sf-card-meta-item">
                                    <span class="sf-card-meta-label">Flex Range</span>
                                    <span class="sf-card-meta-value">@s.FlexibleMinHours.ToString("0.0")h – @s.FlexibleMaxHours.ToString("0.0")h</span>
                                </div>
                            }
                            else if (s.IsOvernight)
                            {
                                <div class="sf-card-meta-item">
                                    <span class="sf-card-meta-label">Overnight</span>
                                    <span class="sf-card-meta-value" style="color:#d89c11;">Crosses midnight</span>
                                </div>
                            }
                            else
                            {
                                <div class="sf-card-meta-item">
                                    <span class="sf-card-meta-label">Type</span>
                                    <span class="sf-card-meta-value">@s.KindDisplay</span>
                                </div>
                            }
                        </div>

                        @* Actions *@
                        <div class="sf-card-actions">
                            <a href="/shifts/@s.Id/edit" class="sf-card-action edit">
                                <span class="material-icons-round" style="font-size:16px;">edit</span>
                                Edit
                            </a>
                            <form method="post" action="/api/shifts/delete/@s.Id" style="flex:1;" onsubmit="return confirm('Delete shift @s.Name?');">
                            <AntiforgeryToken />
                                <button type="submit" class="sf-card-action delete" style="width:100%;">
                                    <span class="material-icons-round" style="font-size:16px;">delete_outline</span>
                                    Delete
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        @* ─── Empty State ─── *@
        <div class="sf-empty">
            <div class="sf-empty-icon">
                <span class="material-icons-round">schedule</span>
            </div>
            <h3>No shifts defined yet</h3>
            <p>Create your first shift to start assigning employees. Morning, mid, night — or any custom window.</p>
            <a href="/shifts/add" class="sf-btn sf-btn-primary">
                <span class="material-icons-round" style="font-size:18px;">add</span>
                Create First Shift
            </a>
        </div>
    }
}

</div>

@code {
    private List<Shift> _shifts = new();
    private List<EmployeeShiftAssignment> _assignments = new();
    private int _orgId;

    // Loading & org state
    private bool _loaded;
    private bool _orgMissing;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var org = await Db.Organizations.FirstOrDefaultAsync();
            if (org == null)
            {
                _orgMissing = true;
                return;
            }
            _orgId = org.Id;

            _shifts = await Db.Shifts.Where(s => s.OrganizationId == _orgId && s.IsActive).OrderBy(s => s.Name).ToListAsync();
            _assignments = await Db.EmployeeShiftAssignments
                .Include(a => a.Shift)
                .Include(a => a.Employee)
                .Where(a => a.OrganizationId == _orgId && a.IsActive)
                .ToListAsync();
        }
        catch
        {
            _orgMissing = true;
        }
        finally
        {
            _loaded = true;
        }
    }

    private static string ShiftKindClass(ShiftKind kind) => kind switch
    {
        ShiftKind.Fixed => "active",
        ShiftKind.Rotating => "pending",
        ShiftKind.Overnight => "approved",
        ShiftKind.Flexible => "active",
        _ => "active"
    };
}
