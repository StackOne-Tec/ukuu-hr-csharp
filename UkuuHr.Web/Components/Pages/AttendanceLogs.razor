@page "/attendance-logs"
@attribute [Authorize]
@using Microsoft.EntityFrameworkCore
@inject TimeCardService TimeCardSvc
@inject UkuuHrDbContext Db
@inject NavigationManager Nav
@inject ILogger<AttendanceLogs> Logger

<div class="bk-admin-fade-in">
    <div class="bk-admin-section-header">
        <div class="bk-admin-section-header-left">
            <div class="bk-admin-greeting">Attendance Logs · @_tab.ToUpper()</div>
            <h1 class="bk-admin-h1">Attendance Logs</h1>
            <p class="bk-admin-sub">
                Daily, weekly, and monthly attendance with leave, holiday, and overtime interlinking.
                Time cards are generated from the same data with approved overtime included.
            </p>
        </div>
        <div class="bk-admin-actions">
            <button class="bk-btn bk-btn-secondary" onclick="ukuuOpenImportInfoModal()">
                <span class="material-icons-round" style="font-size:16px;">download</span>
                Import From Device
            </button>
            <a href="/attendance-logs/time-cards" class="bk-btn bk-btn-primary" style="text-decoration:none;">
                <span class="material-icons-round" style="font-size:16px;">badge</span>
                View Time Cards
            </a>
        </div>
    </div>

    @if (_loadError != null)
    {
        <div class="bk-admin-card" style="padding:32px;text-align:center;">
            <div style="display:inline-flex;align-items:center;justify-content:center;width:64px;height:64px;border-radius:50%;background:rgba(244,63,94,0.1);color:var(--bk-error);margin-bottom:16px;">
                <span class="material-icons-round" style="font-size:32px;">error_outline</span>
            </div>
            <h3 style="font-size:18px;font-weight:700;margin-bottom:8px;color:var(--bk-ink);">Couldn't load attendance data</h3>
            <p style="font-size:14px;color:var(--bk-ink-3);max-width:480px;margin:0 auto 20px;">@_loadError</p>
            <a href="/attendance-logs" class="bk-btn bk-btn-secondary">
                <span class="material-icons-round" style="font-size:16px;">refresh</span>
                Try again
            </a>
        </div>
    }
    else
    {
        @* ───── Tab navigation ───── *@
        <div style="display:flex;gap:4px;border-bottom:1px solid var(--bk-line);margin-bottom:20px;overflow-x:auto;">
            <a href="/attendance-logs?tab=daily&date=@_dateStr" style="padding:12px 16px;border-bottom:2px solid @(_tab == "daily" ? "var(--bk-ink)" : "transparent");color:@(_tab == "daily" ? "var(--bk-ink)" : "var(--bk-ink-3)");font-weight:600;font-size:13px;white-space:nowrap;text-decoration:none;">
                <span class="material-icons-round" style="font-size:18px;vertical-align:middle;margin-right:6px;">today</span>
                Daily
            </a>
            <a href="/attendance-logs?tab=weekly&date=@_dateStr" style="padding:12px 16px;border-bottom:2px solid @(_tab == "weekly" ? "var(--bk-ink)" : "transparent");color:@(_tab == "weekly" ? "var(--bk-ink)" : "var(--bk-ink-3)");font-weight:600;font-size:13px;white-space:nowrap;text-decoration:none;">
                <span class="material-icons-round" style="font-size:18px;vertical-align:middle;margin-right:6px;">date_range</span>
                Weekly
            </a>
            <a href="/attendance-logs?tab=monthly&date=@_dateStr" style="padding:12px 16px;border-bottom:2px solid @(_tab == "monthly" ? "var(--bk-ink)" : "transparent");color:@(_tab == "monthly" ? "var(--bk-ink)" : "var(--bk-ink-3)");font-weight:600;font-size:13px;white-space:nowrap;text-decoration:none;">
                <span class="material-icons-round" style="font-size:18px;vertical-align:middle;margin-right:6px;">calendar_month</span>
                Monthly
            </a>
            <a href="/attendance-logs?tab=custom&from=@_dateStr&to=@_dateStr" style="padding:12px 16px;border-bottom:2px solid @(_tab == "custom" ? "var(--bk-ink)" : "transparent");color:@(_tab == "custom" ? "var(--bk-ink)" : "var(--bk-ink-3)");font-weight:600;font-size:13px;white-space:nowrap;text-decoration:none;">
                <span class="material-icons-round" style="font-size:18px;vertical-align:middle;margin-right:6px;">tune</span>
                Custom
            </a>
        </div>

        @* ───── Date filter ───── *@
        <div class="bk-admin-card" style="padding:16px 20px;margin-bottom:20px;display:flex;align-items:center;gap:16px;flex-wrap:wrap;">
            <div style="display:flex;align-items:center;gap:8px;">
                <span class="material-icons-round" style="font-size:18px;color:var(--bk-ink-3);">filter_list</span>
                <span style="font-size:13px;font-weight:600;color:var(--bk-ink);">Filter by date:</span>
            </div>
            @if (_tab == "custom")
            {
                <form method="get" action="/attendance-logs" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
                    <input type="hidden" name="tab" value="custom" />
                    <label style="font-size:12px;color:var(--bk-ink-3);font-weight:600;">From:</label>
                    <input type="date" name="from" value="@_fromDateStr" class="bk-input" style="width:auto;height:38px;padding:0 12px;" />
                    <label style="font-size:12px;color:var(--bk-ink-3);font-weight:600;">To:</label>
                    <input type="date" name="to" value="@_toDateStr" class="bk-input" style="width:auto;height:38px;padding:0 12px;" />
                    <button type="submit" class="bk-btn bk-btn-primary" style="font-size:12px;padding:6px 14px;height:38px;">
                        <span class="material-icons-round" style="font-size:14px;">search</span>
                        Apply
                    </button>
                </form>
            }
            else
            {
                <form method="get" action="/attendance-logs" style="display:flex;gap:8px;align-items:center;">
                    <input type="hidden" name="tab" value="@_tab" />
                    <input type="date" name="date" value="@_dateStr" class="bk-input" style="width:auto;height:38px;padding:0 12px;" />
                    <button type="submit" class="bk-btn bk-btn-primary" style="font-size:12px;padding:6px 14px;height:38px;">
                        <span class="material-icons-round" style="font-size:14px;">search</span>
                        Apply
                    </button>
                </form>
                <div style="margin-left:auto;display:flex;gap:6px;">
                    <a href="/attendance-logs?tab=@_tab&date=@_prevDateStr" class="bk-btn bk-btn-secondary" style="font-size:11px;padding:4px 10px;height:32px;text-decoration:none;">
                        <span class="material-icons-round" style="font-size:14px;">chevron_left</span>
                        @(_tab == "daily" ? "Prev Day" : _tab == "weekly" ? "Prev Week" : "Prev Month")
                    </a>
                    <a href="/attendance-logs?tab=@_tab&date=@_nextDateStr" class="bk-btn bk-btn-secondary" style="font-size:11px;padding:4px 10px;height:32px;text-decoration:none;">
                        @(_tab == "daily" ? "Next Day" : _tab == "weekly" ? "Next Week" : "Next Month")
                        <span class="material-icons-round" style="font-size:14px;">chevron_right</span>
                    </a>
                </div>
            }
        </div>

        @* ───── Legend ───── *@
        <div style="display:flex;gap:16px;margin-bottom:16px;flex-wrap:wrap;font-size:11px;color:var(--bk-ink-3);">
            <span><span style="display:inline-block;width:10px;height:10px;border-radius:2px;background:rgba(45,212,167,0.3);margin-right:4px;"></span>P = Present</span>
            <span><span style="display:inline-block;width:10px;height:10px;border-radius:2px;background:rgba(139,128,255,0.3);margin-right:4px;"></span>L = On Leave</span>
            <span><span style="display:inline-block;width:10px;height:10px;border-radius:2px;background:rgba(244,185,66,0.3);margin-right:4px;"></span>H = Holiday</span>
            <span><span style="display:inline-block;width:10px;height:10px;border-radius:2px;background:rgba(255,122,145,0.3);margin-right:4px;"></span>A = Absent</span>
            <span><span style="display:inline-block;width:10px;height:10px;border-radius:2px;background:rgba(255,255,255,0.1);margin-right:4px;"></span>— = Weekend</span>
        </div>

        @* ───── Daily tab ───── *@
        @if (_tab == "daily")
        {
            <div class="bk-admin-card" style="overflow:hidden;">
                <div style="overflow-x:auto;">
                    <table class="bk-admin-table bk-mobile-card-view">
                        <thead>
                            <tr>
                                <th>First Name</th>
                                <th>Last Name</th>
                                <th>Employee ID</th>
                                <th>Clock In</th>
                                <th>Clock Out</th>
                                <th>Worked Hrs</th>
                                <th>Late Hrs</th>
                                <th>Overtime Hrs</th>
                                <th>Status</th>
                                <th>Shift</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _daily)
                            {
                                <tr>
                                    <td style="font-weight:600;font-size:13px;">@row.FirstName</td>
                                    <td style="font-size:13px;">@row.LastName</td>
                                    <td style="font-size:12px;color:var(--bk-ink-3);font-family:'JetBrains Mono',monospace;">@row.EmployeeCode</td>
                                    <td style="font-size:12px;font-family:'JetBrains Mono',monospace;">@row.CheckInLabel</td>
                                    <td style="font-size:12px;font-family:'JetBrains Mono',monospace;">@row.CheckOutLabel</td>
                                    <td style="font-weight:700;color:var(--bk-accent);font-size:13px;">@row.WorkedHoursLabel</td>
                                    <td style="font-size:12px;color:@(row.LateHours > 0 ? "var(--bk-accent-4)" : "var(--bk-ink-3)");">@row.LateHoursLabel</td>
                                    <td style="font-size:12px;color:@(row.OvertimeHours > 0 ? "var(--bk-accent-3)" : "var(--bk-ink-3)");font-weight:@(row.OvertimeHours > 0 ? "700" : "400")">@row.OvertimeHoursLabel</td>
                                    <td>
                                        <span class="bk-admin-pill @(
                                            row.Status == "LEAVE" ? "pending" :
                                            row.Status == "HOLIDAY" ? "active" :
                                            row.Status == "ABSENT" ? "rejected" : "approved"
                                        )" style="@(
                                            row.Status == "LEAVE" ? "background:rgba(139,128,255,0.12);color:var(--bk-accent-2);" :
                                            row.Status == "HOLIDAY" ? "background:rgba(244,185,66,0.12);color:var(--bk-accent);" :
                                            row.Status == "ABSENT" ? "background:rgba(255,122,145,0.12);color:var(--bk-accent-4);" :
                                            "background:rgba(45,212,167,0.12);color:var(--bk-accent-3);"
                                        )">
                                            @row.Status
                                        </span>
                                    </td>
                                    <td style="font-size:11px;color:var(--bk-ink-3);">@row.ShiftName</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (!_daily.Any())
                {
                    <div style="padding:48px 24px;text-align:center;color:var(--bk-ink-3);">
                        <span class="material-icons-round" style="font-size:32px;">event_busy</span>
                        <p style="font-size:13px;margin-top:8px;">No attendance data for this date.</p>
                    </div>
                }
            </div>
        }

        @* ───── Weekly tab ───── *@
        @if (_tab == "weekly")
        {
            <div class="bk-admin-card" style="overflow:hidden;">
                <div style="overflow-x:auto;">
                    <table class="bk-admin-table bk-mobile-card-view">
                        <thead>
                            <tr>
                                <th>First Name</th>
                                <th>Last Name</th>
                                <th>Employee ID</th>
                                <th>Department</th>
                                <th>Mon</th>
                                <th>Tue</th>
                                <th>Wed</th>
                                <th>Thu</th>
                                <th>Fri</th>
                                <th>Sat</th>
                                <th>Sun</th>
                                <th>Late Hrs</th>
                                <th>Total Worked</th>
                                <th>OT Workday</th>
                                <th>OT Weekend</th>
                                <th>OT Holiday</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _weekly)
                            {
                                <tr>
                                    <td style="font-weight:600;font-size:13px;">@row.FirstName</td>
                                    <td style="font-size:13px;">@row.LastName</td>
                                    <td style="font-size:12px;color:var(--bk-ink-3);font-family:'JetBrains Mono',monospace;">@row.EmployeeCode</td>
                                    <td style="font-size:12px;color:var(--bk-ink-3);">@row.Department</td>
                                    @for (int i = 0; i < 7; i++)
                                    {
                                        var status = row.DailyStatus[i];
                                        var bg = status == "L" ? "rgba(139,128,255,0.08)" :
                                                 status == "H" ? "rgba(244,185,66,0.08)" :
                                                 status == "A" ? "rgba(255,122,145,0.08)" :
                                                 status == "P" ? "rgba(45,212,167,0.08)" : "transparent";
                                        <td style="font-size:11px;text-align:center;font-family:'JetBrains Mono',monospace;background:@bg;">
                                            @row.DayLabel(i)
                                        </td>
                                    }
                                    <td style="font-size:12px;color:@(row.LateHours > 0 ? "var(--bk-accent-4)" : "var(--bk-ink-3)");">@row.LateLabel</td>
                                    <td style="font-weight:700;color:var(--bk-accent);font-size:13px;">@row.TotalWorkedLabel</td>
                                    <td style="font-size:12px;color:@(row.OvertimeWorkday > 0 ? "var(--bk-accent-2)" : "var(--bk-ink-3)");">@row.OtWorkdayLabel</td>
                                    <td style="font-size:12px;color:@(row.OvertimeWeekend > 0 ? "var(--bk-accent)" : "var(--bk-ink-3)");">@row.OtWeekendLabel</td>
                                    <td style="font-size:12px;color:@(row.OvertimeHoliday > 0 ? "var(--bk-accent-4)" : "var(--bk-ink-3)");">@row.OtHolidayLabel</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (!_weekly.Any())
                {
                    <div style="padding:48px 24px;text-align:center;color:var(--bk-ink-3);">
                        <span class="material-icons-round" style="font-size:32px;">date_range</span>
                        <p style="font-size:13px;margin-top:8px;">No attendance data for this week.</p>
                    </div>
                }
            </div>
        }

        @* ───── Monthly tab ───── *@
        @if (_tab == "monthly")
        {
            <div class="bk-admin-card" style="overflow:hidden;">
                <div style="overflow-x:auto;">
                    <table class="bk-admin-table" style="font-size:11px;">
                        <thead>
                            <tr>
                                <th style="position:sticky;left:0;background:var(--bk-muted);z-index:1;">First Name</th>
                                <th style="position:sticky;left:80px;background:var(--bk-muted);z-index:1;">Last Name</th>
                                <th style="position:sticky;left:160px;background:var(--bk-muted);z-index:1;">Employee ID</th>
                                @for (int d = 1; d <= _daysInMonth; d++)
                                {
                                    <th style="text-align:center;min-width:36px;">@d.ToString("00")</th>
                                }
                                <th>Total</th>
                                <th>OT W</th>
                                <th>OT WE</th>
                                <th>OT H</th>
                                <th>Late</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _monthly)
                            {
                                <tr>
                                    <td style="position:sticky;left:0;background:var(--bk-bg-strong);z-index:1;font-weight:600;">@row.FirstName</td>
                                    <td style="position:sticky;left:80px;background:var(--bk-bg-strong);z-index:1;">@row.LastName</td>
                                    <td style="position:sticky;left:160px;background:var(--bk-bg-strong);z-index:1;font-family:'JetBrains Mono',monospace;font-size:10px;">@row.EmployeeCode</td>
                                    @for (int i = 0; i < _daysInMonth; i++)
                                    {
                                        var status = row.DailyStatus[i];
                                        var bg = status == "L" ? "rgba(139,128,255,0.1)" :
                                                 status == "H" ? "rgba(244,185,66,0.1)" :
                                                 status == "A" ? "rgba(255,122,145,0.1)" :
                                                 status == "P" ? "rgba(45,212,167,0.1)" : "transparent";
                                        <td style="text-align:center;font-family:'JetBrains Mono',monospace;background:@bg;">
                                            @(row.DailyHours[i] > 0 ? row.DailyHours[i]!.Value.ToString("F1") : status)
                                        </td>
                                    }
                                    <td style="font-weight:700;color:var(--bk-accent);">@row.TotalWorkedLabel</td>
                                    <td style="color:var(--bk-accent-2);">@row.OtWorkdayLabel</td>
                                    <td style="color:var(--bk-accent);">@row.OtWeekendLabel</td>
                                    <td style="color:var(--bk-accent-4);">@row.OtHolidayLabel</td>
                                    <td style="color:@(row.LateHours > 0 ? "var(--bk-accent-4)" : "var(--bk-ink-3)");">@row.LateLabel</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (!_monthly.Any())
                {
                    <div style="padding:48px 24px;text-align:center;color:var(--bk-ink-3);">
                        <span class="material-icons-round" style="font-size:32px;">calendar_month</span>
                        <p style="font-size:13px;margin-top:8px;">No attendance data for this month.</p>
                    </div>
                }
            </div>
        }

        @* ───── Custom tab ───── *@
        @if (_tab == "custom")
        {
            <div class="bk-admin-card" style="overflow:hidden;">
                <div style="padding:16px 20px;border-bottom:1px solid var(--bk-line);display:flex;justify-content:space-between;align-items:center;">
                    <div>
                        <h3 style="font-size:14px;font-weight:700;margin:0;">Custom Range — @_fromDate.ToString("dd MMM yyyy") to @_toDate.ToString("dd MMM yyyy")</h3>
                        <p style="font-size:12px;color:var(--bk-ink-3);margin:2px 0 0;">@_customRows.Count employees · @((_toDate - _fromDate).Days + 1) days</p>
                    </div>
                </div>
                <div style="overflow-x:auto;">
                    <table class="bk-admin-table bk-mobile-card-view">
                        <thead>
                            <tr>
                                <th>First Name</th>
                                <th>Last Name</th>
                                <th>Employee ID</th>
                                <th>Department</th>
                                <th>Total Worked Hrs</th>
                                <th>Late Hrs</th>
                                <th>OT Workday</th>
                                <th>OT Weekend</th>
                                <th>OT Holiday</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _customRows)
                            {
                                <tr>
                                    <td style="font-weight:600;font-size:13px;">@row.FirstName</td>
                                    <td style="font-size:13px;">@row.LastName</td>
                                    <td style="font-size:12px;color:var(--bk-ink-3);font-family:'JetBrains Mono',monospace;">@row.EmployeeCode</td>
                                    <td style="font-size:12px;color:var(--bk-ink-3);">@row.Department</td>
                                    <td style="font-weight:700;color:var(--bk-accent);font-size:13px;">@row.TotalWorkedLabel</td>
                                    <td style="font-size:12px;color:@(row.LateHours > 0 ? "var(--bk-accent-4)" : "var(--bk-ink-3)");">@row.LateLabel</td>
                                    <td style="font-size:12px;color:@(row.OvertimeWorkday > 0 ? "var(--bk-accent-2)" : "var(--bk-ink-3)");">@row.OtWorkdayLabel</td>
                                    <td style="font-size:12px;color:@(row.OvertimeWeekend > 0 ? "var(--bk-accent)" : "var(--bk-ink-3)");">@row.OtWeekendLabel</td>
                                    <td style="font-size:12px;color:@(row.OvertimeHoliday > 0 ? "var(--bk-accent-4)" : "var(--bk-ink-3)");">@row.OtHolidayLabel</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (!_customRows.Any())
                {
                    <div style="padding:48px 24px;text-align:center;color:var(--bk-ink-3);">
                        <span class="material-icons-round" style="font-size:32px;">date_range</span>
                        <p style="font-size:13px;margin-top:8px;">No attendance data for this date range.</p>
                    </div>
                }
            </div>
        }
    }

    <!-- Import From Device — Stage 1: Info popup (plain HTML/JS) -->
    <div id="ukuu-import-info-modal" style="position:fixed;inset:0;background:rgba(16,8,30,0.55);backdrop-filter:blur(4px);z-index:9998;display:none;align-items:center;justify-content:center;padding:24px;" onclick="ukuuCloseImportInfoModal()">
        <div style="background:var(--bk-surface,#fff);border-radius:16px;max-width:560px;width:100%;max-height:90vh;overflow-y:auto;box-shadow:0 24px 60px rgba(0,0,0,0.3);" onclick="event.stopPropagation()">
            <div style="padding:24px 28px;border-bottom:1px solid var(--bk-line);display:flex;justify-content:space-between;align-items:flex-start;gap:16px;">
                <div>
                    <h3 style="margin:0 0 4px 0;font-size:18px;font-weight:700;color:var(--bk-ink);">Import Attendance From Hikvision Device</h3>
                    <p style="margin:0;font-size:13px;color:var(--bk-ink-3);">Before you begin — please review the requirements below.</p>
                </div>
                <button onclick="ukuuCloseImportInfoModal()" style="background:none;border:none;cursor:pointer;color:var(--bk-ink-3);padding:4px;border-radius:6px;">
                    <span class="material-icons-round">close</span>
                </button>
            </div>
            <div style="padding:24px 28px;">
                <div style="background:rgba(37,99,235,0.06);border:1px solid rgba(37,99,235,0.2);border-radius:10px;padding:16px;margin-bottom:16px;">
                    <div style="display:flex;align-items:flex-start;gap:10px;">
                        <span class="material-icons-round" style="color:var(--bk-info);font-size:20px;margin-top:1px;">face</span>
                        <div style="font-size:13px;color:var(--bk-ink);line-height:1.5;">
                            <strong>ISAPI Face Recognition Service:</strong> When you connect, the system will automatically probe the device's Face Recognition capabilities via <code style="background:var(--bk-muted);padding:1px 5px;border-radius:3px;font-size:12px;">/ISAPI/Intelligent/FaceRecognition/1/capabilities</code> and report whether face recognition is active, how many face templates are supported, and how many face databases are configured.
                        </div>
                    </div>
                </div>
                <div style="background:rgba(212,175,55,0.08);border:1px solid rgba(212,175,55,0.3);border-radius:10px;padding:16px;margin-bottom:16px;">
                    <div style="display:flex;align-items:flex-start;gap:10px;">
                        <span class="material-icons-round" style="color:#d89c11;font-size:20px;margin-top:1px;">info</span>
                        <div style="font-size:13px;color:var(--bk-ink);line-height:1.5;">
                            <strong>How it works:</strong> This tool connects to your Hikvision biometric terminal via the ISAPI protocol, probes the Face Recognition service, downloads attendance events (clock-in/out punches with face-authenticated verify mode) for the date range you specify, and imports them into Ukuu HR.
                        </div>
                    </div>
                </div>
                <h4 style="font-size:13px;font-weight:700;color:var(--bk-ink);margin:0 0 10px 0;text-transform:uppercase;letter-spacing:0.04em;">Requirements</h4>
                <ul style="margin:0 0 16px 0;padding-left:20px;font-size:13px;color:var(--bk-ink-2);line-height:1.7;">
                    <li><strong style="color:var(--bk-ink);">Same network:</strong> Your computer and the Hikvision device must be on the same LAN/VPN.</li>
                    <li><strong style="color:var(--bk-ink);">Device IP & port:</strong> Default ports: <code style="background:var(--bk-muted);padding:1px 5px;border-radius:3px;font-size:12px;">80</code> (HTTP) or <code style="background:var(--bk-muted);padding:1px 5px;border-radius:3px;font-size:12px;">443</code> (HTTPS).</li>
                    <li><strong style="color:var(--bk-ink);">Valid credentials:</strong> Admin username and password for the device.</li>
                    <li><strong style="color:var(--bk-ink);">ISAPI enabled:</strong> Enable in device web UI under Configuration → Network → Advanced → Platform Access → ISAPI.</li>
                    <li><strong style="color:var(--bk-ink);">Face Recognition enabled:</strong> Enable in device web UI under Configuration → Intelligent → Face Recognition for face-authenticated attendance.</li>
                    <li><strong style="color:var(--bk-ink);">Employee codes match:</strong> Ukuu HR Employee Codes must match device employeeNo values.</li>
                </ul>
                <div style="display:flex;gap:10px;justify-content:flex-end;">
                    <button class="bk-btn bk-btn-secondary" onclick="ukuuCloseImportInfoModal()">Cancel</button>
                    <button class="bk-btn bk-btn-primary" onclick="ukuuProceedToImportForm()">
                        <span class="material-icons-round" style="font-size:16px;">arrow_forward</span>
                        Continue
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Import From Device — Stage 2: Credentials form (plain HTML/JS) -->
    <div id="ukuu-import-form-modal" style="position:fixed;inset:0;background:rgba(16,8,30,0.55);backdrop-filter:blur(4px);z-index:9998;display:none;align-items:center;justify-content:center;padding:24px;" onclick="ukuuCloseImportFormModal()">
        <div style="background:var(--bk-surface,#fff);border-radius:16px;max-width:540px;width:100%;max-height:90vh;overflow-y:auto;box-shadow:0 24px 60px rgba(0,0,0,0.3);" onclick="event.stopPropagation()">
            <div style="padding:24px 28px;border-bottom:1px solid var(--bk-line);display:flex;justify-content:space-between;align-items:flex-start;gap:16px;">
                <div>
                    <h3 style="margin:0 0 4px 0;font-size:18px;font-weight:700;color:var(--bk-ink);">Connect to Hikvision Device</h3>
                    <p style="margin:0;font-size:13px;color:var(--bk-ink-3);">Enter credentials to connect, probe Face Recognition, and import attendance.</p>
                </div>
                <button onclick="ukuuCloseImportFormModal()" style="background:none;border:none;cursor:pointer;color:var(--bk-ink-3);padding:4px;border-radius:6px;">
                    <span class="material-icons-round">close</span>
                </button>
            </div>
            <div style="padding:24px 28px;">
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;">
                    <div>
                        <label style="display:block;font-size:12px;font-weight:600;color:var(--bk-ink-2);margin-bottom:6px;">IP Address or Hostname *</label>
                        <input type="text" id="ukuu-import-ip" value="192.168.1.137" placeholder="192.168.1.137" style="width:100%;height:40px;border:1px solid var(--bk-line);border-radius:8px;padding:0 12px;font-family:inherit;font-size:13px;color:var(--bk-ink);outline:none;box-sizing:border-box;" />
                    </div>
                    <div>
                        <label style="display:block;font-size:12px;font-weight:600;color:var(--bk-ink-2);margin-bottom:6px;">Port</label>
                        <input type="number" id="ukuu-import-port" value="443" placeholder="443" style="width:100%;height:40px;border:1px solid var(--bk-line);border-radius:8px;padding:0 12px;font-family:inherit;font-size:13px;color:var(--bk-ink);outline:none;box-sizing:border-box;" />
                    </div>
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;">
                    <div>
                        <label style="display:block;font-size:12px;font-weight:600;color:var(--bk-ink-2);margin-bottom:6px;">Username *</label>
                        <input type="text" id="ukuu-import-user" value="admin" placeholder="admin" style="width:100%;height:40px;border:1px solid var(--bk-line);border-radius:8px;padding:0 12px;font-family:inherit;font-size:13px;color:var(--bk-ink);outline:none;box-sizing:border-box;" />
                    </div>
                    <div>
                        <label style="display:block;font-size:12px;font-weight:600;color:var(--bk-ink-2);margin-bottom:6px;">Password *</label>
                        <input type="password" id="ukuu-import-pass" placeholder="••••••••" style="width:100%;height:40px;border:1px solid var(--bk-line);border-radius:8px;padding:0 12px;font-family:inherit;font-size:13px;color:var(--bk-ink);outline:none;box-sizing:border-box;" />
                    </div>
                </div>
                <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px;padding:10px 12px;background:var(--bk-muted);border-radius:8px;">
                    <input id="ukuu-import-https" type="checkbox" checked style="width:16px;height:16px;cursor:pointer;" />
                    <label for="ukuu-import-https" style="font-size:13px;color:var(--bk-ink-2);cursor:pointer;user-select:none;">Use HTTPS (recommended)</label>
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;">
                    <div>
                        <label style="display:block;font-size:12px;font-weight:600;color:var(--bk-ink-2);margin-bottom:6px;">From Date</label>
                        <input type="date" id="ukuu-import-from" style="width:100%;height:40px;border:1px solid var(--bk-line);border-radius:8px;padding:0 12px;font-family:inherit;font-size:13px;color:var(--bk-ink);outline:none;box-sizing:border-box;" />
                    </div>
                    <div>
                        <label style="display:block;font-size:12px;font-weight:600;color:var(--bk-ink-2);margin-bottom:6px;">To Date</label>
                        <input type="date" id="ukuu-import-to" style="width:100%;height:40px;border:1px solid var(--bk-line);border-radius:8px;padding:0 12px;font-family:inherit;font-size:13px;color:var(--bk-ink);outline:none;box-sizing:border-box;" />
                    </div>
                </div>
                <div style="margin-bottom:20px;">
                    <label style="display:block;font-size:12px;font-weight:600;color:var(--bk-ink-2);margin-bottom:6px;">Max Records (1–5000, default 1000)</label>
                    <input type="number" id="ukuu-import-max" value="1000" min="1" max="5000" style="width:100%;height:40px;border:1px solid var(--bk-line);border-radius:8px;padding:0 12px;font-family:inherit;font-size:13px;color:var(--bk-ink);outline:none;box-sizing:border-box;" />
                </div>
                <div id="ukuu-import-status" style="display:none;margin-bottom:16px;"></div>
                <div style="display:flex;gap:10px;justify-content:flex-end;">
                    <button class="bk-btn bk-btn-secondary" onclick="ukuuCloseImportFormModal()">Close</button>
                    <button class="bk-btn bk-btn-primary" id="ukuu-import-submit" onclick="ukuuExecuteImport()">
                        <span class="material-icons-round" style="font-size:16px;">download_for_offline</span>
                        <span>Fetch &amp; Import</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <script>
        (function() {
            var today = new Date();
            var weekAgo = new Date(today.getTime() - 7 * 24 * 60 * 60 * 1000);
            var fmt = function(d) { return d.toISOString().split('T')[0]; };
            var fromEl = document.getElementById('ukuu-import-from');
            var toEl = document.getElementById('ukuu-import-to');
            if (fromEl) fromEl.value = fmt(weekAgo);
            if (toEl) toEl.value = fmt(today);
        })();
        function ukuuOpenImportInfoModal() { var m = document.getElementById('ukuu-import-info-modal'); if (m) m.style.display = 'flex'; }
        function ukuuCloseImportInfoModal() { var m = document.getElementById('ukuu-import-info-modal'); if (m) m.style.display = 'none'; }
        function ukuuProceedToImportForm() { ukuuCloseImportInfoModal(); var m = document.getElementById('ukuu-import-form-modal'); if (m) m.style.display = 'flex'; }
        function ukuuCloseImportFormModal() { var m = document.getElementById('ukuu-import-form-modal'); if (m) m.style.display = 'none'; }
        async function ukuuExecuteImport() {
            var ip = document.getElementById('ukuu-import-ip').value.trim();
            var port = parseInt(document.getElementById('ukuu-import-port').value) || 443;
            var useHttps = document.getElementById('ukuu-import-https').checked;
            var user = document.getElementById('ukuu-import-user').value.trim();
            var pass = document.getElementById('ukuu-import-pass').value;
            var from = document.getElementById('ukuu-import-from').value;
            var to = document.getElementById('ukuu-import-to').value;
            var max = parseInt(document.getElementById('ukuu-import-max').value) || 1000;
            if (!ip) { ukuuShowStatus('error', 'Please enter the device IP address.'); return; }
            if (!user) { ukuuShowStatus('error', 'Please enter the username.'); return; }
            if (!pass) { ukuuShowStatus('error', 'Please enter the password.'); return; }
            if (port < 1 || port > 65535) { ukuuShowStatus('error', 'Port must be 1–65535.'); return; }
            var btn = document.getElementById('ukuu-import-submit');
            btn.disabled = true;
            btn.innerHTML = '<span class="material-icons-round" style="font-size:16px;animation:ukuu-spin 0.8s linear infinite;">sync</span><span>Importing…</span>';
            ukuuShowStatus('loading', 'Connecting to ' + (useHttps ? 'https' : 'http') + '://' + ip + ':' + port + ' — probing ISAPI Face Recognition service…');
            try {
                var payload = {
                    ipAddress: ip, port: port, useHttps: useHttps,
                    username: user, password: pass,
                    from: from ? from + 'T00:00:00Z' : null,
                    to: to ? to + 'T23:59:59Z' : null,
                    maxResults: max
                };
                var resp = await fetch('/api/attendance/import-from-device', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                var data = await resp.json();
                if (resp.ok && data.success) {
                    // Build the face recognition status section
                    var frHtml = '';
                    if (data.faceRecognition) {
                        var fr = data.faceRecognition;
                        if (fr.serviceAvailable) {
                            frHtml = '<div style="display:flex;align-items:center;gap:8px;padding:10px 12px;background:rgba(20,163,127,0.08);border:1px solid rgba(20,163,127,0.3);border-radius:8px;margin-bottom:10px;">' +
                                '<span class="material-icons-round" style="color:var(--bk-success);font-size:18px;">face</span>' +
                                '<span style="font-size:13px;color:var(--bk-ink);font-weight:600;">ISAPI Face Recognition: Active</span>' +
                                '<span style="font-size:11px;color:var(--bk-ink-3);margin-left:auto;">' +
                                (fr.faceDatabaseCount > 0 ? fr.faceDatabaseCount + ' face DB' : '') +
                                (fr.maxFaceTemplates > 0 ? ' · max ' + fr.maxFaceTemplates + ' templates' : '') +
                                '</span></div>';
                        } else {
                            frHtml = '<div style="display:flex;align-items:center;gap:8px;padding:10px 12px;background:rgba(212,175,55,0.08);border:1px solid rgba(212,175,55,0.3);border-radius:8px;margin-bottom:10px;">' +
                                '<span class="material-icons-round" style="color:#d89c11;font-size:18px;">face</span>' +
                                '<span style="font-size:13px;color:var(--bk-ink);font-weight:600;">ISAPI Face Recognition: Not Available</span>' +
                                '<span style="font-size:11px;color:var(--bk-ink-3);margin-left:auto;">' + (fr.note || fr.error || 'Endpoint not found') + '</span></div>';
                        }
                    }
                    var html = '<div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;">' +
                        '<span class="material-icons-round" style="color:var(--bk-success);font-size:20px;">check_circle</span>' +
                        '<strong style="font-size:14px;color:var(--bk-ink);">Import Complete</strong></div>' +
                        frHtml +
                        '<div style="font-size:13px;color:var(--bk-ink-2);line-height:1.7;">' +
                        '<div><strong>Device:</strong> ' + (data.device.name || '?') + ' (' + (data.device.model || '?') + ')</div>' +
                        '<div><strong>Events fetched:</strong> ' + data.eventsFetched + '</div>' +
                        '<div><strong>Employees matched:</strong> ' + data.employeesMatched + '</div>' +
                        (data.employeesUnmatched > 0 ? '<div><strong>Unmatched:</strong> ' + data.employeesUnmatched + '</div>' : '') +
                        '<div><strong>Records imported/updated:</strong> ' + data.recordsImported + '</div>' +
                        (data.duplicatesSkipped > 0 ? '<div><strong>Duplicates skipped:</strong> ' + data.duplicatesSkipped + '</div>' : '') +
                        '</div>';
                    ukuuShowStatus('success', html);
                    setTimeout(function() { window.location.reload(); }, 4000);
                } else {
                    ukuuShowStatus('error', data.error || ('HTTP ' + resp.status));
                }
            } catch (e) {
                ukuuShowStatus('error', 'Network error: ' + e.message);
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<span class="material-icons-round" style="font-size:16px;">download_for_offline</span><span>Fetch &amp; Import</span>';
            }
        }
        function ukuuShowStatus(type, html) {
            var el = document.getElementById('ukuu-import-status');
            if (!el) return;
            el.style.display = 'block';
            if (type === 'loading') {
                el.style.background = 'rgba(37,99,235,0.06)'; el.style.border = '1px solid rgba(37,99,235,0.2)';
                el.innerHTML = '<div style="display:flex;align-items:center;gap:12px;padding:14px;"><div style="width:20px;height:20px;border:2px solid rgba(37,99,235,0.2);border-top-color:var(--bk-info);border-radius:50%;animation:ukuu-spin 0.8s linear infinite;"></div><div style="font-size:13px;color:var(--bk-ink);font-weight:600;">' + html + '</div></div>';
            } else if (type === 'error') {
                el.style.background = 'rgba(244,63,94,0.08)'; el.style.border = '1px solid rgba(244,63,94,0.3)';
                el.innerHTML = '<div style="display:flex;align-items:flex-start;gap:10px;padding:14px;"><span class="material-icons-round" style="color:var(--bk-error);font-size:20px;margin-top:1px;">error_outline</span><div style="font-size:13px;color:var(--bk-ink);line-height:1.5;flex:1;">' + html + '</div></div>';
            } else {
                el.style.background = 'rgba(20,163,127,0.08)'; el.style.border = '1px solid rgba(20,163,127,0.3)';
                el.innerHTML = '<div style="padding:16px;">' + html + '</div>';
            }
        }
    </script>
    <style>@@keyframes ukuu-spin { to { transform: rotate(360deg); } }</style>

</div>

@code {
    private string _tab = "daily";
    private DateTime _date = DateTime.Today;
    private string _dateStr = DateTime.Today.ToString("yyyy-MM-dd");
    private string _prevDateStr = "";
    private string _nextDateStr = "";
    private DateTime _fromDate = DateTime.Today.AddDays(-7);
    private DateTime _toDate = DateTime.Today;
    private string _fromDateStr = DateTime.Today.AddDays(-7).ToString("yyyy-MM-dd");
    private string _toDateStr = DateTime.Today.ToString("yyyy-MM-dd");
    private int _daysInMonth;
    private string? _loadError;

    private List<DailyAttendanceRow> _daily = new();
    private List<WeeklyAttendanceRow> _weekly = new();
    private List<MonthlyAttendanceRow> _monthly = new();
    private List<WeeklyAttendanceRow> _customRows = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Parse query string
            var uri = Nav.ToAbsoluteUri(Nav.Uri);
            var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
            var qTab = query["tab"];
            var qDate = query["date"];
            var qFrom = query["from"];
            var qTo = query["to"];
            if (!string.IsNullOrEmpty(qTab) && (qTab == "daily" || qTab == "weekly" || qTab == "monthly" || qTab == "custom"))
                _tab = qTab;
            if (DateTime.TryParse(qDate, out var parsedDate))
                _date = parsedDate;
            if (DateTime.TryParse(qFrom, out var parsedFrom))
                _fromDate = parsedFrom;
            if (DateTime.TryParse(qTo, out var parsedTo))
                _toDate = parsedTo;
            _dateStr = _date.ToString("yyyy-MM-dd");
            _fromDateStr = _fromDate.ToString("yyyy-MM-dd");
            _toDateStr = _toDate.ToString("yyyy-MM-dd");

            // Compute prev/next dates
            _prevDateStr = (_tab switch { "weekly" => _date.AddDays(-7), "monthly" => _date.AddMonths(-1), _ => _date.AddDays(-1) }).ToString("yyyy-MM-dd");
            _nextDateStr = (_tab switch { "weekly" => _date.AddDays(7), "monthly" => _date.AddMonths(1), _ => _date.AddDays(1) }).ToString("yyyy-MM-dd");

            _daysInMonth = DateTime.DaysInMonth(_date.Year, _date.Month);

            await LoadData();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load attendance logs");
            _loadError = "We couldn't load the attendance data. Please try refreshing the page.";
        }
    }

    private async Task LoadData()
    {
        try
        {
            var org = await Db.Organizations.FirstOrDefaultAsync();
            if (org == null)
            {
                _loadError = "No organization found.";
                return;
            }

            _loadError = null;

            if (_tab == "daily")
                _daily = await TimeCardSvc.GetDailyAsync(org.Id, _date);
            else if (_tab == "weekly")
                _weekly = await TimeCardSvc.GetWeeklyAsync(org.Id, _date);
            else if (_tab == "monthly")
                _monthly = await TimeCardSvc.GetMonthlyAsync(org.Id, _date);
            else if (_tab == "custom")
                _customRows = await TimeCardSvc.GetCustomRangeAsync(org.Id, _fromDate, _toDate);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load attendance logs");
            _loadError = "We couldn't load the attendance data. Please try refreshing the page.";
        }
    }

    // NOTE: Import From Device uses plain HTML/JS (see <script> block above) —
    // no Blazor state or handlers needed. The JS calls POST /api/attendance/
    // import-from-device directly via fetch().
}
