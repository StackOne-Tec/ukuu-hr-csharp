<script>
// ─────────────────────────────────────────────────────────────────────────────
// Client-side filter for attendance tables — searches by employee name,
// filters by department and status dropdowns. Works on the Daily table
// (which is the most common view). For Weekly/Monthly, filters by employee
// name in the first column.
// ─────────────────────────────────────────────────────────────────────────────
function filterAttendanceTable() {
    const search = (document.getElementById('attEmployeeSearch')?.value || '').toLowerCase().trim();
    const dept = document.getElementById('attDeptFilter')?.value || '';
    const status = document.getElementById('attStatusFilter')?.value || '';
    const rows = document.querySelectorAll('.att-table tbody tr');
    let visible = 0;
    rows.forEach(function(row) {
        let show = true;
        // Search by name (first two cells = first name + last name)
        if (search) {
            const name = (row.cells[0]?.textContent + ' ' + row.cells[1]?.textContent).toLowerCase();
            if (name.indexOf(search) < 0) show = false;
        }
        // Filter by status (the status cell has a .att-status span)
        if (show && status) {
            const statusCell = row.querySelector('.att-status');
            const statusText = statusCell ? statusCell.textContent.trim().toUpperCase() : '';
            if (statusText !== status) show = false;
        }
        // Department filter: the daily table doesn't have a department column visible,
        // but if the row has a data-dept attribute, filter on it.
        // For now, department filter works on rows that have a data-dept attribute.
        if (show && dept) {
            const rowDept = row.getAttribute('data-dept') || '';
            if (rowDept !== dept) show = false;
        }
        row.classList.toggle('att-hidden', !show);
        if (show) visible++;
    });
    // Update the count
    const countEl = document.getElementById('attVisibleCount');
    if (countEl) countEl.textContent = visible;
    // Show/hide "no results" message
    const tableWrap = document.querySelector('.att-table-wrap');
    let noResults = document.getElementById('attNoResults');
    if (visible === 0) {
        if (!noResults) {
            noResults = document.createElement('div');
            noResults.id = 'attNoResults';
            noResults.className = 'att-no-results';
            noResults.innerHTML = '<span class="material-icons-round">search_off</span>No matching records. Try adjusting your filters.';
            if (tableWrap) tableWrap.parentNode.insertBefore(noResults, tableWrap.nextSibling);
        }
        noResults.style.display = 'block';
        if (tableWrap) tableWrap.style.display = 'none';
    } else {
        if (noResults) noResults.style.display = 'none';
        if (tableWrap) tableWrap.style.display = '';
    }
}
function clearAttendanceFilters() {
    const search = document.getElementById('attEmployeeSearch');
    const dept = document.getElementById('attDeptFilter');
    const status = document.getElementById('attStatusFilter');
    if (search) search.value = '';
    if (dept) dept.value = '';
    if (status) status.value = '';
    filterAttendanceTable();
}
</script>

<script>
function ukuuOpenImportModal() { var m = document.getElementById('ukuu-import-modal'); if (m) m.style.display = 'flex'; }
function ukuuCloseImportModal() { var m = document.getElementById('ukuu-import-modal'); if (m) m.style.display = 'none'; }

async function ukuuDoImport() {
    var raw = document.getElementById('ukuu-imp-data').value.trim();
    if (!raw) { ukuuImpStatus('error','Please paste attendance data first.'); return; }
    var events = [];
    var lines = raw.split('\n');
    for (var i = 0; i < lines.length; i++) {
        var line = lines[i].trim();
        if (!line || line.startsWith('#')) continue;
        var cols = line.split(',');
        if (cols.length < 2) continue;
        var empNo = cols[0].trim();
        var time = cols[1].trim();
        if (empNo.toLowerCase() === 'employeeno' || empNo.toLowerCase() === 'employee') continue;
        var eventType = 'check_in';
        if (cols.length >= 3) {
            var et = cols[2].trim().toLowerCase();
            if (et.indexOf('out') >= 0 || et.indexOf('exit') >= 0 || et === '76') eventType = 'check_out';
        }
        events.push({ employeeNo: empNo, time: time, eventType: eventType, major: 1, minor: eventType === 'check_out' ? 76 : 75 });
    }
    if (events.length === 0) { ukuuImpStatus('error','No valid rows found. Expected: EmployeeNo,Time,EventType'); return; }
    var btn = document.getElementById('ukuu-imp-btn');
    btn.disabled = true;
    btn.innerHTML = '<span class="material-icons-round" style="font-size:18px;animation:ukuu-imp-spin 0.8s linear infinite;">sync</span> Importing ' + events.length + ' records...';
    ukuuImpStatus('loading','Saving ' + events.length + ' attendance records...');
    try {
        var resp = await fetch('/api/attendance/save-imported', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ events: events, deviceInfo: { name: 'Manual Import', model: '', serial: '' }, faceRecognition: null })
        });
        var data = await resp.json();
        if (resp.ok && data.success) {
            ukuuImpStatus('success',
                '<div style="font-size:13px;color:var(--bk-ink-2);line-height:1.8;">' +
                '<div><strong>Events processed:</strong> ' + data.eventsFetched + '</div>' +
                '<div><strong>Employees matched:</strong> ' + data.employeesMatched + '</div>' +
                (data.employeesUnmatched > 0 ? '<div><strong>Unmatched:</strong> ' + data.employeesUnmatched + '</div>' : '') +
                '<div><strong>Records imported:</strong> ' + data.recordsImported + '</div></div>');
            setTimeout(function() { window.location.reload(); }, 3000);
        } else { ukuuImpStatus('error', data.error || ('HTTP ' + resp.status)); }
    } catch (e) { ukuuImpStatus('error', 'Import failed: ' + e.message); }
    finally { btn.disabled = false; btn.innerHTML = '<span class="material-icons-round" style="font-size:18px;">download</span> Import Records'; }
}

function ukuuImpStatus(type, html) {
    var el = document.getElementById('ukuu-imp-status'); if (!el) return;
    el.style.display = 'block'; el.style.borderRadius = '12px'; el.style.padding = '12px';
    if (type === 'loading') {
        el.style.background = 'rgba(37,99,235,0.06)'; el.style.border = '1px solid rgba(37,99,235,0.15)';
        el.innerHTML = '<div style="display:flex;align-items:center;gap:10px;"><div style="width:18px;height:18px;border:2px solid rgba(37,99,235,0.2);border-top-color:#2563EB;border-radius:50%;animation:ukuu-imp-spin 0.8s linear infinite;"></div><span style="font-size:13px;color:var(--bk-ink);font-weight:600;">' + html + '</span></div>';
    } else if (type === 'error') {
        el.style.background = 'rgba(244,63,94,0.06)'; el.style.border = '1px solid rgba(244,63,94,0.2)';
        el.innerHTML = '<div style="display:flex;align-items:flex-start;gap:8px;"><span class="material-icons-round" style="color:#f43f5e;font-size:18px;">error_outline</span><span style="font-size:13px;color:var(--bk-ink);line-height:1.5;">' + html + '</span></div>';
    } else {
        el.style.background = 'rgba(20,163,127,0.06)'; el.style.border = '1px solid rgba(20,163,127,0.2)';
        el.innerHTML = '<div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;"><span class="material-icons-round" style="color:#14a37f;font-size:18px;">check_circle</span><strong style="font-size:14px;color:var(--bk-ink);">Import Complete</strong></div>' + html;
    }
}
</script>
<style>@@keyframes ukuu-imp-spin { to { transform: rotate(360deg); } }</style>

@code {
    private string _tab = "daily";
    private DateTime _date = DateTime.Today;
    private string _dateStr = DateTime.Today.ToString("yyyy-MM-dd");
    private string _prevDateStr = "";
    private string _nextDateStr = "";
    private DateTime _fromDate = DateTime.Today.AddDays(-7);
    private DateTime _toDate = DateTime.Today;
    private string _fromDateStr = DateTime.Today.AddDays(-7).ToString("yyyy-MM-dd");
    private string _toDateStr = DateTime.Today.ToString("yyyy-MM-dd");
    private int _daysInMonth;
    private string? _loadError;

    private List<DailyAttendanceRow> _daily = new();
    private List<WeeklyAttendanceRow> _weekly = new();
    private List<MonthlyAttendanceRow> _monthly = new();
    private List<WeeklyAttendanceRow> _customRows = new();
    private List<string> _departments = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var uri = Nav.ToAbsoluteUri(Nav.Uri);
            var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
            var qTab = query["tab"];
            var qDate = query["date"];
            var qFrom = query["from"];
            var qTo = query["to"];
            if (!string.IsNullOrEmpty(qTab) && (qTab == "daily" || qTab == "weekly" || qTab == "monthly" || qTab == "custom"))
                _tab = qTab;
            if (DateTime.TryParse(qDate, out var parsedDate))
                _date = parsedDate;
            if (DateTime.TryParse(qFrom, out var parsedFrom))
                _fromDate = parsedFrom;
            if (DateTime.TryParse(qTo, out var parsedTo))
                _toDate = parsedTo;
            _dateStr = _date.ToString("yyyy-MM-dd");
            _fromDateStr = _fromDate.ToString("yyyy-MM-dd");
            _toDateStr = _toDate.ToString("yyyy-MM-dd");

            _prevDateStr = (_tab switch { "weekly" => _date.AddDays(-7), "monthly" => _date.AddMonths(-1), _ => _date.AddDays(-1) }).ToString("yyyy-MM-dd");
            _nextDateStr = (_tab switch { "weekly" => _date.AddDays(7), "monthly" => _date.AddMonths(1), _ => _date.AddDays(1) }).ToString("yyyy-MM-dd");

            _daysInMonth = DateTime.DaysInMonth(_date.Year, _date.Month);

            await LoadData();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load attendance logs");
            _loadError = "We couldn't load the attendance data. Please try refreshing the page.";
        }
    }

    private async Task LoadData()
    {
        try
        {
            var org = await Db.ResolveOrgAsync(); /* multi-tenant org resolution */
            if (org == null) { _loadError = "No organization found."; return; }
            _loadError = null;
            if (_tab == "daily") _daily = await TimeCardSvc.GetDailyAsync(org.Id, _date);
            else if (_tab == "weekly") _weekly = await TimeCardSvc.GetWeeklyAsync(org.Id, _date);
            else if (_tab == "monthly") _monthly = await TimeCardSvc.GetMonthlyAsync(org.Id, _date);
            else if (_tab == "custom") _customRows = await TimeCardSvc.GetCustomRangeAsync(org.Id, _fromDate, _toDate);

            // Populate the department filter dropdown
            _departments = await Db.Employees
                .Where(e => e.OrganizationId == org.Id && e.Department != null && e.Department != "")
                .Select(e => e.Department!)
                .Distinct()
                .OrderBy(d => d)
                .ToListAsync();

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load attendance logs");
            _loadError = "We couldn't load the attendance data. Please try refreshing the page.";
        }
    }
}
