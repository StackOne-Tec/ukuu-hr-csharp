# ─────────────────────────────────────────────────────────────────────────────
# Ukuu HR — Environment Variables Reference
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` (local dev) or set these in your Docker/Railway/
# Render host environment. The .env file is gitignored — never commit real
# credentials.
#
# Quick start with Docker:
#   cp .env.example .env        # edit .env with your values
#   docker compose up            # starts the app at http://localhost:8080
#
# SECURITY NOTE: The application will refuse to start in Production if
# UKUU_ENCRYPTION_KEY is not set. Generate one with: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──
ASPNETCORE_ENVIRONMENT=Production
DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false
PORT=8080

# ── Production: PostgreSQL (managed or self-hosted) ──
# Get this from your PostgreSQL provider.
# Format: Host=db.example.com;Port=5432;Database=ukuuhr;Username=user;Password=pass;SSL Mode=Require;Timeout=30;CommandTimeout=60
# Note: Do NOT include TrustServerCertificate=true — use a proper CA-verified cert.
POSTGRES_CONNECTION_STRING=

# ── Alternative: any external PostgreSQL via DATABASE_URL ──
# Render/Railway-style postgres:// URL. Auto-converted to Npgsql format by Program.cs.
# Lower priority than POSTGRES_CONNECTION_STRING if both set.
# DATABASE_URL=postgresql://user:pass@host:port/dbname

# ── Local dev fallback: SQLite (used only when both above are unset) ──
# Defaults to "ukuuhr.db" in the project root. Override if you want a custom path.
# ConnectionString__SqlitePath=ukuuhr.db

# ── Demo data seeding ──
# Set to "true" to seed demo data on first run (8 fictional employees,
# 7 demo devices, sample attendance/payroll/leave/holidays).
# Set to "false" in production — only the schema is created.
SEED_DEMO_DATA=false

# ── Admin password (REQUIRED for first-run) ──
# Sets the password for the default admin account (admin@ukuuhr.demo).
# If not set when seeding, a random password is generated and logged once.
# MUST be set in production — there is no hardcoded fallback.
# Generate with: openssl rand -base64 24
UKUU_ADMIN_PASSWORD=

# ── Resend email API key ──
# Used for transactional emails (payslip delivery, leave approvals, etc.)
# Get your key at https://resend.com/api-keys
# IMPORTANT: Never commit this value to version control.
RESEND_API_KEY=

# ── API key for external integration (HR, Payroll, ERP, mobile) ──
# When set, /api/* endpoints require an X-API-Key header matching this value.
# When unset in Production, API endpoints require cookie auth.
# When unset in Development, API endpoints are open (for convenience).
# Generate with: openssl rand -hex 32
UKUU_API_KEY=

# ── Encryption master key for sensitive data at rest ──
# 32-byte key as a 64-char hex string. Used to encrypt bank account numbers,
# NRCs, TPINs, and other sensitive fields via AES-256-CBC with random IV.
# REQUIRED in Production — the app will refuse to start without it.
# Generate with: openssl rand -hex 32
UKUU_ENCRYPTION_KEY=
